Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Planning Grid1
      Splitter Ratio: 0.55
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: Local occupancy grid
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.55
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.45
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz/Group
      Displays:
        - Alpha: 0.55
          Class: rviz/Map
          Color Scheme: map
          Draw Behind: true
          Enabled: true
          Name: Local occupancy grid
          Topic: /mosim/local_occupancy_grid
          Unreliable: false
          Use Timestamp: false
          Value: true
        - Alpha: 0.35
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 85; 170; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Local known map cloud
          Position Transformer: XYZ
          Queue Size: 4
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.25
          Style: Boxes
          Topic: /mosim/local_known_map_cloud
          Unreliable: false
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 25; 255; 0
          Enabled: true
          Head Diameter: 0.25
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.06
          Name: Local plan
          Pose Color: 255; 85; 255
          Pose Style: Axes
          Topic: /mosim/local_plan
          Unreliable: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 25; 160; 255
          Enabled: true
          Head Diameter: 0.2
          Head Length: 0.15
          Length: 0.25
          Line Style: Lines
          Line Width: 0.03
          Name: UAV trajectory
          Pose Color: 25; 160; 255
          Pose Style: None
          Topic: /mosim/uav_path
          Unreliable: false
          Value: true
      Enabled: true
      Name: Planning Grid
  Enabled: true
  Global Options:
    Background Color: 38; 38; 38
    Default Light: true
    Fixed Frame: ue_world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 60
      Target Frame: ue_world
      Value: TopDownOrtho (rviz)
Window Geometry:
  Height: 900
  Width: 1100
  X: 20
  Y: 80
