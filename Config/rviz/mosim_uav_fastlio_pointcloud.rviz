Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Point Cloud And FAST-LIO1
      Splitter Ratio: 0.55
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: LiDAR points
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.7
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Max Intensity: 4096
          Min Intensity: 0
          Name: LiDAR points
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.05
          Style: Points
          Topic: /velodyne_points
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 0.22
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 138; 226; 52
          Color Transformer: FlatColor
          Decay Time: 1000
          Enabled: true
          Name: FAST-LIO registered map
          Position Transformer: XYZ
          Queue Size: 1000
          Selectable: true
          Size (Pixels): 1
          Size (m): 0.02
          Style: Points
          Topic: /cloud_registered
          Unreliable: false
          Use Fixed Frame: true
          Value: true
        - Angle Tolerance: 0.1
          Class: rviz/Odometry
          Enabled: true
          Keep: 80
          Name: FAST-LIO odometry
          Position Tolerance: 0.1
          Shape:
            Alpha: 1
            Axes Length: 0.8
            Axes Radius: 0.08
            Color: 255; 85; 0
            Value: Axes
          Topic: /Odometry
          Unreliable: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 220; 25
          Enabled: true
          Head Diameter: 0.2
          Head Length: 0.15
          Length: 0.25
          Line Style: Lines
          Line Width: 0.04
          Name: FAST-LIO path
          Pose Color: 255; 220; 25
          Pose Style: None
          Topic: /path
          Unreliable: false
          Value: true
      Enabled: true
      Name: Point Cloud And FAST-LIO
  Enabled: true
  Global Options:
    Background Color: 30; 30; 34
    Default Light: true
    Fixed Frame: ue_world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 35
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.55
      Target Frame: ue_world
      Value: Orbit (rviz)
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1200
  X: 1160
  Y: 80
