Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: map
    - Class: rviz/Path
      Color: 255; 0; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Name: Truth Path
      Topic: /mosim/px4ctrl/truth_path
    - Class: rviz/Path
      Color: 0; 180; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Reference Path
      Topic: /mosim/px4ctrl/reference_path
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8
      Focal Point:
        X: 1
        Y: 1
        Z: 0.8
      Name: Current View
      Pitch: 0.785
      Target Frame: map
      Yaw: 0.785
Window Geometry:
  Height: 900
  Width: 1200
  X: 20
  Y: 40
