Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: World Grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: <Fixed Frame>
    - Alpha: 0.90
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 4
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: UAV1 MID360 Accumulated World Map
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 1
      Size (m): 0.02
      Style: Points
      Topic: /mosim/swarm_formation/uav1/livox_world_accumulated
      Use Fixed Frame: true
      Use rainbow: true
    - Alpha: 0.90
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 4
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: UAV2 MID360 Accumulated World Map
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 1
      Size (m): 0.02
      Style: Points
      Topic: /mosim/swarm_formation/uav2/livox_world_accumulated
      Use Fixed Frame: true
      Use rainbow: true
    - Alpha: 0.90
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 4
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: UAV3 MID360 Accumulated World Map
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 1
      Size (m): 0.02
      Style: Points
      Topic: /mosim/swarm_formation/uav3/livox_world_accumulated
      Use Fixed Frame: true
      Use rainbow: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /mosim/swarm_formation/body_axes
      Name: UAV Body Axes
      Queue Size: 5
  Enabled: true
  Global Options:
    Background Color: 38; 38; 38
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 24
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Name: Current View
      Pitch: 0.75
      Target Frame: world
      Yaw: 0.785
Window Geometry:
  Height: 900
  Width: 1200
  X: 20
  Y: 40
