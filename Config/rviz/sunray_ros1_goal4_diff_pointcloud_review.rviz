Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: false
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: World Grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.95
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Name: FAST-LIO Full Accumulated Map Diagnostic
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.08
      Style: Points
      Topic: /Laser_map
      Use Fixed Frame: true
      Use rainbow: true
      Value: false
    - Alpha: 0.95
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: Goal4 Planner Input Accumulated Cloud
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.08
      Style: Points
      Topic: /mosim/goal4/livox_world_accumulated
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.65
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 0.6
      Enabled: true
      Name: Goal4 Planner Input Live Cloud
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.08
      Style: Points
      Topic: /uav1/livox_world
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.70
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 1
      Enabled: false
      Name: FAST-LIO Registered Cloud Diagnostic Disabled
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.08
      Style: Points
      Topic: /cloud_registered
      Use Fixed Frame: true
      Use rainbow: true
      Value: false
    - Class: rviz/Path
      Alpha: 1
      Buffer Length: 1
      Color: 255; 50; 50
      Enabled: true
      Head Diameter: 0.18
      Head Length: 0.12
      Length: 0.2
      Line Style: Lines
      Line Width: 0.055
      Name: UAV Truth Trajectory
      Pose Color: 255; 50; 50
      Pose Style: None
      Topic: /mosim/goal4/truth_path
      Value: true
    - Class: rviz/Path
      Alpha: 1
      Buffer Length: 1
      Color: 30; 220; 80
      Enabled: true
      Head Diameter: 0.18
      Head Length: 0.12
      Length: 0.2
      Line Style: Lines
      Line Width: 0.04
      Name: Diff Position Command Path
      Pose Color: 30; 220; 80
      Pose Style: None
      Topic: /mosim/goal4/position_cmd_path
      Value: true
    - Class: rviz/Path
      Alpha: 1
      Buffer Length: 1
      Color: 255; 220; 0
      Enabled: false
      Head Diameter: 0.18
      Head Length: 0.12
      Length: 0.2
      Line Style: Lines
      Line Width: 0.035
      Name: Mission Target Segment
      Pose Color: 255; 220; 0
      Pose Style: None
      Topic: /mosim/goal4/target_path
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /mosim/goal4/body_axes
      Name: UAV Body Axes
      Queue Size: 5
      Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 38; 38
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 18
      Focal Point:
        X: -72.40496
        Y: 1.63709
        Z: 2
      Name: Current View
      Pitch: 0.62
      Target Frame: world
      Value: Orbit (rviz)
      Yaw: 0.78
Window Geometry:
  Height: 880
  Width: 1120
  X: 20
  Y: 40
