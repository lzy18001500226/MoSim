<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="sunray150_assembled_motor_test">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>

    <link name="base_link">
      <inertial>
        <mass>0.67</mass>
        <inertia>
          <ixx>0.0085</ixx>
          <iyy>0.0085</iyy>
          <izz>0.012</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <pose>0 0 -0.012 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.15 0.06</size>
          </box>
        </geometry>
      </collision>
      <visual name="assembled_textured_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://sunray150_assembled/meshes/sunray150_dae_mid360_realistic_material_audit_gazebo_body_static.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <gravity>1</gravity>
      <velocity_decay />
      <self_collide>0</self_collide>
      <!-- The accepted assembly mesh is split so visible propellers live on rotor
           links and can rotate with the motor joints in Gazebo. -->

      <!-- Sensors are disabled in this diagnostic copy so the probe isolates
           MulticopterMotorModel physics from GPU lidar/render load. -->
