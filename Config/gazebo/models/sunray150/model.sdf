<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="sunray150">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>0.65</mass>
        <inertia>
          <ixx>0.0040</ixx>
          <iyy>0.0040</iyy>
          <izz>0.0070</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.22 0.16 0.08</size>
          </box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.22 0.16 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <sensor name="forward_imu" type="imu">
        <topic>/mosim/gazebo/imu</topic>
        <update_rate>200</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>

      <sensor name="mid360_lidar" type="gpu_lidar">
        <pose>0.035 0 0.045 0 0 0</pose>
        <topic>/mosim/gazebo/lidar_points</topic>
        <update_rate>20</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.65</min_angle>
              <max_angle>0.65</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <link name="rotor_0">
      <pose>0.12 0.12 0.02 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <iyy>4.17041e-05</iyy>
          <izz>4.26041e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="rotor_0_collision">
        <geometry>
          <cylinder>
            <radius>0.065</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.13</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.24 0.24 0.24 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="rotor_1">
