{
  "schema": "mosim.ros1_local_source_manifest.v1",
  "project_source_root": "src",
  "workspace_root": "build/ros1/local_source_ws",
  "policy": {
    "source_input_rule": "Generated ROS1 workspaces may link only project src paths. References, Results, and old WSL workspaces are not source inputs.",
    "workspace_rule": "Build, devel, install, and logs belong under build/ros1/local_source_ws and are disposable generated output.",
    "runtime_rule": "A successful package build is not a flight, planner, or controller acceptance claim."
  },
  "profiles": {
    "foundation": {
      "purpose": "Compile Sunray messages, Gazebo simulator package, Livox compatibility messages, and Livox Gazebo plugin without arming or launch.",
      "links": [
        {
          "workspace_path": "General_Module/sunray_common",
          "source_path": "src/common/utilities/ros1/sunray_common"
        },
        {
          "workspace_path": "perception/livox_ros_driver_compat",
          "source_path": "src/perception/livox_ros_driver_compat"
        },
        {
          "workspace_path": "simulation/gazebo_plugin/livox_laser_simulation",
          "source_path": "src/simulation/gazebo/plugins/sunray/livox_laser_simulation"
        },
        {
          "workspace_path": "simulation/sunray_simulator",
          "source_path": "src/simulation/gazebo/sunray"
        }
      ],
      "build_packages": [
        "sunray_msgs",
        "livox_ros_driver",
        "livox_laser_simulation",
        "sunray_simulator"
      ]
    },
    "flight_adapter": {
      "extends": "foundation",
      "purpose": "Add the Sunray MAVROS adapter after the foundation profile compiles.",
      "links": [
        {
          "workspace_path": "General_Module/sunray_uav_control",
          "source_path": "src/flight_stack/mavros/sunray_uav_control"
        }
      ],
      "build_packages": [
        "sunray_uav_control"
      ]
    },
    "perception": {
      "extends": "foundation",
      "purpose": "Add FAST-LIO only after the Livox message and simulator packages compile.",
      "links": [
        {
          "workspace_path": "perception/fast_lio",
          "source_path": "src/perception/fast_lio"
        }
      ],
      "build_packages": [
        "fast_lio"
      ]
    },
    "controller": {
      "extends": "foundation",
      "purpose": "Build px4ctrl from project-local sources. The default preserves the legacy backend; --px4ctrl-backend graphical_px4ctrl_c99 selects the MWORKS graphical C99 outer-loop export.",
      "links": [
        {
          "workspace_path": "Utils/cmake_utils",
          "source_path": "src/common/utilities/ros1/cmake_utils"
        },
        {
          "workspace_path": "Utils/uav_utils",
          "source_path": "src/common/utilities/ros1/uav_utils"
        },
        {
          "workspace_path": "Utils/quadrotor_msgs",
          "source_path": "src/integration/ros1_launch/quadrotor_msgs"
        },
        {
          "workspace_path": "control/px4ctrl",
          "source_path": "src/control/runtime_adapters/px4ctrl"
        }
      ],
      "build_packages": [
        "px4ctrl"
      ]
    },
    "mission_adapter": {
      "purpose": "Build the Sunray tutorial and position-command planner adapter from project-local sources without launching a simulation.",
      "links": [
        {
          "workspace_path": "General_Module/sunray_common",
          "source_path": "src/common/utilities/ros1/sunray_common"
        },
        {
          "workspace_path": "General_Module/sunray_planner_utils",
          "source_path": "src/integration/ros1_launch/sunray_planner_utils"
        },
        {
          "workspace_path": "General_Module/sunray_tutorial",
          "source_path": "src/planning/mission_adapters/sunray_tutorial"
        }
      ],
      "build_packages": [
        "sunray_msgs",
        "sunray_planner_utils",
        "sunray_tutorial"
      ]
    },
    "fuel": {
      "purpose": "Build the FUEL planner from its project-local source tree in an isolated workspace.",
      "links": [
        {
          "workspace_path": "planning/fuel",
          "source_path": "src/planning/fuel"
        }
      ],
      "build_packages": [
        "exploration_manager",
        "lkh_tsp_solver"
      ]
    },
    "falcon": {
      "purpose": "Build the FALCON planner with the project-local FUEL plan_env compatibility package in an isolated workspace.",
      "links": [
        {
          "workspace_path": "planning/falcon",
          "source_path": "src/planning/falcon"
        },
        {
          "workspace_path": "compat/plan_env",
          "source_path": "src/planning/fuel/fuel_planner/plan_env"
        }
      ],
      "build_packages": [
        "exploration_manager"
      ]
    },
    "racer": {
      "purpose": "Build the RACER planner from its project-local source tree in an isolated workspace.",
      "links": [
        {
          "workspace_path": "planning/racer",
          "source_path": "src/planning/racer"
        }
      ],
      "build_packages": [
        "exploration_manager"
      ]
    },
    "diff_planner": {
      "purpose": "Build Diff-Planner from its project-local source tree in an isolated workspace.",
      "links": [
        {
          "workspace_path": "planning/diff_planner",
          "source_path": "src/planning/diff_planner/src"
        }
      ],
      "build_packages": [
        "diff_planner"
      ]
    },
    "ego_planner_swarm": {
      "purpose": "Build EGO-Planner Swarm with project-local ROS utility and message dependencies.",
      "links": [
        {
          "workspace_path": "planning/ego_planner_swarm",
          "source_path": "src/planning/ego_planner_swarm/src"
        },
        {
          "workspace_path": "Utils/cmake_utils",
          "source_path": "src/common/utilities/ros1/cmake_utils"
        },
        {
          "workspace_path": "Utils/uav_utils",
          "source_path": "src/common/utilities/ros1/uav_utils"
        },
        {
          "workspace_path": "Utils/quadrotor_msgs",
          "source_path": "src/integration/ros1_launch/quadrotor_msgs"
        }
      ],
      "build_packages": [
        "ego_planner"
      ]
    },
    "fixed_formation": {
      "purpose": "Build the fixed-formation planner from project-local sources in an isolated workspace.",
      "links": [
        {
          "workspace_path": "planning/fixed_formation",
          "source_path": "src/planning/fixed_formation/src"
        },
        {
          "workspace_path": "Utils/cmake_utils",
          "source_path": "src/common/utilities/ros1/cmake_utils"
        },
        {
          "workspace_path": "Utils/uav_utils",
          "source_path": "src/common/utilities/ros1/uav_utils"
        },
        {
          "workspace_path": "Utils/quadrotor_msgs",
          "source_path": "src/integration/ros1_launch/quadrotor_msgs"
        }
      ],
      "build_packages": [
        "ego_planner",
        "swarm_bridge"
      ]
    }
  },
  "components": [
    {
      "id": "sunray_common",
      "source_path": "src/common/utilities/ros1/sunray_common",
      "role": "Sunray common headers and sunray_msgs",
      "activation_stage": "foundation"
    },
    {
      "id": "sunray_simulator",
      "source_path": "src/simulation/gazebo/sunray",
      "role": "Sunray Gazebo Classic ROS1 package",
      "activation_stage": "foundation"
    },
    {
      "id": "livox_ros_driver_compat",
      "source_path": "src/perception/livox_ros_driver_compat",
      "role": "ROS1 Livox message compatibility package",
      "activation_stage": "foundation"
    },
    {
      "id": "livox_laser_simulation",
      "source_path": "src/simulation/gazebo/plugins/sunray/livox_laser_simulation",
      "role": "Gazebo Classic Livox plugin with the required Mid-360 scan schedule",
      "activation_stage": "foundation"
    },
    {
      "id": "sunray_uav_control",
      "source_path": "src/flight_stack/mavros/sunray_uav_control",
      "role": "Sunray MAVROS adapter",
      "activation_stage": "flight_adapter"
    },
    {
      "id": "fast_lio",
      "source_path": "src/perception/fast_lio",
      "role": "FAST-LIO localization package",
      "activation_stage": "perception"
    },
    {
      "id": "cmake_utils",
      "source_path": "src/common/utilities/ros1/cmake_utils",
      "role": "Fast-Drone catkin CMake utility dependency for uav_utils",
      "activation_stage": "controller"
    },
    {
      "id": "uav_utils",
      "source_path": "src/common/utilities/ros1/uav_utils",
      "role": "px4ctrl utility package",
      "activation_stage": "controller"
    },
    {
      "id": "quadrotor_msgs",
      "source_path": "src/integration/ros1_launch/quadrotor_msgs",
      "role": "px4ctrl message package",
      "activation_stage": "controller"
    },
    {
      "id": "px4ctrl",
      "source_path": "src/control/runtime_adapters/px4ctrl",
      "role": "ROS1 position controller runtime adapter",
      "activation_stage": "controller",
      "generated_backend": "graphical_px4ctrl_c99",
      "generated_source_path": "src/control/codegen/px4ctrl",
      "generated_core_path": "src/control/runtime_adapters/px4ctrl/generated/golden_slice",
      "legacy_compatibility_source_path": "src/control/runtime_adapters/px4ctrl/generated/legacy_px4ctrl",
      "generated_source_policy": "CMake accepts the project-local graphical C99 export or the package-local legacy fallback only. Other controller-family artifacts remain intentionally unmigrated and fail explicitly when selected."
    },
    {
      "id": "px4_autopilot",
      "source_path": "src/flight_stack/px4/PX4-Autopilot",
      "role": "PX4 v1.14.0 Gazebo Classic SITL source snapshot with initialized submodules",
      "activation_stage": "px4_sitl",
      "build_entrypoint": "Scripts/sunray/build_local_px4_sitl.sh",
      "default_build_directory": "build/px4/px4_sitl_default",
      "default_build_target": "px4"
    },
    {
      "id": "sunray_planner_utils",
      "source_path": "src/integration/ros1_launch/sunray_planner_utils",
      "role": "Sunray planner-to-position-command adapter",
      "activation_stage": "mission_adapter"
    },
    {
      "id": "sunray_tutorial",
      "source_path": "src/planning/mission_adapters/sunray_tutorial",
      "role": "Sunray tutorial and demonstration mission adapter",
      "activation_stage": "mission_adapter"
    },
    {
      "id": "fuel",
      "source_path": "src/planning/fuel",
      "role": "FUEL exploration planner",
      "activation_stage": "fuel"
    },
    {
      "id": "falcon",
      "source_path": "src/planning/falcon",
      "role": "FALCON exploration planner",
      "activation_stage": "falcon"
    },
    {
      "id": "racer",
      "source_path": "src/planning/racer",
      "role": "RACER multi-UAV exploration planner",
      "activation_stage": "racer"
    },
    {
      "id": "diff_planner",
      "source_path": "src/planning/diff_planner",
      "role": "Diff-Planner trajectory planner",
      "activation_stage": "diff_planner"
    },
    {
      "id": "ego_planner_swarm",
      "source_path": "src/planning/ego_planner_swarm",
      "role": "EGO-Planner Swarm trajectory planner",
      "activation_stage": "ego_planner_swarm"
    },
    {
      "id": "fixed_formation",
      "source_path": "src/planning/fixed_formation",
      "role": "Fixed-formation multi-UAV planning stack",
      "activation_stage": "fixed_formation"
    }
  ],
  "external_dependencies": [
    {
      "id": "ros_noetic",
      "kind": "Ubuntu 20.04 system dependency",
      "required_for": ["all ROS1 profiles"]
    },
    {
      "id": "gazebo_classic",
      "kind": "Ubuntu 20.04 system dependency",
      "required_for": ["foundation", "px4_sitl"]
    },
    {
      "id": "mavros",
      "kind": "Ubuntu 20.04 ROS package",
      "required_for": ["flight_adapter", "controller"]
    }
  ],
  "deferred_source_groups": []
}
