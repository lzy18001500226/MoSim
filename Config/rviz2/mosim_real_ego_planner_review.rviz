Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.6
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: -1
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 0; 210; 255
          Color Transformer: Intensity
          Decay Time: 1
          Enabled: true
          Invert Rainbow: false
          Max Intensity: 255
          Min Intensity: 0
          Name: Gazebo LiDAR cloud in map
          Position Transformer: XYZ
          Queue Size: 20
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.035
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/planner/global_points
          Use rainbow: true
          Use Fixed Frame: true
          Value: true
        - Alpha: 0.45
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: -1
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 180; 0
          Color Transformer: AxisColor
          Decay Time: 2
          Enabled: true
          Invert Rainbow: false
          Max Intensity: 3
          Min Intensity: -0.5
          Name: EGO occupancy inflate
          Position Transformer: XYZ
          Queue Size: 30
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.08
          Style: Boxes
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /grid_map/occupancy_inflate
          Use rainbow: true
          Use Fixed Frame: true
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Marker Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /goal_point
          Name: Goal point
          Queue Size: 10
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Marker Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /optimal_list
          Name: EGO optimal trajectory
          Queue Size: 10
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Marker Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /global_list
          Name: EGO global trajectory
          Queue Size: 10
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 45; 45
          Enabled: true
          Head Diameter: 0.18
          Head Length: 0.12
          Length: 0.2
          Line Style: Lines
          Line Width: 0.045
          Name: Gazebo actual UAV center path
          Pose Color: 255; 45; 45
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/review/actual_path
          Value: true
        - Alpha: 0.9
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 40; 230; 90
          Enabled: true
          Head Diameter: 0.18
          Head Length: 0.12
          Length: 0.2
          Line Style: Lines
          Line Width: 0.035
          Name: Figure-8 reference path
          Pose Color: 40; 230; 90
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/review/reference_path
          Value: true
      Enabled: true
      Name: EGO planner review
  Enabled: true
  Global Options:
    Background Color: 28; 28; 32
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 1.2
      Name: Current View
      Pitch: 0.75
      Target Frame: map
      Value: Orbit (rviz2)
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1350
  X: 100
  Y: 80
