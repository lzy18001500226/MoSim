Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Planning Grid1
      Splitter Ratio: 0.55
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Local occupancy grid
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.55
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.45
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.55
          Class: rviz_default_plugins/Map
          Color Scheme: map
          Draw Behind: true
          Enabled: true
          Name: Local occupancy grid
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/local_occupancy_grid
          Use Timestamp: false
          Value: true
        - Alpha: 0.35
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 85; 170; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Local known map cloud
          Position Transformer: XYZ
          Queue Size: 4
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.25
          Style: Boxes
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/local_known_map_cloud
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 25; 255; 0
          Enabled: true
          Head Diameter: 0.25
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.06
          Name: Local plan
          Pose Color: 255; 85; 255
          Pose Style: Axes
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/local_plan
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 25; 160; 255
          Enabled: true
          Head Diameter: 0.2
          Head Length: 0.15
          Length: 0.25
          Line Style: Lines
          Line Width: 0.03
          Name: UAV trajectory
          Pose Color: 25; 160; 255
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/uav_path
          Value: true
        - Angle Tolerance: 0.1
          Class: rviz_default_plugins/Odometry
          Enabled: true
          Keep: 50
          Name: Replay reference odometry
          Position Tolerance: 0.1
          Shape:
            Alpha: 1
            Axes Length: 0.55
            Axes Radius: 0.055
            Color: 25; 160; 255
            Value: Axes
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/replay_odometry
          Value: true
      Enabled: true
      Name: Planning Grid
  Enabled: true
  Global Options:
    Background Color: 38; 38; 38
    Fixed Frame: ue_world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      Target Frame: ue_world
      Value: TopDownOrtho (rviz2)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1100
  X: 20
  Y: 80
