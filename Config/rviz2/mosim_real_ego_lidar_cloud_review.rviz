Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 125
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.35
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: -1
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 0; 210; 255
          Color Transformer: AxisColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Intensity: 255
          Min Intensity: 0
          Name: Gazebo MID360 accumulated review cloud in map
          Position Transformer: XYZ
          Queue Size: 100
          Selectable: true
          Size (Pixels): 1
          Size (m): 0.003
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/review/lidar_points_map_accumulated
          Use rainbow: true
          Use Fixed Frame: true
          Value: true
        - Class: rviz_default_plugins/Odometry
          Covariance:
            Orientation:
              Alpha: 0.5
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.35
              Color: 204; 51; 204
              Scale: 0.3
              Value: false
            Value: false
          Enabled: true
          Keep: 20
          Name: Planner odom
          Position Tolerance: 0.1
          Shape:
            Alpha: 1
            Axes Length: 0.35
            Axes Radius: 0.03
            Color: 255; 80; 80
            Head Length: 0.2
            Head Radius: 0.08
            Shaft Length: 0.35
            Shaft Radius: 0.03
            Value: Axes
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/planner/odom
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 45; 45
          Enabled: true
          Head Diameter: 0.18
          Head Length: 0.12
          Length: 0.2
          Line Style: Lines
          Line Width: 0.045
          Name: Gazebo actual UAV center path
          Pose Color: 255; 45; 45
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/review/actual_path
          Value: true
        - Alpha: 0.85
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 40; 230; 90
          Enabled: true
          Head Diameter: 0.18
          Head Length: 0.12
          Length: 0.2
          Line Style: Lines
          Line Width: 0.035
          Name: Long-axis reference path
          Pose Color: 40; 230; 90
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mosim/review/reference_path
          Value: true
      Enabled: true
      Name: LiDAR point cloud review
  Enabled: true
  Global Options:
    Background Color: 24; 24; 28
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 1.2
      Name: Current View
      Pitch: 0.65
      Target Frame: map
      Value: Orbit (rviz2)
      Yaw: 0.75
    Saved: ~
Window Geometry:
  Height: 860
  Width: 1080
  X: 40
  Y: 60
