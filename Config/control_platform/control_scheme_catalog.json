  "research_basis": [
    {
      "topic": "MPC as an outer-loop controller",
      "citation": "Cascaded model predictive control of a quadrotor UAV",
      "year": 2013,
      "doi": "10.1109/AUCC.2013.6697298",
      "decision": "Treat MPC/NMPC as a primary nominal-control family rather than an augmentation checkbox."
    },
    {
      "topic": "INDI as a lower-level augmentation",
      "citation": "Adaptive Incremental Nonlinear Dynamic Inversion for Attitude Control of Micro Air Vehicles",
      "year": 2016,
      "doi": "10.2514/1.G001490",
      "decision": "Expose INDI only inside an explicitly declared fixed chain or a controlled ablation, not as an arbitrary stack with every controller."
    },
    {
      "topic": "L1 adaptive residual compensation",
      "citation": "Position trajectory tracking of a quadrotor helicopter based on L1 adaptive control",
      "year": 2013,
      "doi": "10.23919/ECC.2013.6669410",
      "decision": "Keep L1-inspired residual compensation tied to a named nominal controller and bounded interface."
    }
  ],
