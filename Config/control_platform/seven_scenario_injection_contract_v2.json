{
  "schema": "mosim.seven_scenario_injection_contract.v2",
  "version": 2,
  "status": "all_48_controller_v2_execution_routes_authorized",
  "claim_boundary": "This versioned MWORKS contract defines the 48-controller v2 A/B execution routes. It does not claim that every route passes CheckModel or tracking gates, and it does not change the Plant, controller gains, controller boundary semantics, code generation, Gazebo/ROS/QGC runtime, or APP behavior.",
  "lineage": {
    "supersedes_for_main_ab_comparison": "Config/control_platform/seven_scenario_injection_contract.json",
    "v1_evidence_policy": "Retain Results/control_platform/seven_scenario_ab as historical ClimbPath disturbance/fault screening evidence. Do not overwrite it or merge it into the v2 primary matrix.",
    "climbpath_policy": "The all-controller ClimbPath 50 s minimum-closure screen remains a separate resource-constrained admission gate and is not one of the seven v2 detailed scenarios."
  },
  "authority": {
    "model_root": "Models/MoSimQuadrotorModel/package.mo",
    "trajectory_namespace": "MoSimQuadrotorModel.Guidance.Trajectories",
    "plant": "MoSimQuadrotorModel.Vehicle.Sunray150Assembly",
    "profile_document": "Config/control_platform/seven_scenario_experiment_profiles_v2.json",
    "result_root": "Results/control_platform/seven_scenario_ab_v2/"
  },
  "common_execution": {
    "solver": "Dassl",
    "tolerance": 0.0001,
    "result_interval_s": 0.01,
    "reference_signals": [
      "position_ref[3]",
      "velocity_ref[3]",
      "acceleration_ref[3]"
    ],
    "measurement_signals": [
      "position_mea[3]",
      "velocity_mea[3]",
      "attitude_mea[3]"
    ],
    "sampling_boundary": {
      "official_pid": "native continuous reference, measurement, and rotor-command loop; Interval=0.01 standardizes result sampling only.",
      "px4ctrl": "declared 100 Hz Runner boundary; Interval=0.01 is its external sample cadence.",
      "other_graphical_runners": "Use each route's declared Runner boundary; Interval=0.01 is result sampling only.",
      "comparison_rule": "The evidence records each controller's declared execution boundary. No artificial common command-side zero-order hold is introduced."
    },
    "yaw_policy": {
      "mode": "fixed_zero",
      "applies_to": "all seven scenarios including Figure8",
      "reason": "The current shared controller contract has no yaw-reference port; v2 evaluates translational tracking under the same fixed-yaw contract."
    }
  },
  "runner_binding_policy": {
    "style": "parameterized_existing_runner_plus_ephemeral_evidence_harness",
    "authorized_runner_classes": [
      "MoSimQuadrotorModel.Experiment.Baselines.OfficialPidRunner",
