        "position": true,
        "velocity": true,
        "acceleration": true
      },
      "constraints": {
        "max_velocity_mps": 0,
        "max_acceleration_mps2": 0,
        "max_yaw_rate_radps": 0
      }
    },
    "evidence": {
      "required_artifacts": [
        "RUN_MANIFEST.json",
        "metrics.json",
        "tracking.csv",
        "review.md"
      ],
      "result_root": "Results/runs/<run_id>",
      "launch_plan": "LaunchPlan.json",
      "run_manifest": "RUN_MANIFEST.json",
      "metrics": "metrics.json",
      "tracking_log": "tracking.csv",
      "screenshots": "screenshots/",
