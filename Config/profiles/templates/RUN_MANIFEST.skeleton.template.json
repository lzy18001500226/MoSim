    "launch_plan_hash": "<sha256>",
    "profile_hashes": {
      "scenario_profile": "<sha256>",
      "plant_profile": "<sha256>",
      "sensor_profile": "<sha256>",
      "state_source_profile": "<sha256>",
      "height_source_profile": "<sha256>",
      "truth_profile": "<sha256>",
      "frequency_profile": "<sha256>",
      "trajectory_profile": "<sha256>",
      "planner_profile": "<sha256>",
      "controller_profile": "<sha256>",
      "augmentation_profile": "<sha256>",
      "safety_profile": "<sha256>",
      "adapter_profile": "<sha256>",
      "fault_profile": "<sha256>",
      "disturbance_profile": "<sha256>",
      "display_profile": "<sha256>",
      "evaluation_profile": "<sha256>",
      "runtime_profile": "<sha256>",
      "evidence_profile": "<sha256>"
    },
    "source_state": {
      "git_commit": "<commit-or-dirty>",
