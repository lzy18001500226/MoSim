<launch>

    <node name="murder_demo" pkg="murder" type="murder_node" output="screen">
        <rosparam command="load" file="$(find block_map)/color/Paranoid.yaml" />
        <rosparam command="load" file="$(find murder)/resource/murder_demo_real.yaml" />
        <rosparam command="load" file="$(find block_map)/color/color_id.yaml" />
        <remap from="/depth" to="/camera/depth/image_rect_raw"/>
        <remap from="/odom" to="/mavros/local_position/odom"/>
        <remap from="/vi_odom" to="/mavros/local_position/odom"/>
        <remap from="/block_map/caminfo" to="/camera/depth/camera_info"/>
    </node>

    <node name="traj_exc_node" pkg="traj_exc" type="traj_exc_node" output="screen">
        <rosparam command="load" file="$(find murder)/resource/murder_demo_real.yaml" />
        <remap from="/odom" to="/mavros/local_position/odom"/>
        <remap from="/trajectory_cmd" to="/Murder/Traj"/>
        <remap from="/takeoff" to="/real/takeoff"/>
    </node>


  <node pkg="topic_tools" type="throttle" name="cam_throttle" args="messages /camera/depth/image_rect_raw 4.0 /camera/depth/image_rect_raw_throttle" output="screen"/> 

  <node pkg="rosbag" type="record" name="bag_record" args="/mavros/local_position/odom
        /camera/depth/image_rect_raw_throttle
        /murder_demo/block_map/voxvis
        /traj_exc_node/traj_show
        /mavros/setpoint_raw/local
        -o /home/uav5/data/FSMP/outdoor.bag"/>

    <!-- <include file="$(find murder)/launch/rotors_sim.launch">
        <arg name="world" value="small_maze" />
        <arg name="gui" value="false" />
        <arg name="waypoint_x" value="0.0" />
        <arg name="waypoint_y" value="0.0" />
        <arg name="waypoint_z" value="1.0" />
        <arg name="odom_topic" value="/ground_truth/odometry" />
    </include> -->

    <!-- <node name="rvizvisualisation" pkg="rviz" type="rviz" output="screen" args="-d $(find murder)/rviz/murder_demo.rviz" /> -->

</launch>