<launch>

    <node name="murder_demo" pkg="murder" type="murder_node" output="screen">
        <rosparam command="load" file="$(find block_map)/color/Paranoid.yaml" />
        <rosparam command="load" file="$(find murder)/resource/high_mobility/murder_demo_powerplant_low.yaml" />
        <rosparam command="load" file="$(find block_map)/color/color_id.yaml" />
        <remap from="/depth" to="/firefly/vi_sensor/camera_depth/depth/disparity"/>
        <remap from="/odom" to="/firefly/ground_truth/odometry"/>
        <remap from="/vi_odom" to="/firefly/vi_sensor/ground_truth/odometry"/>
        <remap from="/block_map/caminfo" to="/firefly/vi_sensor/camera_depth/depth/camera_info"/>
    </node>

    <node name="traj_exc_node" pkg="traj_exc" type="traj_exc_node" output="screen">
        <rosparam command="load" file="$(find murder)/resource/high_mobility/murder_demo_powerplant_low.yaml" />
        <remap from="/odom" to="/firefly/ground_truth/odometry"/>
        <remap from="/trajectory_cmd" to="/Murder/Traj"/>
    </node>

    <include file="$(find murder)/launch/rotors_sim.launch">
        <arg name="world" value="power_plant" />
        <arg name="gui" value="false" />
        <arg name="waypoint_x" value="-1.5" />
        <arg name="waypoint_y" value="1.5" />
        <arg name="waypoint_z" value="1.5" />
        <arg name="odom_topic" value="/ground_truth/odometry" />
    </include>

    <node name="rvizvisualisation" pkg="rviz" type="rviz" output="screen" args="-d $(find murder)/rviz/murder_demo.rviz" />
<!-- <node pkg="rosbag" type="record" name="bag_record" args="
        /firefly/ground_truth/odometry
        /murder_demo/block_map/voxvis
        -o /home/charliedog/data/High_mobility/low/proposed_maze4_low.bag"/> -->
</launch>