#version 430

layout (local_size_x = 4, local_size_y = 4, local_size_z = 1) in;



layout (binding=0, std430) buffer PointBuffer {
    float data[];
} point_buffer;

layout (binding=1, std430) buffer TriangleBuffer {
    float data[];
} triangle_buffer;

layout (binding=2, std430) buffer ObjectBuffer {
    float data[];
} object_buffer;

layout (binding=3, std430) buffer InfoBuffer {
    float data[];
} info_buffer;

layout (binding=4, std430) buffer RayBuffer {
    float data[];
} ray_buffer;


int maxIterStep;
int pointUnitSize;
int triangleUnitSize;
int objectUnitSize;
int rayUnitSize;
int interPointUnitSize;
int receiverMaterial;

int objectCount;

struct RTRay
{
	vec3 start;
	vec3 dir;
	int level;
	uint index;
};

struct RTPoint
{
	vec3 point;
	vec3 normal;
};

struct RTTriangle
{
	vec3 p1;
	vec3 p2;
	vec3 p3;
	vec3 n1;
	vec3 n2;
	vec3 n3;
};


struct RTObject
{
	int leftChild;
	int rightChild;

	int triangleIndex;
	int triangleNum;

	vec3 boundMin;
	vec3 boundMax;

	int materialID;
};


