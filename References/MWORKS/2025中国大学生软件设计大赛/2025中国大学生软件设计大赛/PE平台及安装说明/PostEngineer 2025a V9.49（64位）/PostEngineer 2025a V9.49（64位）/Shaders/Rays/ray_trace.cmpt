bool HitScene(RTRay ray, out RTRay refl_ray)
{
	HitResult res_nearest;
	res_nearest.distance = INF;
	res_nearest.isHit = false;

	int objectStack[128];
	int objectStackSize = 1;
	objectStack[0] = 0;

	int n = 0;
	int max_size = 0;
	while(objectStackSize > 0 && n++ < 10000){
		int index = objectStack[objectStackSize-1];
		objectStackSize--;

		//HitObject(GetRTObject(index), ray, refl_ray, res_nearest);

		RTObject object = GetRTObject(index);
		if(HitAABB(ray, object.boundMin, object.boundMax) < 0){
			continue;
		}

		if(object.triangleNum > 0){
			HitObjectGeometry(object, ray, refl_ray, res_nearest);
		}
		else{
			if(object.rightChild > 0 && objectStackSize < 128){
				objectStack[objectStackSize] = object.rightChild;
				objectStackSize++;
			}

			if(object.leftChild > 0 && objectStackSize < 128){
				objectStack[objectStackSize] = object.leftChild;
				objectStackSize++;
			}
		}

		if(max_size < objectStackSize) max_size = objectStackSize;
	}

	if(info_buffer.data[4] < n)info_buffer.data[4] = n;  //for test
	if(info_buffer.data[5] < max_size) info_buffer.data[5] = max_size;  //for test
	
	if(res_nearest.isHit == true){

		///记录交点
		RecordIntersection(ray, res_nearest);

		///到达接收器则停止
		if(res_nearest.materialID % 1000 == receiverMaterial){
			//if(res_nearest.materialID % 1000 == receiverMaterial) info_buffer.data[4] = 888;  // for test
			return false;
		}

		if(ray.level >= maxIterStep - 1){

			CheckPath(ray.index);

			return false;
		}

		refl_ray.dir = normalize(reflect(ray.dir, res_nearest.normal));
		refl_ray.start = res_nearest.hitPoint + refl_ray.dir * 0.00001; ///避免重复相交

		refl_ray.level = ray.level + 1;
		refl_ray.index = ray.index;
	}

	///最后检查路径是否有效
	if(res_nearest.isHit == false){
		CheckPath(ray.index);
	}

	return res_nearest.isHit;
}



void main() 
{
	ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);
	ivec2 groupNum = ivec2(gl_NumWorkGroups);
	ivec2 groupSize = ivec2(gl_WorkGroupSize);

	int globalIndex = (pos.z * groupNum.y * groupSize.y + pos.y) * groupNum.x * groupSize.x + pos.x;


	maxIterStep = INT(info_buffer.data[0]);
	pointUnitSize = 6;
	triangleUnitSize = 3;
	objectUnitSize = 11;
	interPointUnitSize = 3 + 3 + 3 + 1; //点，法线，入射方向，材质ID
	rayUnitSize = 1 + interPointUnitSize * maxIterStep;

	objectCount = INT(info_buffer.data[1]);
	receiverMaterial = INT(info_buffer.data[2]);

	RTRay ray;
	ray.start = vec3(ray_buffer.data[globalIndex*rayUnitSize + 1 + 0],
					 ray_buffer.data[globalIndex*rayUnitSize + 1 + 1],
					 ray_buffer.data[globalIndex*rayUnitSize + 1 + 2]);

	ray.dir = vec3(ray_buffer.data[globalIndex*rayUnitSize + 1 + 3],
				   ray_buffer.data[globalIndex*rayUnitSize + 1 + 4],
				   ray_buffer.data[globalIndex*rayUnitSize + 1 + 5]);

	///初始化交点个数
	ray_buffer.data[globalIndex*rayUnitSize + 0] = 0;

	ray.index = globalIndex;
	ray.level = 0;

	RTRay reflect_ray;
	while(HitScene(ray, reflect_ray) == true){
		ray = reflect_ray;
	}

}