}*/


float HitAABB(RTRay r, vec3 AA, vec3 BB) 
{
	const float EPS = 1e-6;
	for (int i = 0; i < 3; i++)	{		
	
		// 如果光线某一个轴分量为 0，且在包围盒这个轴分量之外，那么直接判定不相交 		
		if (abs(r.dir[i]) < EPS)		
		{			
			if (r.start[i] < AA[i] || r.start[i] > BB[i])				
				return -1;		
		}	
	}

    vec3 invdir = 1.0 / r.dir;

    vec3 f = (BB - r.start) * invdir;
    vec3 n = (AA - r.start) * invdir;

    vec3 tmax = max(f, n);
    vec3 tmin = min(f, n);

    float t1 = min(tmax.x, min(tmax.y, tmax.z));
    float t0 = max(tmin.x, max(tmin.y, tmin.z));

    return (t1 >= t0) ? ((t0 > 0.0) ? (t0) : (t1)) : (-1);
}


void RecordIntersection(RTRay ray, HitResult res)
{
	int count = INT(ray_buffer.data[ray.index*rayUnitSize + 0]);

	if(count >= maxIterStep) return;

	ray_buffer.data[ray.index*rayUnitSize + 1 + count*interPointUnitSize + 0] = res.hitPoint.x;
	ray_buffer.data[ray.index*rayUnitSize + 1 + count*interPointUnitSize + 1] = res.hitPoint.y;
	ray_buffer.data[ray.index*rayUnitSize + 1 + count*interPointUnitSize + 2] = res.hitPoint.z;

	ray_buffer.data[ray.index*rayUnitSize + 1 + count*interPointUnitSize + 3] = res.normal.x;
	ray_buffer.data[ray.index*rayUnitSize + 1 + count*interPointUnitSize + 4] = res.normal.y;
	ray_buffer.data[ray.index*rayUnitSize + 1 + count*interPointUnitSize + 5] = res.normal.z;

	ray_buffer.data[ray.index*rayUnitSize + 1 + count*interPointUnitSize + 6] = res.inDir.x;
	ray_buffer.data[ray.index*rayUnitSize + 1 + count*interPointUnitSize + 7] = res.inDir.y;
	ray_buffer.data[ray.index*rayUnitSize + 1 + count*interPointUnitSize + 8] = res.inDir.z;

	ray_buffer.data[ray.index*rayUnitSize + 1 + count*interPointUnitSize + 9] = res.materialID;

	ray_buffer.data[ray.index*rayUnitSize + 0] = count + 1;
}

bool CheckPath(uint index)
{
	
	int count = INT(ray_buffer.data[index*rayUnitSize + 0]);

	if(count == 0) return false;

	int last_material = INT(ray_buffer.data[index*rayUnitSize + 1 + (count-1)*interPointUnitSize + 9]);
	if(last_material != receiverMaterial){
		ray_buffer.data[index*rayUnitSize + 0] = 0;
		return false;
	}

	return true;
}

RTPoint GetRTPoint(int index)
{
	RTPoint rtp;
	rtp.point = vec3(point_buffer.data[index*pointUnitSize + 0], point_buffer.data[index*pointUnitSize + 1], point_buffer.data[index*pointUnitSize + 2]);
	rtp.normal = vec3(point_buffer.data[index*pointUnitSize + 3], point_buffer.data[index*pointUnitSize + 4], point_buffer.data[index*pointUnitSize + 5]);

	return rtp;
}

RTObject GetRTObject(int index)
{
	RTObject object;

	object.leftChild = INT(object_buffer.data[index*objectUnitSize + 0]);
	object.rightChild = INT(object_buffer.data[index*objectUnitSize + 1]);

	object.triangleIndex = INT(object_buffer.data[index*objectUnitSize + 2]);
	object.triangleNum = INT(object_buffer.data[index*objectUnitSize + 3]);

	object.boundMin = vec3(object_buffer.data[index*objectUnitSize + 4], object_buffer.data[index*objectUnitSize + 5], object_buffer.data[index*objectUnitSize + 6]);
	object.boundMax = vec3(object_buffer.data[index*objectUnitSize + 7], object_buffer.data[index*objectUnitSize + 8], object_buffer.data[index*objectUnitSize + 9]);

	object.materialID = INT(object_buffer.data[index*objectUnitSize + 10]);

	return object;
}

RTTriangle GetRTTriangle(int index)
{
	int pi1, pi2, pi3;
	pi1 = INT(triangle_buffer.data[index*triangleUnitSize + 0]);
	pi2 = INT(triangle_buffer.data[index*triangleUnitSize + 1]);
	pi3 = INT(triangle_buffer.data[index*triangleUnitSize + 2]);

	RTPoint rpt1 = GetRTPoint(pi1);
	RTPoint rpt2 = GetRTPoint(pi2);
	RTPoint rpt3 = GetRTPoint(pi3);

	RTTriangle tri;
	tri.p1 = rpt1.point;
	tri.p2 = rpt2.point;
	tri.p3 = rpt3.point;

	tri.n1 = rpt1.normal;
	tri.n2 = rpt2.normal;
	tri.n3 = rpt3.normal;

	return tri;
}


bool HitObjectGeometry(RTObject object, RTRay ray, out RTRay refl_ray, inout HitResult res_nearest)
{
	bool bHit = false;
	for(int i=0; i<object.triangleNum; i++){

		RTTriangle tri = GetRTTriangle(object.triangleIndex + i);

		HitResult res = HitTriangle(ray, tri);

		if(res.isHit == true){

			//res.id = hitID;  /// for test
			//hitID++;  /// for test
	
			if(res_nearest.distance > res.distance + 0.00001){
				res_nearest = res;
				bHit = true;

			}
		}
	}

	if(bHit == true){
		res_nearest.materialID = object.materialID;
	}

			/*if(res_nearest.materialID == receiverMaterial && bHit == true){
					info_buffer.data[3] = 999;  // for test
					info_buffer.data[5] = res_nearest.id;  // for test
					info_buffer.data[6] = res_nearest.materialID;  // for test
					info_buffer.data[7] = res_nearest.distance;  // for test
				}*/

	return bHit;
}

