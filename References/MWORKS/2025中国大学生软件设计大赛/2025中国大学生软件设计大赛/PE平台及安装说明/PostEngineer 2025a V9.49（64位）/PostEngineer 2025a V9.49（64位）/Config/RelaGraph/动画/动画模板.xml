<?xml version="1.0" encoding="gb2312"?>

<动画表 version="100">
	
	<类别 name="相机">
		<动画 name="相机变换到" file="动画模板文件\相机变换到.tpl">
			<参数 name="相机"/>
			<参数 name="时间"/>
			<参数 name="备注"/>
		</动画>

		<动画 name="相机拉近到" file="动画模板文件\相机拉近到.tpl">
			<参数 name="节点路径"/>
			<参数 name="时间"/>
			<参数 name="备注"/>
		</动画>

		<动画 name="旋转相机" file="动画模板文件\旋转相机.tpl">
			<参数 name="轴"/>
			<参数 name="角度"/>
			<参数 name="时间"/>
			<参数 name="备注"/>
		</动画>

	</类别>

	<类别 name="动画">

		<动画 name="调用动画" file="动画模板文件\调用动画.tpl">
			<参数 name="动画名"/>
			<参数 name="时间"/>
			<参数 name="反向"/>
			<参数 name="备注"/>
		</动画>

		<动画 name="引用动画" file="动画模板文件\引用动画.tpl">
			<参数 name="动画名"/>
			<参数 name="属性"/>
			<参数 name="速度"/>
			<参数 name="原始节点"/>
			<参数 name="新节点"/>
			<参数 name="备注"/>
		</动画>

		<动画 name="连续事件" file="动画模板文件\连续事件.tpl">
			<参数 name="时间"/>
			<参数 name="间隔"/>
			<参数 name="程序"/>
			<参数 name="备注"/>
		</动画>

	</类别>

	<类别 name="物体">

		<动画 name="闪烁物体" file="动画模板文件\闪烁物体.tpl">
			<参数 name="路径"/>
			<参数 name="备注"/>
		</动画>

		<动画 name="发光闪烁" file="动画模板文件\发光闪烁.tpl">
			<参数 name="时间"/>
			<参数 name="路径"/>
			<参数 name="备注"/>
		</动画>

		<动画 name="透明化物体" file="动画模板文件\透明化物体.tpl">
			<参数 name="路径"/>
			<参数 name="开始透明度"/>
			<参数 name="结束透明度"/>
			<参数 name="时间"/>
			<参数 name="备注"/>
		</动画>

	</类别>

	<类别 name="实体">

		<动画 name="调用行为" >
			<参数 name="实体名称"/>
			<参数 name="行为ID"/>
		</动画>
		<指令 name="预定路线移动实体"  file="动画模板文件\沿路径运动.tpl">
			<参数 name="名称" />
			<参数 name="路线名" />
			<参数 name="总时间" />
			<参数 name="起始时间" />
		</指令>
		<指令 name="从起点运动到终点"  file="动画模板文件\从起点到终点.tpl">
			<参数 name="名称" />
			<参数 name="起点" />
			<参数 name="终点" />
			<参数 name="总时间" />
			<参数 name="起始时间" />
		</指令>
		<指令 name="按速度从起点运动到终点"  file="动画模板文件\按速度从起点到终点.tpl">
			<参数 name="名称" />
			<参数 name="起点" />
			<参数 name="终点" />
			<参数 name="速度" />
			<参数 name="起始时间" />
		</指令>

	</类别>

	<类别 name="其他">

		<动画 name="空闲" file="动画模板文件\空闲.tpl">
			<参数 name="时间"/>
		</动画>

		<动画 name="开关" file="动画模板文件\开关.tpl">
			<参数 name="条件"/>
      			<参数 name="状态1"/>
      			<参数 name="状态2"/>
      			<参数 name="状态3"/>
      			<参数 name="状态4"/>
      			<参数 name="状态5"/>
      			<参数 name="状态6"/>
      			<参数 name="状态7"/>
      			<参数 name="状态8"/>
		</动画>

		<动画 name="信号" file="动画模板文件\开关.tpl">
			<参数 name="条件"/>
      			<参数 name="状态1"/>
      			<参数 name="状态2"/>
      			<参数 name="状态3"/>
      			<参数 name="状态4"/>
      			<参数 name="状态5"/>
      			<参数 name="状态6"/>
      			<参数 name="状态7"/>
      			<参数 name="状态8"/>
		</动画>


	</类别>

</动画表>
