
'创建时间: 2021-09-17
'作者: ypj
'描述: ndpnet 通信测试
'更新: 2021-09-22
'ypj, 2021-10-08, 添加消息处理

Script {

include{Ndpnet.script}	


'--------------------------------
' 消息处理类
'--------------------------------
class NdpnetMessageListener 
{
    string mLogFilePath;
	NdpnetManager mNdpnetMgr;

    '-------------------------------------------------------
	' 涉及到的消息。在处理消息前，PE 会将相应 ID 的消息赋值。
	'-------------------------------------------------------
	
    NdpnetMessageListener() 
	{
    } 

    '//设置组件ID
    void onMessageSetModuleId()
	{
		'//接收到消息，需要把消息内容及时拷贝出来，下次消息到来原地址内容会被覆盖
		'printf("接收到 NDPNET_SET_MODULE_ID_MSG_ID 消息.\n");

		'ndpnet_set_module_id_msg * pmsg = (ndpnet_set_module_id_msg*)(pvoid);
		'ndp_uint32 sequence = pmsg->sequence;//包序号
		'ndp_uint8 resFlag = pmsg->resFlag;//响应标识
		'ndp_uint32 moduleId = pmsg->moduleId;//组件ID
		'ndp_uint16 moduleTypeId = pmsg->moduleTypeId;//组件类型ID

		'ndp_uint16 unitId = pmsg->calcEnv.unitId;//机组ID
		'ndp_uint8  calcModeId = pmsg->calcEnv.calcModeId;//计算模式ID
		'ndp_uint16 workModeId = pmsg->calcEnv.workModeId;//工况ID
		'ndp_uint8 unitName[NDPNET_STR_SIZE];//机组名称
		'ndp_uint8 calcModeName[NDPNET_STR_SIZE];//计算模式
		'ndp_uint8 workModeName[NDPNET_STR_SIZE];//工况名称

		'memset(unitName, 0, NDPNET_STR_SIZE);
		'memset(calcModeName, 0, NDPNET_STR_SIZE);
		'memset(workModeName, 0, NDPNET_STR_SIZE);

		'memcpy(unitName, pmsg->calcEnv.unitName, NDPNET_STR_SIZE);
		'memcpy(calcModeName, pmsg->calcEnv.calcModeName, NDPNET_STR_SIZE);
		'memcpy(workModeName, pmsg->calcEnv.workModeName, NDPNET_STR_SIZE);
		'printf("组件ID: %d.\n", moduleId);
		'printf("机组ID: %d.\n", unitId);
		'printf("机组名称: %s.\n", unitName);
		'printf("计算模式: %s.\n", calcModeName);
		'printf("工况名称: %s.\n", workModeName);


		'// 计算环境准备就绪后，发送准备就绪消息
		'ndpnet_calc_ready_msg ready_msg;
		'ready_msg.flag = NDPNET_CALC_READY_ERROR;
		'ready_msg.dataTime = 2000;
		'strcpy((char *)(ready_msg.errorMsg), "计算准备错误时，设置的计算准备错误消息");

		'ndpnet_send_calc_ready(pmsg->handle, &ready_msg);

		'// 解析消息：获取消息值，并使用。
		appPrintLog(mLogFilePath, "[onMessageSetModuleId] 接收到 NDPNET_SET_MODULE_ID_MSG_ID 消息.", 1);
		appPrintLog(mLogFilePath, "[onMessageSetModuleId] ndpnetSetModuleIdMsg.resFlag", ndpnetSetModuleIdMsg.resFlag);
		appPrintLog(mLogFilePath, "[onMessageSetModuleId] ndpnetSetModuleIdMsg.sequence", ndpnetSetModuleIdMsg.sequence);
		appPrintLog(mLogFilePath, "[onMessageSetModuleId] ndpnetSetModuleIdMsg.moduleTypeId", ndpnetSetModuleIdMsg.moduleTypeId);
		appPrintLog(mLogFilePath, "[onMessageSetModuleId] ndpnetSetModuleIdMsg.moduleId", ndpnetSetModuleIdMsg.moduleId);
		appPrintLog(mLogFilePath, "[onMessageSetModuleId] ndpnetSetModuleIdMsg.calcEnv.unitId", ndpnetSetModuleIdMsg.calcEnv.unitId);
		appPrintLog(mLogFilePath, "[onMessageSetModuleId] ndpnetSetModuleIdMsg.calcEnv.calcModeId", ndpnetSetModuleIdMsg.calcEnv.calcModeId);
		appPrintLog(mLogFilePath, "[onMessageSetModuleId] ndpnetSetModuleIdMsg.calcEnv.workModeId", ndpnetSetModuleIdMsg.calcEnv.workModeId);
		appPrintLog(mLogFilePath, "[onMessageSetModuleId] ndpnetSetModuleIdMsg.calcEnv.unitName", 1);
		appPrintLog(mLogFilePath, ndpnetSetModuleIdMsg.calcEnv.unitName, 1);
		appPrintLog(mLogFilePath, "[onMessageSetModuleId] ndpnetSetModuleIdMsg.calcEnv.calcModeName", 2);
		appPrintLog(mLogFilePath, ndpnetSetModuleIdMsg.calcEnv.calcModeName, 2);
		appPrintLog(mLogFilePath, "[onMessageSetModuleId] ndpnetSetModuleIdMsg.calcEnv.workModeName", 3);
		appPrintLog(mLogFilePath, ndpnetSetModuleIdMsg.calcEnv.workModeName, 3);

		'// 应答：设置应答消息并发送（ndpnet_calc_ready_msg）
		ndpnetCalcReadyMsg.flag = NDPNET_CALC_READY_ERROR;
		ndpnetCalcReadyMsg.dataTime = 2000;
		ndpnetCalcReadyMsg.errorMsg = "计算准备错误时，设置的计算准备错误消息";
		ndpnetCalcReadyMsg.calcEnv.unitId = ndpnetSetModuleIdMsg.calcEnv.unitId;
		ndpnetCalcReadyMsg.calcEnv.calcModeId = ndpnetSetModuleIdMsg.calcEnv.calcModeId;
		ndpnetCalcReadyMsg.calcEnv.workModeId = ndpnetSetModuleIdMsg.calcEnv.workModeId;
		if(mNdpnetMgr.sendCalcReady() == 0) { '// 发送消息
		    appPrintLog(mLogFilePath, "[onMessageSetModuleId]  sendCalcReady 成功。", 1);
		}
		else {
		    appPrintLog(mLogFilePath, "[onMessageSetModuleId]  sendCalcReady 失败。", 1);
		}
		
	}

    '//设置计算环境
    void onMessageSetCalcEnv()  
    {
		'printf("接收到 NDPNET_SET_CALC_ENV_MSG_ID 消息.\n");
		
		'ndpnet_set_calc_env_msg * pmsg = (ndpnet_set_calc_env_msg*)(pvoid);
		'ndp_uint32 sequence = pmsg->sequence;//响应包序号
		'ndp_uint8 resFlag = pmsg->resFlag;//响应标识

		'ndp_uint16 unitId = pmsg->calcEnv.unitId;//机组ID
		'ndp_uint8  calcModeId = pmsg->calcEnv.calcModeId;//计算模式ID
		'ndp_uint16 workModeId = pmsg->calcEnv.workModeId;//工况ID
		'ndp_uint8 unitName[NDPNET_STR_SIZE];//机组名称
		'ndp_uint8 calcModeName[NDPNET_STR_SIZE];//计算模式
		'ndp_uint8 workModeName[NDPNET_STR_SIZE];//工况名称

		'memset(unitName, 0, NDPNET_STR_SIZE);
		'memset(calcModeName, 0, NDPNET_STR_SIZE);
		'memset(workModeName, 0, NDPNET_STR_SIZE);

		'memcpy(unitName, pmsg->calcEnv.unitName, NDPNET_STR_SIZE);
		'memcpy(calcModeName, pmsg->calcEnv.calcModeName, NDPNET_STR_SIZE);
		'memcpy(workModeName, pmsg->calcEnv.workModeName, NDPNET_STR_SIZE);

		'printf("机组ID: %d.\n", unitId);
		'printf("机组ID: %s.\n", unitName);
		'//计算环境准备就绪后，发送准备就绪消息
		'ndpnet_calc_ready_msg ready_msg;
		'ready_msg.flag = NDPNET_CALC_READY_ERROR;
		'ready_msg.dataTime = 2000;
		'strcpy((char *)(ready_msg.errorMsg), "计算准备错误时，设置的计算准备错误消息");
		'ndpnet_send_calc_ready(pmsg->handle, &ready_msg);
		
		'// 解析消息：获取消息值，并使用。
		appPrintLog(mLogFilePath, "[onMessageSetCalcEnv] 接收到 NDPNET_SET_CALC_ENV_MSG_ID 消息.", 1);
		appPrintLog(mLogFilePath, "[onMessageSetCalcEnv] ndpnetSetCalcEnvMsg.resFlag", ndpnetSetCalcEnvMsg.resFlag);
		appPrintLog(mLogFilePath, "[onMessageSetCalcEnv] ndpnetSetCalcEnvMsg.sequence", ndpnetSetCalcEnvMsg.sequence);
		appPrintLog(mLogFilePath, "[onMessageSetCalcEnv] ndpnetSetCalcEnvMsg.calcEnv.unitId", ndpnetSetCalcEnvMsg.calcEnv.unitId);
		appPrintLog(mLogFilePath, "[onMessageSetCalcEnv] ndpnetSetCalcEnvMsg.calcEnv.calcModeId", ndpnetSetCalcEnvMsg.calcEnv.calcModeId);
		appPrintLog(mLogFilePath, "[onMessageSetCalcEnv] ndpnetSetCalcEnvMsg.calcEnv.workModeId", ndpnetSetCalcEnvMsg.calcEnv.workModeId);
		appPrintLog(mLogFilePath, "[onMessageSetCalcEnv] ndpnetSetCalcEnvMsg.calcEnv.unitName", 1);
		appPrintLog(mLogFilePath, ndpnetSetCalcEnvMsg.calcEnv.unitName, 1);
		appPrintLog(mLogFilePath, "[onMessageSetCalcEnv] ndpnetSetCalcEnvMsg.calcEnv.calcModeName", 2);
		appPrintLog(mLogFilePath, ndpnetSetCalcEnvMsg.calcEnv.calcModeName, 2);
		appPrintLog(mLogFilePath, "[onMessageSetCalcEnv] ndpnetSetCalcEnvMsg.calcEnv.workModeName", 3);
		appPrintLog(mLogFilePath, ndpnetSetCalcEnvMsg.calcEnv.workModeName, 3);

		'// 应答：设置应答消息并发送（ndpnet_calc_ready_msg）
		ndpnetCalcReadyMsg.flag = NDPNET_CALC_READY_ERROR;
		ndpnetCalcReadyMsg.dataTime = 2000;
		ndpnetCalcReadyMsg.errorMsg = "计算准备错误时，设置的计算准备错误消息";
		ndpnetCalcReadyMsg.calcEnv.unitId = ndpnetSetCalcEnvMsg.calcEnv.unitId;
		ndpnetCalcReadyMsg.calcEnv.calcModeId = ndpnetSetCalcEnvMsg.calcEnv.calcModeId;
		ndpnetCalcReadyMsg.calcEnv.workModeId = ndpnetSetCalcEnvMsg.calcEnv.workModeId;
		if(mNdpnetMgr.sendCalcReady() == 0) { '// 发送消息
		    appPrintLog(mLogFilePath, "[onMessageSetCalcEnv]  sendCalcReady 成功。", 1);
		}
		else {
		    appPrintLog(mLogFilePath, "[onMessageSetCalcEnv]  sendCalcReady 失败。", 1);
		}

	}
    '//设置组件模式
	void onMessageSetModuleMode()
	{	
		'printf("接收到 NDPNET_SET_MODULE_MODE_MSG_ID 消息.\n");
		'ndpnet_set_module_mode_msg * pmsg = (ndpnet_set_module_mode_msg*)(pvoid);
		'ndp_uint32 sequence = pmsg->sequence;//响应包序号
		'ndp_uint8 resFlag = pmsg->resFlag;//响应标识

		'ndp_uint16 unitId = pmsg->calcEnv.unitId;//机组ID
		'ndp_uint8  calcModeId = pmsg->calcEnv.calcModeId;//计算模式ID
		'ndp_uint16 workModeId = pmsg->calcEnv.workModeId;//工况ID
		'ndp_uint16 moduleModeId = pmsg->moduleModeId;

		'//根据响应标识，响应消息
		'if (resFlag == NDPNET_IMMEDIATELY_RESPONSE) {
		'	//发送指令响应消息
		'	ndpnet_client_response_msg res_msg;
		'	res_msg.msgId = NDPNET_SET_MODULE_MODE_MSG_ID;
		'	res_msg.excuteResult = NDPNET_EXCUTE_ERROR;
		'	res_msg.sequence = sequence;
		'	strcpy((char *)(res_msg.comment), "设置组件工作模式失败");
		'	ndpnet_send_client_response_msg(pmsg->handle, &res_msg);
		'}

		
		'// 解析消息：获取消息值，并使用。
		appPrintLog(mLogFilePath, "[onMessageSetModuleMode] 接收到 NDPNET_SET_MODULE_MODE_MSG_ID 消息.", 1);
		appPrintLog(mLogFilePath, "[onMessageSetModuleMode] ndpnetSetModuleModeMsg.resFlag", ndpnetSetModuleModeMsg.resFlag);
		appPrintLog(mLogFilePath, "[onMessageSetModuleMode] ndpnetSetModuleModeMsg.sequence", ndpnetSetModuleModeMsg.sequence);
		appPrintLog(mLogFilePath, "[onMessageSetModuleMode] ndpnetSetModuleModeMsg.moduleModeId", ndpnetSetModuleModeMsg.moduleModeId);
		appPrintLog(mLogFilePath, "[onMessageSetModuleMode] ndpnetSetModuleModeMsg.calcEnv.unitId", ndpnetSetModuleModeMsg.calcEnv.unitId);
		appPrintLog(mLogFilePath, "[onMessageSetModuleMode] ndpnetSetModuleModeMsg.calcEnv.calcModeId", ndpnetSetModuleModeMsg.calcEnv.calcModeId);
		appPrintLog(mLogFilePath, "[onMessageSetModuleMode] ndpnetSetModuleModeMsg.calcEnv.workModeId", ndpnetSetModuleModeMsg.calcEnv.workModeId);


		'// 应答：设置应答消息并发送（ndpnet_client_response_msg）
		ndpnetClientResponseMsg.msgId = NDPNET_SET_MODULE_MODE_MSG_ID;
		ndpnetClientResponseMsg.excuteResult = NDPNET_EXCUTE_ERROR;
		ndpnetClientResponseMsg.sequence = ndpnetSetModuleModeMsg.sequence;
		ndpnetClientResponseMsg.comment = "设置组件工作模式失败";

		if(mNdpnetMgr.sendClientResponseMsg() == 0) { '// 发送消息
		    appPrintLog(mLogFilePath, "[onMessageSetModuleMode]  sendClientResponseMsg 成功。", 1);
		}
		else {
		    appPrintLog(mLogFilePath, "[onMessageSetModuleMode]  sendClientResponseMsg 失败。", 1);
		}
	}

	'//服务端响应包消息
	void onMessageResponse()
	{
		'printf("接收到 NDPNET_RESPONSE_MSG_ID 消息.\n");
		'ndpnet_response_msg * pmsg = (ndpnet_response_msg*)(pvoid);
		'ndp_uint32 sequence = pmsg->sequence;//响应包序号
		'ndp_uint8 resFlag = pmsg->resFlag;//响应标识

		'ndp_uint16 msgId = pmsg->msgId;//被响应的消息ID
		'ndp_uint16 excuteResult = pmsg->excuteResult;//响应结果

		'ndp_uint8 comment[NDPNET_STR_SIZE];//响应附加消息
		'memset(comment, 0, NDPNET_STR_SIZE);
		'memcpy(comment, pmsg->comment, NDPNET_STR_SIZE);

		'// 不需要解析服务端响应消息包?
		appPrintLog(mLogFilePath, "[onMessageResponse] 接收到 NDPNET_RESPONSE_MSG_ID 消息.", 1);
	}

	'//心跳消息
	void onMessageHeart()
	{
		'printf("接收到 NDPNET_HEART_MSG_ID msg.\n");
		'ndpnet_heart_msg * pmsg = (ndpnet_heart_msg*)(pvoid);
		'ndp_uint32 sequence = pmsg->sequence;//包序号
		'ndp_uint8 resFlag = pmsg->resFlag;//响应标识
		'ndp_uint64 ts = pmsg->ts;//时间(1970年1月1日0时以来的秒数)
		'						 //发送心跳响应包
		'ndpnet_send_heart_response(pmsg->handle);

		' 不需要解析心跳消息内容
		appPrintLog(mLogFilePath, "[onMessageHeart] 接收到 NDPNET_HEART_MSG_ID msg.", 1);

		' 应答：无需设置参数，直接应答
		if(mNdpnetMgr.sendHeartResponse() == 0) '// 发送消息
		{
		    appPrintLog(mLogFilePath, "[onMessageHeart]  sendHeartResponse 成功。", 1);
		}
		else {
		    appPrintLog(mLogFilePath, "[onMessageHeart]  sendHeartResponse 失败。", 1);
		}
	}
    '//开始计算
	void onMessageCtrlStartCalc()
	{
		'printf("接收到 NDPNET_CTRL_START_CALC_MSG_ID 消息.\n");
		'ndpnet_ctrl_start_calc_msg * pmsg = (ndpnet_ctrl_start_calc_msg*)(pvoid);
		'ndp_uint32 sequence = pmsg->sequence;//响应包序号
		'ndp_uint8 resFlag = pmsg->resFlag;//响应标识
		'ndp_uint16 moduleModeId = pmsg->moduleModeId;//组件运行模式ID
		'ndp_uint32 starTime = pmsg->starTime;//开始时间
		'ndp_uint32 calcTime = pmsg->calcTime;//计算时间
		'									 //组件执行开始计算动作
		'									 //根据响应标识，响应消息
		'if (resFlag == NDPNET_IMMEDIATELY_RESPONSE) {
		'	//发送指令响应消息
		'	ndpnet_client_response_msg res_msg;
		'	res_msg.msgId = NDPNET_CTRL_START_CALC_MSG_ID;
		'	res_msg.excuteResult = NDPNET_EXCUTE_OK;
		'	res_msg.sequence = pmsg->sequence;
		'	strcpy((char *)(res_msg.comment), "启动计算成功");
		'	ndpnet_send_client_response_msg(pmsg->handle, &res_msg);
		'}
		
		'// 解析消息：获取消息值，并使用。
		appPrintLog(mLogFilePath, "[onMessageCtrlStartCalc] 接收到 NDPNET_CTRL_START_CALC_MSG_ID 消息", 1);
		appPrintLog(mLogFilePath, "[onMessageCtrlStartCalc] ndpnetCtrlStartCalcMsg.resFlag", ndpnetCtrlStartCalcMsg.resFlag);
		appPrintLog(mLogFilePath, "[onMessageCtrlStartCalc] ndpnetCtrlStartCalcMsg.sequence", ndpnetCtrlStartCalcMsg.sequence);
		appPrintLog(mLogFilePath, "[onMessageCtrlStartCalc] ndpnetCtrlStartCalcMsg.moduleModeId", ndpnetCtrlStartCalcMsg.moduleModeId);
		appPrintLog(mLogFilePath, "[onMessageCtrlStartCalc] ndpnetCtrlStartCalcMsg.calcEnv.unitId", ndpnetCtrlStartCalcMsg.calcEnv.unitId);
		appPrintLog(mLogFilePath, "[onMessageCtrlStartCalc] ndpnetCtrlStartCalcMsg.calcEnv.calcModeId", ndpnetCtrlStartCalcMsg.calcEnv.calcModeId);
		appPrintLog(mLogFilePath, "[onMessageCtrlStartCalc] ndpnetCtrlStartCalcMsg.calcEnv.workModeId", ndpnetCtrlStartCalcMsg.calcEnv.workModeId);
		appPrintLog(mLogFilePath, "[onMessageCtrlStartCalc] ndpnetCtrlStartCalcMsg.starTime", ndpnetCtrlStartCalcMsg.starTime);
		appPrintLog(mLogFilePath, "[onMessageCtrlStartCalc] ndpnetCtrlStartCalcMsg.calcTime", ndpnetCtrlStartCalcMsg.calcTime);


		'// 应答：设置应答消息并发送（ndpnet_client_response_msg）
		ndpnetClientResponseMsg.msgId = NDPNET_CTRL_START_CALC_MSG_ID;
		ndpnetClientResponseMsg.excuteResult = NDPNET_EXCUTE_OK;
		ndpnetClientResponseMsg.sequence = ndpnetCtrlStartCalcMsg.sequence;
		ndpnetClientResponseMsg.comment = "启动计算成功";

		if(mNdpnetMgr.sendClientResponseMsg() == 0) { '// 发送消息
		    appPrintLog(mLogFilePath, "[onMessageCtrlStartCalc]  sendClientResponseMsg 成功。", 1);
		}
		else {
		    appPrintLog(mLogFilePath, "[onMessageCtrlStartCalc]  sendClientResponseMsg 失败。", 1);
		}

	}


    '//结束计算
	void onMessageCtrlStopCalc()
	{
		'printf("接收到 NDPNET_CTRL_STOP_CALC_MSG_ID 消息.\n");
		'ndpnet_ctrl_stop_calc_msg * pmsg = (ndpnet_ctrl_stop_calc_msg*)(pvoid);
		'ndp_uint32 sequence = pmsg->sequence;//响应包序号
		'ndp_uint8 resFlag = pmsg->resFlag;//响应标识
		'								  //组件执行结束计算动作
        '
		'								  //根据响应标识，响应消息
		'if (resFlag == NDPNET_IMMEDIATELY_RESPONSE) {
		'	//发送指令响应消息
		'	ndpnet_client_response_msg res_msg;
		'	res_msg.msgId = NDPNET_CTRL_STOP_CALC_MSG_ID;
		'	res_msg.excuteResult = NDPNET_EXCUTE_OK;
		'	res_msg.sequence = pmsg->sequence;
		'	strcpy((char *)(res_msg.comment), "停止计算成功");
		'	ndpnet_send_client_response_msg(pmsg->handle, &res_msg);
		'}
		
		'// 解析消息：获取消息值，并使用。
		appPrintLog(mLogFilePath, "[onMessageCtrlStopCalc] 接收到 NDPNET_CTRL_STOP_CALC_MSG_ID 消息.", 1);
		appPrintLog(mLogFilePath, "[onMessageCtrlStopCalc] ndpnetCtrlStopCalcMsg.resFlag", ndpnetCtrlStopCalcMsg.resFlag);
		appPrintLog(mLogFilePath, "[onMessageCtrlStopCalc] ndpnetCtrlStopCalcMsg.sequence", ndpnetCtrlStopCalcMsg.sequence);
		appPrintLog(mLogFilePath, "[onMessageCtrlStopCalc] ndpnetCtrlStopCalcMsg.calcEnv.unitId", ndpnetCtrlStopCalcMsg.calcEnv.unitId);
		appPrintLog(mLogFilePath, "[onMessageCtrlStopCalc] ndpnetCtrlStopCalcMsg.calcEnv.calcModeId", ndpnetCtrlStopCalcMsg.calcEnv.calcModeId);
		appPrintLog(mLogFilePath, "[onMessageCtrlStopCalc] ndpnetCtrlStopCalcMsg.calcEnv.workModeId", ndpnetCtrlStopCalcMsg.calcEnv.workModeId);


		'// 应答：设置应答消息并发送（ndpnet_client_response_msg）
		ndpnetClientResponseMsg.msgId = NDPNET_CTRL_STOP_CALC_MSG_ID;
		ndpnetClientResponseMsg.excuteResult = NDPNET_EXCUTE_OK;
		ndpnetClientResponseMsg.sequence = ndpnetCtrlStopCalcMsg.sequence;
		ndpnetClientResponseMsg.comment = "停止计算成功";

		if(mNdpnetMgr.sendClientResponseMsg() == 0) { '// 发送消息
		    appPrintLog(mLogFilePath, "[onMessageCtrlStopCalc]  sendClientResponseMsg 成功。", 1);
		}
		else {
		    appPrintLog(mLogFilePath, "[onMessageCtrlStopCalc]  sendClientResponseMsg 失败。", 1);
		}
	}

    '//暂停计算
	void onMessageCtrlPauseCalc()
	{
		'printf("接收到 NDPNET_CTRL_PAUSE_CALC_MSG_ID 消息.\n");
		'ndpnet_ctrl_pause_calc_msg * pmsg = (ndpnet_ctrl_pause_calc_msg*)(pvoid);
		'ndp_uint32 sequence = pmsg->sequence;//响应包序号
		'ndp_uint8 resFlag = pmsg->resFlag;//响应标识
		'								  //组件执行暂停计算动作


		'								  //根据响应标识，响应消息
		'if (resFlag == NDPNET_IMMEDIATELY_RESPONSE) {
		'	//发送指令响应消息
		'	ndpnet_client_response_msg res_msg;
		'	res_msg.msgId = NDPNET_CTRL_PAUSE_CALC_MSG_ID;
		'	res_msg.excuteResult = NDPNET_EXCUTE_OK;
		'	res_msg.sequence = pmsg->sequence;
		'	strcpy((char *)(res_msg.comment), "暂停计算成功");
		'	ndpnet_send_client_response_msg(pmsg->handle, &res_msg);
		'}
		
		'// 解析消息：获取消息值，并使用。
		appPrintLog(mLogFilePath, "[onMessageCtrlPauseCalc] 接收到 NDPNET_CTRL_PAUSE_CALC_MSG_ID 消息.", 1);
		appPrintLog(mLogFilePath, "[onMessageCtrlPauseCalc] ndpnetCtrlPauseCalcMsg.resFlag", ndpnetCtrlPauseCalcMsg.resFlag);
		appPrintLog(mLogFilePath, "[onMessageCtrlPauseCalc] ndpnetCtrlPauseCalcMsg.sequence", ndpnetCtrlPauseCalcMsg.sequence);
		appPrintLog(mLogFilePath, "[onMessageCtrlPauseCalc] ndpnetCtrlPauseCalcMsg.calcEnv.unitId", ndpnetCtrlPauseCalcMsg.calcEnv.unitId);
		appPrintLog(mLogFilePath, "[onMessageCtrlPauseCalc] ndpnetCtrlPauseCalcMsg.calcEnv.calcModeId", ndpnetCtrlPauseCalcMsg.calcEnv.calcModeId);
		appPrintLog(mLogFilePath, "[onMessageCtrlPauseCalc] ndpnetCtrlPauseCalcMsg.calcEnv.workModeId", ndpnetCtrlPauseCalcMsg.calcEnv.workModeId);


		'// 应答：设置应答消息并发送（ndpnet_client_response_msg）
