	'// 收到主控数据的处理
	'// 参见 Ndpnet.script 中  NdpnetDataUnionMsg， NdpnetDataUnionNode, NdpnetDataUnionValue 的定义
	'// 注意：NdpnetDataUnionMsg 中声明的数据节点数为100， NdpnetDataUnionNode pnode[1000]，使用前应该初始化节点（全局初始化一次），比如只用到两个
	'//    ndpnetDataUnionMsg.pnode[0] = new NdpnetDataUnionNode;
	'//    ndpnetDataUnionMsg.pnode[1] = new NdpnetDataUnionNode;
	void onMessageDataUnion()
	{
	    'messageBox("onMessageDataUnion");
        '//响应标示
        'byte resFlag; 'ndp_uint8 resFlag;
        '//数据包序列值
        'dword sequence; 'ndp_uint32  sequence;
        '//数据参数数量
        'dword nodeNum; 'ndp_uint32 nodeNum;
        '//时间
        'dword time; 'ndp_uint32 time;
        '//数据节点首地址
        'NdpnetDataUnionNode pnode[10]; 'ndpnet_data_union_node* pnode;
        'NdpnetDataUnionMsg() {}

	    '// 解析消息：获取消息值，并使用。
		appPrintLog(mLogFilePath, "[onMessageDataUnion] 接收到 NDPNET_DATA_UNION_MSG_ID 消息.", 1);
		appPrintLog(mLogFilePath, "[onMessageDataUnion] ndpnetDataUnionMsg.resFlag", ndpnetDataUnionMsg.resFlag);
		appPrintLog(mLogFilePath, "[onMessageDataUnion] ndpnetDataUnionMsg.sequence", ndpnetDataUnionMsg.sequence);
		appPrintLog(mLogFilePath, "[onMessageDataUnion] ndpnetDataUnionMsg.nodeNum", ndpnetDataUnionMsg.nodeNum);
		appPrintLog(mLogFilePath, "[onMessageDataUnion] ndpnetDataUnionMsg.pnode[0].type", ndpnetDataUnionMsg.pnode[0].type);
		appPrintLog(mLogFilePath, "[onMessageDataUnion] ndpnetDataUnionMsg.pnode[0].id", ndpnetDataUnionMsg.pnode[0].id);
		appPrintLog(mLogFilePath, "[onMessageDataUnion] ndpnetDataUnionMsg.pnode[0].code", ndpnetDataUnionMsg.pnode[0].code);
		'// 根据 pnode[0].type 确定数据类型，如果是整型（包括 char、bool、long 等），则使用 pnode[0].value.i_value， 如果浮点型，则使用 pnode[0].value.f_value
		appPrintLog(mLogFilePath, "[onMessageDataUnion] ndpnetDataUnionMsg.pnode[0].value.i_value", ndpnetDataUnionMsg.pnode[0].value.i_value);
		appPrintLog(mLogFilePath, "[onMessageDataUnion] ndpnetDataUnionMsg.time", ndpnetDataUnionMsg.time);


		'// 应答：设置应答消息并发送（ndpnet_client_response_msg）
		ndpnetClientResponseMsg.msgId = NDPNET_DATA_UNION_MSG_ID;
		ndpnetClientResponseMsg.excuteResult = NDPNET_EXCUTE_OK;
		ndpnetClientResponseMsg.sequence = ndpnetDataUnionMsg.sequence;
		ndpnetClientResponseMsg.comment = "收到DataUnion数据包";

		if(mNdpnetMgr.sendClientResponseMsg() == 0) { '// 发送消息
		    appPrintLog(mLogFilePath, "[onMessageDataUnion]  sendClientResponseMsg 成功。", 1);
		}
		else {
		    appPrintLog(mLogFilePath, "[onMessageDataUnion]  sendClientResponseMsg 失败。", 1);
		}

	}
	
	' 消息处理
	void onMessage(int msgId)
	{
	
	    '//模块初始化,服务端设置模块ID消息
		if (msgId == NDPNET_SET_MODULE_ID_MSG_ID)   
	    {
			onMessageSetModuleId();
	    }
		'//设置计算环境消息
		elseif (msgId == NDPNET_SET_CALC_ENV_MSG_ID)
	    {
			onMessageSetCalcEnv();
		}
		'//接收到数据 ypj, 2022-10-10, sdk 2.0 新增
		elseif(msgId == NDPNET_DATA_UNION_MSG_ID)
		{
			onMessageDataUnion();
		}
		'//设置组件模式消息
		elseif(msgId == NDPNET_SET_MODULE_MODE_MSG_ID)
	    {
			onMessageSetModuleMode();
		}
		'//服务端响应包消息
		elseif(msgId == NDPNET_RESPONSE_MSG_ID)
		{
			onMessageResponse();
		}
	    '//心跳消息
		elseif(msgId == NDPNET_HEART_MSG_ID)
		{
			onMessageHeart();
		}
		'//开始计算
		elseif(msgId == NDPNET_CTRL_START_CALC_MSG_ID)
		{
			onMessageCtrlStartCalc();
		}
		'//结束计算
		elseif(msgId == NDPNET_CTRL_STOP_CALC_MSG_ID)
		{
			onMessageCtrlStopCalc();
		}
		'//暂停计算
		elseif(msgId == NDPNET_CTRL_PAUSE_CALC_MSG_ID)
		{
			onMessageCtrlPauseCalc();
		}
		'//恢复计算
		elseif(msgId == NDPNET_CTRL_RESUME_CALC_MSG_ID)
		{
			onMessageCtrlResumeCalc();
		}
		'//步进计算
		elseif(msgId == NDPNET_CTRL_STEP_CALC_MSG_ID)
		{
			onMessageCtrlStepCalc();
		}
		'//倍速计算
		elseif(msgId == NDPNET_CTRL_SPEED_CALC_MSG_ID)
		{
			onMessageCtrlSpeedCalc();
		}
		'//跳转计算
		elseif(msgId == NDPNET_CTRL_JUMP_CALC_MSG_ID)
		{
			onMessageCtrlJumpCalc();
		}
		'//时间较准计算
		elseif(msgId == NDPNET_CTRL_JUMP_CALC_MSG_ID)
		{
			onMessageCtrlVerifyCalc();
		}
	}


	} 'class NdpnetMassageListener

} ' script