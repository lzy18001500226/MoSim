8045
    , 31.5882, 10}, {118.631, 35.8812, 10}, {119, 36.60873332, 10}, {120, 38.58036832, 10}, {121, 40.55200332, 10}, {122, 42.52363832, 10}, {123, 44.49527332, 10}, {124, 46.46690832, 10}, {125, 48.43854332, 10}, {126, 50.41017832, 10}, {127, 52.38181332, 10}, {128, 54.35344832, 10}, {129, 56.32508332, 10}, {130, 58.29671832, 10}, {131, 60.26835332, 10}, {132, 62.23998832, 10}, {133, 64.21162332, 10}, {134, 66.18325832, 10}, {135, 68.15489332, 10}, {136, 70.12652832, 10}, {137, 72.09816332, 10}, {138, 74.06979832, 10}, {139, 76.04143332, 10}, {140, 78.01306832, 10}, {141.6169, 81.201, 10}, {143.7408, 85.3549, 10}, {145.8479, 89.5174, 10}, {147.9335, 93.6906, 10}, {150.0192, 97.8638, 10}, {152.0869, 102.046, 10}, {154.1348, 106.238, 10}, {156.1155, 110.4619, 10}, {157.9649, 114.7447, 10}, {159.6353, 119.1005, 10}, {161.0865, 123.5335, 10}, {162.2445, 128.0518, 10}, {163.0622, 132.6436, 10}, {163.4756, 137.2888, 10}, {163.5144, 141.9528, 10}, {163.1972, 146.6059, 10}, {162.463, 151.2108, 10}, {161.263, 155.7168, 10}, {159.6483, 160.0918, 10}, {157.6398, 164.3003, 10}, {155.2658, 168.315, 10}, {152.589, 172.1348, 10}, {149.6623, 175.7669, 10}, {146.5255, 179.2194, 10}, {143.2144, 182.5052, 10}, {139.7154, 185.5899, 10}, {135.9974, 188.4049, 10}, {132.024, 190.8453, 10}, {127.8112, 192.8436, 10}, {123.4188, 194.4092, 10}, {118.8932, 195.5321, 10}, {114.2718, 196.148, 10}, {109.61, 196.1829, 10}, {104.9604, 195.8082, 10}, {100.3264, 195.2677, 10}, {95.7048, 194.6306, 10}, {91.0998, 193.85, 10}, {86.5182, 193.0032, 10}, {81.9792, 191.9272, 10}, {77.4945, 190.6437, 10}, {73.092, 189.1022, 10}, {68.8006, 187.2746, 10}, {64.6393, 185.1674, 10}, {60.6052, 182.8254, 10}, {56.7171, 180.2482, 10}, {52.9868, 177.4477, 10}, {49.4351, 174.4236, 10}, {46.0004, 171.2662, 10}, {42.6051, 168.0665, 10}, {39.2349, 164.8405, 10}, {35.9966, 161.4833, 10}, {13.2987, 138.0831, 10}, {10.2817, 134.5247, 10}, {7.3894, 130.8644, 10}, {4.6234, 127.1078, 10}, {2.0424, 123.2219, 10}, {-0.3974, 119.2455
    , 10}, {-2.7124, 115.1952, 10}, {-4.8621, 111.0551, 10}, {-6.8041, 106.8139, 10}, {-8.5075, 102.4711, 10}, {-9.9409, 98.032, 10}, {-11.0961, 93.513, 10}, {-11.8871, 88.9172, 10}, {-12.1395, 84.2621, 10}, {-11.7983, 79.6122, 10}, {-11.1, 75.0077, 10}, {-10.4, 70.4223, 10}, {-9.7, 65.8345, 10}, {-9, 61.0299, 10}, {-8, 54.2488, 10}, {-7, 47.4677, 10}, {-6, 40.6866, 10}, {-5, 33.9055, 10}, {-4, 27.1244, 10}, {-3, 20.3433, 10}, {-2, 13.5622, 10}, {-1, 6.7811, 10}, {0, 0, 10}} "路径点数据";
  parameter Real width = 5 "路宽";
  constant Boolean is_closed = false "是否闭合道路";
  parameter Real[:,3] obs = {{5, 0, 0.11}, {15, 0, 0.11}} "障碍物数据";
  parameter Real L = 0.11 "轴距";
  parameter Real W = 0.165 "轮距";
  //中间变量
  Integer idx_f;
  Integer idx_b;
  Integer idx_l;
  Integer idx_r;
  Real e_f;
  Real e_b;
  Real e_l;
  Real e_r;
  Real proj_f[2];
  Real proj_b[2];
  Real proj_l[2];
  Real proj_r[2];
  Real Fdist;  // 前向距离（道路）
  Real Bdist;  // 后向距离（道路）
  Real Ldist;  // 左向距离（道路）
  Real Rdist;  // 右向距离（道路）
  Real distF;  // 前向距离（障碍）
  Real distB;  // 后向距离（障碍）
  Real distL;  // 左向距离（障碍）
  Real distR;  // 右向距离（障碍）
  Real vec_obsB[2];  // 最近障碍物到小车的向量,本体系
  Real fdist;  // 前向距离（修正）
  Real bdist;  // 后向距离（修正）
  Real ldist;  // 左向距离（修正）
  Real rdist;  // 右向距离（修正）
  Real vec_roadB[2];  // 最近路径点到小车的向量,本体系
  Real RoadDist; // 道路点距离
  Real vec_p[2];
  Real d;
  Integer i(start = 2, fixed = true);
  Integer iR(start = 1, fixed = true);
  //
  Modelica.Blocks.Interfaces.RealInput front_sensor[2] "前向传感位置" 
    annotation(Placement(transformation(origin = {-110, 83.3333}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealOutput front_dist "前向距离" 
    annotation(Placement(transformation(origin = {110, 83.3333}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealOutput rear_dist "后向距离" 
    annotation(Placement(transformation(origin = {110, 50}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealOutput left_dist "左侧距离" 
    annotation(Placement(transformation(origin = {110, 16.6667}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealOutput right_dist "右侧距离" 
    annotation(Placement(transformation(origin = {110, -16.6667}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealInput rear_sensor[2] "后向传感位置" 
    annotation(Placement(transformation(origin = {-110, 50}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealInput left_sensor[2] "左侧传感位置" 
    annotation(Placement(transformation(origin = {-110, 16.6667}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealInput right_sensor[2] "右侧传感位置" 
    annotation(Placement(transformation(origin = {-110, -16.6667}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealInput vehicle_position[2] "小车位置" 
    annotation(Placement(transformation(origin = {-110, -50}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealInput yaw "偏航角" 
    annotation(Placement(transformation(origin = {-110, -83.3333}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealOutput DisRoad "距离道路" 
    annotation(Placement(transformation(origin = {110, -50}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealOutput DisObstacle "距离障碍" 
    annotation(Placement(transformation(origin = {110, -83.3333}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
algorithm
  // 道路距离计算
  (Fdist,idx_f,e_f,proj_f) := UGV.Vehicle.Sensors.Internal.calcLateralDistance(front_sensor, road, width);
  (Bdist,idx_b,e_b,proj_b) := UGV.Vehicle.Sensors.Internal.calcLateralDistance(rear_sensor, road, width);
  (Ldist,idx_l,e_l,proj_l) := UGV.Vehicle.Sensors.Internal.calcLateralDistance(left_sensor, road, width);
  (Rdist,idx_r,e_r,proj_r) := UGV.Vehicle.Sensors.Internal.calcLateralDistance(right_sensor, road, width);
  // 障碍物距离计算
  (distF,distB,distL,distR,vec_obsB) := UGV.Vehicle.Sensors.Internal.calcObsDistance(vehicle_position, obs, yaw);
  // 道路点距离计算
  (RoadDist,bdist,ldist,rdist,vec_roadB) := UGV.Vehicle.Sensors.Internal.calcObsDistance(vehicle_position, road, yaw);
  // 道路点索引
  when RoadDist <= 0 then
    iR := iR + 1;
  end when;
  if iR >= size(road, 1) then
    iR := size(road, 1);
  end if;
  // 前向距离修正
  when distF <= 0 then
    i := i + 1;
  end when;
  if i >= size(road, 1) then
    i := size(road, 1);
  end if;
  //fdist := UGV.Vehicle.Sensors.Internal.calcDistance(vehicle_position, road[i,:], yaw);
  // 距离判断选择
  if vec_obsB[1] >= -L / 2 and vec_obsB[1] <= L / 2 then
    left_dist := distL;
    right_dist := distR;
  else
    left_dist := Ldist;
    right_dist := Rdist;
  end if;

  if vec_obsB[2] >= -W / 2 - 0.01 and vec_obsB[2] <= W / 2 + 0.01 then
    front_dist := distF;
    rear_dist := distB;
  else
    front_dist := fdist;
    rear_dist := Bdist;
  end if;

  // front_dist = distF;
  // rear_dist = distB;
  DisRoad := min(Ldist, Rdist);//与道路两侧距离
  DisObstacle := sqrt(vec_obsB[1] ^ 2 + vec_obsB[2] ^ 2);//与障碍物距离
  vec_p := UGV.Vehicle.Sensors.Internal.findPoint(vehicle_position[1],vehicle_position[2],0,0,yaw);//小车与原点向量
  d := vec_p[1]^2 + vec_p[2]^2;//小车与原点平方距离
  assert(d >= 0.02 or time <= 10, "已跑完赛道全程，仿真结束");
  //assert(iR <> size(road, 1), "已跑完赛道全程，仿真结束");
end distanceSensor1;