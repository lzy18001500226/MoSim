package Driver "驱动装置"
  annotation(__MWORKS(version="2025a"),Protection(access=Access.diagram));
  model wheelD "车轮驱动装置"
    annotation(__MWORKS(version="2025a"),Icon(coordinateSystem(extent={{-100,-100},{100,100}}, 
grid={2,2}),graphics = {Bitmap(origin={0,-7.10543e-15}, 
extent={{-97,-83},{97,83}}, 
fileName="modelica://UGV/Resources/Images/%E7%94%B5%E6%9C%BA%E9%A9%B1%E5%8A%A8.png", 
imageSource=""
)}),Protection(access=Access.diagram));
  extends UGV.Utilities.Icons.Model1;
    Modelica.Mechanics.Rotational.Sources.Speed speed 
      annotation (Placement(transformation(origin={0,0}, 
extent={{-10,-10},{10,10}})));
    Modelica.Mechanics.Rotational.Interfaces.Flange_b flange "Flange of shaft" 
      annotation (Placement(transformation(origin={100,0}, 
extent={{-10,-10},{10,10}})));
    Modelica.Blocks.Interfaces.RealInput w_ref "Reference angular velocity of flange with respect to support as input signal" 
      annotation (Placement(transformation(origin={-110,-1.77636e-15}, 
extent={{-10,-10},{10,10}})));
  equation
    connect(speed.flange, flange) 
    annotation(Line(origin={55,0}, 
    points={{-45,0},{45,0}}, 
    color={0,0,0}));
    connect(speed.w_ref, w_ref) 
    annotation(Line(origin={-56,0}, 
points={{44,0},{-64,-1.55431e-15}}, 
color={0,0,127}));

  end wheelD;
  end Driver;