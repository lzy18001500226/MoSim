package joystick "驾驶杆外设"
  annotation(__MWORKS(version="2025a"));
  model joystick "驾驶杆-待接入"
    annotation(__MWORKS(version="2025a"),Diagram(coordinateSystem(extent={{-100,-100},{100,100}}, 
grid={2,2})),Icon(coordinateSystem(extent={{-100,-100},{100,100}}, 
grid={2,2}),graphics = {Bitmap(origin={9,3}, 
extent={{-69,-67},{69,67}}, 
fileName="modelica://USV/Resources/images/joystick.png", 
imageSource=""
)}));
  extends USV.Utilities.Icons.Model;
    Modelica.Blocks.Sources.CombiTimeTable combiTimeTable(table = {{0.0, 0}, {1, 5}, {5, 50}, {10, 80}, {20, 80}}) 
      annotation(Placement(transformation(origin={-20,42}, 
extent={{-10,-10},{10,10}})));
    Modelica.Blocks.Sources.CombiTimeTable combiTimeTable1(table = {{0.0, 100}, {1, 45}, {5, 80}, {10, 100}, {20, 100}}) 
      annotation(Placement(transformation(origin={-20,-28}, 
extent={{-10,-10},{10,10}})));
    Modelica.Blocks.Interfaces.RealOutput Throttle 
      annotation(Placement(transformation(origin={110,42}, 
extent={{-10,-10},{10,10}}), 
iconTransformation(origin={0,0})));
    Modelica.Blocks.Interfaces.RealOutput Rudder 
      annotation(Placement(transformation(origin={110,-28}, 
extent={{-10,-10},{10,10}}), 
iconTransformation(origin={0,0})));
  equation
    connect(combiTimeTable1.y[1], Rudder) 
    annotation(Line(origin={51,-28}, 
    points={{-60,0},{59,-3.55271e-15}}, 
    color={0,0,127}));
    connect(combiTimeTable.y[1], Throttle) 
    annotation(Line(origin={51,42}, 
    points={{-60,0},{59,0}}, 
    color={0,0,127}));
  end joystick;

end joystick;