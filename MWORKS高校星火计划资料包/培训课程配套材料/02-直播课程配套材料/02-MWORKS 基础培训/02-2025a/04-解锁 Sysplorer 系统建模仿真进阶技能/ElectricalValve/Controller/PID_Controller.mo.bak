model PID_Controller "PID控制器"
  annotation(__MWORKS,Diagram(coordinateSystem(extent={{-100,-100},{100,100}}, 
grid={2,2})));
  Modelica.Blocks.Continuous.Integrator integrator 
    annotation (Placement(transformation(origin={-34,-4}, 
extent={{-10,-10},{10,10}})));
  Modelica.Blocks.Continuous.Derivative derivative 
    annotation (Placement(transformation(origin={-34,-38}, 
extent={{-10,-10},{10,10}})));
  Modelica.Blocks.Math.Gain gain 
    annotation (Placement(transformation(origin={-34,30}, 
extent={{-10,-10},{10,10}})));
  Modelica.Blocks.Math.Gain gain1 
    annotation (Placement(transformation(origin={-76,-4}, 
extent={{-10,-10},{10,10}})));
  Modelica.Blocks.Math.Gain gain2 
    annotation (Placement(transformation(origin={-76,-38}, 
extent={{-10,-10},{10,10}})));
  Modelica.Blocks.Math.Add3 add3_1 
    annotation (Placement(transformation(origin={8,-4}, 
extent={{-10,-10},{10,10}})));
  Modelica.Blocks.Interfaces.RealInput u "Input signal connector" 
    annotation (Placement(transformation(origin={-146,-4}, 
extent={{-20,-20},{20,20}})));
  Modelica.Blocks.Interfaces.RealOutput y "Connector of Real output signal" 
    annotation (Placement(transformation(origin={42,-4}, 
extent={{-10,-10},{10,10}})));
equation
  connect(integrator.y, add3_1.u2) 
  annotation(Line(origin={-13,-4}, 
  points={{-10,-3.55271e-15},{9,-3.55271e-15}}, 
  color={0,0,127}));
  connect(add3_1.u3, derivative.y) 
  annotation(Line(origin={-13,-25}, 
  points={{9,13},{1,13},{1,-13},{-10,-13}}, 
  color={0,0,127}));
  connect(add3_1.u1, gain.y) 
  annotation(Line(origin={-13,17}, 
points={{9,-13},{1,-13},{1,13},{-10,13}}, 
color={0,0,127}));
  connect(gain1.y, integrator.u) 
  annotation(Line(origin={-55,-4}, 
  points={{-10,-3.55271e-15},{9,-3.55271e-15}}, 
  color={0,0,127}));
  connect(gain2.y, derivative.u) 
  annotation(Line(origin={-55,-38}, 
  points={{-10,0},{9,0}}, 
  color={0,0,127}));
  connect(gain1.u, u) 
  annotation(Line(origin={-117,-4}, 
  points={{29,-3.55271e-15},{-29,-3.55271e-15}}, 
  color={0,0,127}));
  connect(gain.u, u) 
  annotation(Line(origin={-96,13}, 
  points={{50,17},{-16,17},{-16,-17},{-50,-17}}, 
  color={0,0,127}));
  connect(gain2.u, u) 
  annotation(Line(origin={-117,-21}, 
  points={{29,-17},{5,-17},{5,17},{-29,17}}, 
  color={0,0,127}));
  connect(add3_1.y, y) 
  annotation(Line(origin={31,-4}, 
  points={{-12,-3.55271e-15},{11,-3.55271e-15}}, 
  color={0,0,127}));
  end PID_Controller;