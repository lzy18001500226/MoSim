model MoSim_P7_FDI_FTC_FAMILY_GRAPHICAL_MIL "P7 FDI/FTC family: residual, estimation, isolation and reconfiguration"
  extends ModelWorkspace;
  import SysplorerEmbeddedCoder.Types.*;
  import BaseWorkspace.*;
