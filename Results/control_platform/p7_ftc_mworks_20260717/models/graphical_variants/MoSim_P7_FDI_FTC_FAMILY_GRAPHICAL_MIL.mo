  SysplorerEmbeddedCoder.MathOperation.Sum reconfigured_motor_command(inputs="++") annotation(Placement(transformation(origin={650,120},extent={{-18,-14},{18,14}})),__MWORKS(BlockSystem(Instance(u(u1,u2)))));
  SysplorerEmbeddedCoder.Discontinuities.Saturation actuator_command_limit(lowLimit=0.0,upLimit=1.0) annotation(Placement(transformation(origin={770,120},extent={{-18,-14},{18,14}})));
  SysplorerEmbeddedCoder.MathOperation.Gain degraded_action_selection(k=2.0) annotation(Placement(transformation(origin={650,-55},extent={{-18,-14},{18,14}})));
  SysplorerEmbeddedCoder.Port.Outport motor_command_1 annotation(Placement(transformation(origin={900,120},extent={{-18,-14},{18,14}})));
  SysplorerEmbeddedCoder.Port.Outport eta_hat_1 annotation(Placement(transformation(origin={900,20},extent={{-18,-14},{18,14}})));
