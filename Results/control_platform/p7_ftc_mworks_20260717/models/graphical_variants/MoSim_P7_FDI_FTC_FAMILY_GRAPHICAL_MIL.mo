  SysplorerEmbeddedCoder.MathOperation.Gain residual_to_effectiveness(k=-1.6666666667) annotation(Placement(transformation(origin={-150,70},extent={{-18,-14},{18,14}})));
  SysplorerEmbeddedCoder.MathOperation.Sum effectiveness_update(inputs="++") annotation(Placement(transformation(origin={-40,20},extent={{-18,-14},{18,14}})),__MWORKS(BlockSystem(Instance(u(u1,u2)))));
