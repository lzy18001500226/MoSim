  SysplorerEmbeddedCoder.Discrete.UnitDelay persistent_effectiveness_state(initCond=1.0) annotation(Placement(transformation(origin={200,20},extent={{-18,-14},{18,14}})));
  SysplorerEmbeddedCoder.MathOperation.Sum fault_score(inputs="+-") annotation(Placement(transformation(origin={310,-55},extent={{-18,-14},{18,14}})),__MWORKS(BlockSystem(Instance(u(u1,u2)))));
  SysplorerEmbeddedCoder.MathOperation.Gain fault_isolation_gain(k=2.0) annotation(Placement(transformation(origin={420,-55},extent={{-18,-14},{18,14}})));
  SysplorerEmbeddedCoder.Discontinuities.Saturation isolated_fault_score(lowLimit=0.0,upLimit=1.0) annotation(Placement(transformation(origin={530,-55},extent={{-18,-14},{18,14}})));
