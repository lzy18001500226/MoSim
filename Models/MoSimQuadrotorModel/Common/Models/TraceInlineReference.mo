    annotation(Placement(transformation(origin = {100, 40}, extent = {{-10, -10}, {10, 10}})));
  Modelica.Blocks.Interfaces.RealOutput z_ref_rate
    annotation(Placement(transformation(origin = {100, 0}, extent = {{-10, -10}, {10, 10}})));
