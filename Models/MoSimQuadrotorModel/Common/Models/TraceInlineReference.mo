    annotation(Placement(transformation(origin = {100, -40}, extent = {{-10, -10}, {10, 10}})));

protected
  function traceLookup
    input Real data[:, :];
    input Real query_time;
    input Integer column;
    output Real y;
  protected
    Real t0;
    Real t1;
    Real ratio;
    Boolean found;
    Integer row_count;
  algorithm
    row_count := size(data, 1);
    y := data[1, column];
    found := false;
    if query_time <= data[1, 1] then
      y := data[1, column];
      found := true;
    end if;
    for i in 1:226 loop
      if not found and i < row_count then
        t0 := data[i, 1];
        t1 := data[i + 1, 1];
        if query_time <= t1 then
          ratio := if t1 > t0 then (query_time - t0) / (t1 - t0) else 0.0;
          y := data[i, column] + ratio * (data[i + 1, column] - data[i, column]);
          found := true;
        end if;
      end if;
    end for;
    if not found then
      y := data[row_count, column];
    end if;
  end traceLookup;

equation
  position_command[1] = traceLookup(traceData, time, 2);
  position_command[2] = traceLookup(traceData, time, 3);
  position_command[3] = traceLookup(traceData, time, 4);
  yaw_ref = traceLookup(traceData, time, 5);
  z_ref_rate = traceLookup(traceData, time, 6);

  annotation(Diagram(coordinateSystem(extent = {{-120, -80}, {120, 80}})));
  annotation(__MWORKS(hide=true,version="26.3.0"));
end TraceInlineReference;