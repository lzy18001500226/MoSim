<launch>
  <arg name="uav_num" default="3"/>
  <arg name="target1_x" default="4.0"/>
  <arg name="target1_y" default="-1.0"/>
  <arg name="target1_z" default="1.0"/>
  <arg name="target2_x" default="4.0"/>
  <arg name="target2_y" default="1.0"/>
  <arg name="target2_z" default="1.0"/>
  <arg name="target3_x" default="4.0"/>
  <arg name="target3_y" default="0.0"/>
  <arg name="target3_z" default="1.0"/>
  <arg name="max_vel" default="0.8"/>
  <arg name="max_acc" default="0.8"/>
  <arg name="max_jer" default="4.0"/>
  <arg name="planning_horizon" default="5.0"/>
  <arg name="grid_resolution" default="0.12"/>
  <arg name="obstacles_inflation" default="0.20"/>
  <arg name="obstacle_clearance" default="0.20"/>
  <arg name="obstacle_clearance_soft" default="0.40"/>
  <arg name="virtual_ceil_height" default="1.15"/>
  <arg name="virtual_ground_height" default="0.05"/>
  <arg name="visualization_truncate_height" default="1.25"/>
  <arg name="enable_virtual_wall" default="true"/>
  <arg name="cloud_enable_raycast" default="true"/>
  <arg name="grid_init_x" default="0.0"/>
  <arg name="grid_init_y" default="0.0"/>
  <arg name="grid_init_z" default="0.0"/>
  <arg name="map_size_x" default="40.0"/>
  <arg name="map_size_y" default="40.0"/>
  <arg name="map_size_z" default="2.5"/>
  <arg name="local_update_range_x" default="5.5"/>
  <arg name="local_update_range_y" default="5.5"/>
  <arg name="local_update_range_z" default="2.0"/>
  <arg name="use_multipoint" default="false"/>
  <arg name="flight_type" default="1"/>

  <include file="$(env PROJECT_ROOT)/Scripts/sunray/diff_planner_single_px4ctrl_goal4.launch">
    <arg name="drone_id" value="0"/>
    <arg name="target_x" value="$(arg target1_x)"/>
    <arg name="target_y" value="$(arg target1_y)"/>
    <arg name="target_z" value="$(arg target1_z)"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="max_jer" value="$(arg max_jer)"/>
    <arg name="planning_horizon" value="$(arg planning_horizon)"/>
    <arg name="grid_resolution" value="$(arg grid_resolution)"/>
    <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
    <arg name="obstacle_clearance" value="$(arg obstacle_clearance)"/>
    <arg name="obstacle_clearance_soft" value="$(arg obstacle_clearance_soft)"/>
    <arg name="virtual_ceil_height" value="$(arg virtual_ceil_height)"/>
    <arg name="virtual_ground_height" value="$(arg virtual_ground_height)"/>
    <arg name="visualization_truncate_height" value="$(arg visualization_truncate_height)"/>
    <arg name="enable_virtual_wall" value="$(arg enable_virtual_wall)"/>
    <arg name="cloud_enable_raycast" value="$(arg cloud_enable_raycast)"/>
    <arg name="grid_init_x" value="$(arg grid_init_x)"/>
    <arg name="grid_init_y" value="$(arg grid_init_y)"/>
    <arg name="grid_init_z" value="$(arg grid_init_z)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="local_update_range_x" value="$(arg local_update_range_x)"/>
    <arg name="local_update_range_y" value="$(arg local_update_range_y)"/>
    <arg name="local_update_range_z" value="$(arg local_update_range_z)"/>
    <arg name="odom_topic" value="/uav1/mavros/local_position/odom"/>
    <arg name="global_pointcloud_topic" value="/uav1/livox_world"/>
    <arg name="position_cmd_topic" value="/uav1/planner_position_cmd_raw"/>
    <arg name="goal_topic" value="/uav1/goal_with_id"/>
    <arg name="use_multipoint" value="$(arg use_multipoint)"/>
    <arg name="flight_type" value="$(arg flight_type)"/>
  </include>

  <group if="$(eval int(arg('uav_num')) >= 2)">
    <include file="$(env PROJECT_ROOT)/Scripts/sunray/diff_planner_single_px4ctrl_goal4.launch">
      <arg name="drone_id" value="1"/>
      <arg name="target_x" value="$(arg target2_x)"/>
      <arg name="target_y" value="$(arg target2_y)"/>
      <arg name="target_z" value="$(arg target2_z)"/>
      <arg name="max_vel" value="$(arg max_vel)"/>
      <arg name="max_acc" value="$(arg max_acc)"/>
      <arg name="max_jer" value="$(arg max_jer)"/>
      <arg name="planning_horizon" value="$(arg planning_horizon)"/>
      <arg name="grid_resolution" value="$(arg grid_resolution)"/>
      <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
      <arg name="obstacle_clearance" value="$(arg obstacle_clearance)"/>
      <arg name="obstacle_clearance_soft" value="$(arg obstacle_clearance_soft)"/>
      <arg name="virtual_ceil_height" value="$(arg virtual_ceil_height)"/>
      <arg name="virtual_ground_height" value="$(arg virtual_ground_height)"/>
      <arg name="visualization_truncate_height" value="$(arg visualization_truncate_height)"/>
      <arg name="enable_virtual_wall" value="$(arg enable_virtual_wall)"/>
      <arg name="cloud_enable_raycast" value="$(arg cloud_enable_raycast)"/>
      <arg name="grid_init_x" value="$(arg grid_init_x)"/>
      <arg name="grid_init_y" value="$(arg grid_init_y)"/>
      <arg name="grid_init_z" value="$(arg grid_init_z)"/>
      <arg name="map_size_x" value="$(arg map_size_x)"/>
      <arg name="map_size_y" value="$(arg map_size_y)"/>
      <arg name="map_size_z" value="$(arg map_size_z)"/>
      <arg name="local_update_range_x" value="$(arg local_update_range_x)"/>
      <arg name="local_update_range_y" value="$(arg local_update_range_y)"/>
      <arg name="local_update_range_z" value="$(arg local_update_range_z)"/>
      <arg name="odom_topic" value="/uav2/mavros/local_position/odom"/>
      <arg name="global_pointcloud_topic" value="/uav2/livox_world"/>
      <arg name="position_cmd_topic" value="/uav2/planner_position_cmd_raw"/>
      <arg name="goal_topic" value="/uav2/goal_with_id"/>
      <arg name="use_multipoint" value="$(arg use_multipoint)"/>
      <arg name="flight_type" value="$(arg flight_type)"/>
    </include>
  </group>

  <group if="$(eval int(arg('uav_num')) >= 3)">
    <include file="$(env PROJECT_ROOT)/Scripts/sunray/diff_planner_single_px4ctrl_goal4.launch">
      <arg name="drone_id" value="2"/>
      <arg name="target_x" value="$(arg target3_x)"/>
      <arg name="target_y" value="$(arg target3_y)"/>
      <arg name="target_z" value="$(arg target3_z)"/>
      <arg name="max_vel" value="$(arg max_vel)"/>
      <arg name="max_acc" value="$(arg max_acc)"/>
      <arg name="max_jer" value="$(arg max_jer)"/>
      <arg name="planning_horizon" value="$(arg planning_horizon)"/>
      <arg name="grid_resolution" value="$(arg grid_resolution)"/>
      <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
      <arg name="obstacle_clearance" value="$(arg obstacle_clearance)"/>
      <arg name="obstacle_clearance_soft" value="$(arg obstacle_clearance_soft)"/>
      <arg name="virtual_ceil_height" value="$(arg virtual_ceil_height)"/>
      <arg name="virtual_ground_height" value="$(arg virtual_ground_height)"/>
      <arg name="visualization_truncate_height" value="$(arg visualization_truncate_height)"/>
      <arg name="enable_virtual_wall" value="$(arg enable_virtual_wall)"/>
      <arg name="cloud_enable_raycast" value="$(arg cloud_enable_raycast)"/>
      <arg name="grid_init_x" value="$(arg grid_init_x)"/>
      <arg name="grid_init_y" value="$(arg grid_init_y)"/>
      <arg name="grid_init_z" value="$(arg grid_init_z)"/>
      <arg name="map_size_x" value="$(arg map_size_x)"/>
      <arg name="map_size_y" value="$(arg map_size_y)"/>
      <arg name="map_size_z" value="$(arg map_size_z)"/>
      <arg name="local_update_range_x" value="$(arg local_update_range_x)"/>
      <arg name="local_update_range_y" value="$(arg local_update_range_y)"/>
      <arg name="local_update_range_z" value="$(arg local_update_range_z)"/>
      <arg name="odom_topic" value="/uav3/mavros/local_position/odom"/>
      <arg name="global_pointcloud_topic" value="/uav3/livox_world"/>
      <arg name="position_cmd_topic" value="/uav3/planner_position_cmd_raw"/>
      <arg name="goal_topic" value="/uav3/goal_with_id"/>
      <arg name="use_multipoint" value="$(arg use_multipoint)"/>
      <arg name="flight_type" value="$(arg flight_type)"/>
    </include>
  </group>
</launch>
