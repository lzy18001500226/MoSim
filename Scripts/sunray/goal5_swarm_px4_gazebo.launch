<?xml version="1.0"?>
<launch>
  <arg name="uav_num" default="2"/>
  <arg name="vehicle" default="sunray150_with_mid360"/>
  <arg name="world" default="$(find sunray_simulator)/worlds/planning_test.world"/>
  <arg name="gazebo_enable" default="true"/>
  <arg name="gui" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="verbose" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>

  <arg name="uav1_init_x" default="0.0"/>
  <arg name="uav1_init_y" default="-1.0"/>
  <arg name="uav1_init_z" default="0.2"/>
  <arg name="uav1_init_yaw" default="0.0"/>
  <arg name="uav2_init_x" default="0.0"/>
  <arg name="uav2_init_y" default="1.0"/>
  <arg name="uav2_init_z" default="0.2"/>
  <arg name="uav2_init_yaw" default="0.0"/>
  <arg name="uav3_init_x" default="-1.5"/>
  <arg name="uav3_init_y" default="0.0"/>
  <arg name="uav3_init_z" default="0.2"/>
  <arg name="uav3_init_yaw" default="0.0"/>

  <group if="$(arg gazebo_enable)">
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="gui" value="$(arg gui)"/>
      <arg name="world_name" value="$(arg world)"/>
      <arg name="debug" value="$(arg debug)"/>
      <arg name="verbose" value="$(arg verbose)"/>
      <arg name="paused" value="$(arg paused)"/>
      <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    </include>
  </group>

  <include file="$(find sunray_simulator)/launch_basic/sunray_px4_basic.launch">
    <arg name="uav_id" value="1"/>
    <arg name="vehicle" value="$(arg vehicle)"/>
    <arg name="uav_init_x" value="$(arg uav1_init_x)"/>
    <arg name="uav_init_y" value="$(arg uav1_init_y)"/>
    <arg name="uav_init_z" value="$(arg uav1_init_z)"/>
    <arg name="uav_init_yaw" value="$(arg uav1_init_yaw)"/>
  </include>

  <group if="$(eval int(arg('uav_num')) >= 2)">
    <include file="$(find sunray_simulator)/launch_basic/sunray_px4_basic.launch">
      <arg name="uav_id" value="2"/>
      <arg name="vehicle" value="$(arg vehicle)"/>
      <arg name="uav_init_x" value="$(arg uav2_init_x)"/>
      <arg name="uav_init_y" value="$(arg uav2_init_y)"/>
      <arg name="uav_init_z" value="$(arg uav2_init_z)"/>
      <arg name="uav_init_yaw" value="$(arg uav2_init_yaw)"/>
    </include>
  </group>

  <group if="$(eval int(arg('uav_num')) >= 3)">
    <include file="$(find sunray_simulator)/launch_basic/sunray_px4_basic.launch">
      <arg name="uav_id" value="3"/>
      <arg name="vehicle" value="$(arg vehicle)"/>
      <arg name="uav_init_x" value="$(arg uav3_init_x)"/>
      <arg name="uav_init_y" value="$(arg uav3_init_y)"/>
      <arg name="uav_init_z" value="$(arg uav3_init_z)"/>
      <arg name="uav_init_yaw" value="$(arg uav3_init_yaw)"/>
    </include>
  </group>
</launch>
