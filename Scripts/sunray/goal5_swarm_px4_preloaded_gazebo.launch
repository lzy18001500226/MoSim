<?xml version="1.0"?>
<launch>
  <arg name="uav_num" default="2"/>
  <arg name="vehicle" default="sunray150_with_mid360"/>
  <arg name="world" default="$(find sunray_simulator)/worlds/planning_test.world"/>
  <arg name="gazebo_enable" default="true"/>
  <arg name="gui" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="verbose" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="uav1_init_x" default="0.0"/>
  <arg name="uav1_init_y" default="-1.0"/>
  <arg name="uav2_init_x" default="0.0"/>
  <arg name="uav2_init_y" default="1.0"/>
  <arg name="uav3_init_x" default="-1.5"/>
  <arg name="uav3_init_y" default="0.0"/>

  <group if="$(arg gazebo_enable)">
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="gui" value="$(arg gui)"/>
      <arg name="world_name" value="$(arg world)"/>
      <arg name="debug" value="$(arg debug)"/>
      <arg name="verbose" value="$(arg verbose)"/>
      <arg name="paused" value="$(arg paused)"/>
      <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    </include>
  </group>

  <include file="$(env PROJECT_ROOT)/Scripts/sunray/goal5_px4_mavros_no_spawn.launch">
    <arg name="uav_id" value="1"/>
    <arg name="vehicle" value="$(arg vehicle)"/>
  </include>

  <group if="$(eval int(arg('uav_num')) >= 2)">
    <include file="$(env PROJECT_ROOT)/Scripts/sunray/goal5_px4_mavros_no_spawn.launch">
      <arg name="uav_id" value="2"/>
      <arg name="vehicle" value="$(arg vehicle)"/>
    </include>
  </group>

  <group if="$(eval int(arg('uav_num')) >= 3)">
    <include file="$(env PROJECT_ROOT)/Scripts/sunray/goal5_px4_mavros_no_spawn.launch">
      <arg name="uav_id" value="3"/>
      <arg name="vehicle" value="$(arg vehicle)"/>
    </include>
  </group>
</launch>
