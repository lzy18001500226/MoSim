+
+bool FastPlannerManager::enforceDynamicFeasibility(
+    NonUniformBspline& trajectory, const char* source) {
+  if (!pp_.enforce_dynamic_feasibility_) return true;
+  if (pp_.max_vel_ <= 0.0 || pp_.max_acc_ <= 0.0) {
+    ROS_ERROR("[FUEL_DYN_FEAS] Invalid limits: max_vel=%.3f max_acc=%.3f",
+        pp_.max_vel_, pp_.max_acc_);
+    return false;
+  }
+
+  trajectory.setPhysicalLimits(pp_.max_vel_, pp_.max_acc_);
+  const double duration_before = trajectory.getTimeSum();
+  const double ratio_before = trajectory.checkRatio();
+  if (!std::isfinite(ratio_before) || ratio_before <= 0.0) {
+    ROS_ERROR("[FUEL_DYN_FEAS] %s produced invalid ratio %.6f", source, ratio_before);
+    return false;
+  }
+
+  if (ratio_before > 1.0) trajectory.lengthenTime(ratio_before * 1.01);
+  bool feasible = trajectory.checkFeasibility(false);
+  int iterations = 0;
+  const int max_iterations = std::max(0, pp_.dynamic_feasibility_max_iterations_);
+  while (!feasible && iterations < max_iterations && ros::ok()) {
+    trajectory.reallocateTime(false);
+    feasible = trajectory.checkFeasibility(false);
+    ++iterations;
+  }
+
+  const double ratio_after = trajectory.checkRatio();
+  const double duration_after = trajectory.getTimeSum();
+  ROS_WARN("[FUEL_DYN_FEAS] source=%s feasible=%d ratio_before=%.6f "
+           "ratio_after=%.6f duration_before=%.6f duration_after=%.6f iterations=%d",
+      source, feasible, ratio_before, ratio_after, duration_before, duration_after, iterations);
+  if (!feasible) trajectory.checkFeasibility(true);
+  return feasible;
+}
