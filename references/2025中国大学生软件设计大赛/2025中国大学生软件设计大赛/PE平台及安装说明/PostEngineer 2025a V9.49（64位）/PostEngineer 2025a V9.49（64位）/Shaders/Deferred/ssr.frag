#version 330 corelayout (location = 0) out vec4 gMainColor;uniform sampler2D gPositionDepth;//uniform sampler2D gPositionDepthBack;uniform sampler2D gNormal;//uniform sampler2D gNormalMap;uniform sampler2D gScene;uniform sampler2D gSpecular;uniform sampler2D gMaterial;uniform sampler2D gDiffuse;uniform sampler2D pbrBRDFMap;uniform vec3 gCameraPos;uniform mat4 gModelView;uniform mat4 gProjection;uniform vec3 gVertical;uniform mat4 cameraConvertMatrix;//uniform float fogDensity;//uniform float fogHeight;uniform vec3 fogParam;uniform vec3 fogColor;float CalcFogBlend(vec3 worldP){	float fogBlend = 1.0;	const float EPSON = 0.0000001;	float fogDensity = fogParam.x;	float fogHeight = fogParam.y;	int fogAtten = int(fogParam.z + 0.001);	if(fogDensity > EPSON){		//全部转换到世界坐标系下		vec3 worldP0 = (cameraConvertMatrix * vec4(worldP, 1.0)).xyz;		vec3 gCameraPos0 = (cameraConvertMatrix * vec4(gCameraPos, 1.0)).xyz; 		vec3 view_vec = worldP0 - gCameraPos0;		vec3 viewDir = normalize(view_vec);		vec3 gVertical0 = vec3(0, 1, 0);		float dis_in_fog = length(view_vec);		if( fogHeight > EPSON){			float H0 = dot(gCameraPos0, gVertical0);			float H1 = dot(worldP0, gVertical0);			float h0 = H0 - fogHeight;			float h1 = H1 - fogHeight;			if(h0 <= 0 && h1 >= 0) dis_in_fog *= -h0/(-h0+h1);			else if(h0 >= 0 && h1 <= 0) dis_in_fog *= -h1/(h0-h1);			else if(h0 >= 0 && h1 >= 0) dis_in_fog = 0.0;		}		float density = fogDensity;		vec3 up = gVertical0;		density *= max(1.0 - dot(up, viewDir), 0);        		if(fogAtten == 0){			float maxDis = log(5.0) / density;			fogBlend = clamp( 1.0 - dis_in_fog/maxDis , 0, 1);		}		else if(fogAtten == 1)			fogBlend = clamp(exp(-density * dis_in_fog ), 0, 1);		else{			float ind = pow(density * dis_in_fog, 2);			fogBlend = clamp(exp(-ind ), 0, 1);		}		/*if( fogHeight > EPSON){			//float H = dot(worldP - vec3(0), gVertical);			float factor = 1.0 - min( max( H - fogHeight, 0) / (fogHeight*5), 1.0);			fogBlend = fogBlend*factor + 1.0*(1 - factor);		}*/   	 }	return fogBlend;}uniform vec2 jitter;uniform int maxIterNum;uniform float maxTraceDis;varying vec2 vUv;float gauss[] = float[](    0.00000067, 0.00002292, 0.00019117, 0.00038771, 0.00019117, 0.00002292, 0.00000067,    0.00002292, 0.00078633, 0.00655965, 0.01330373, 0.00655965, 0.00078633, 0.00002292,    0.00019117, 0.00655965, 0.05472157, 0.11098164, 0.05472157, 0.00655965, 0.00019117,    0.00038771, 0.01330373, 0.11098164, 0.22508352, 0.11098164, 0.01330373, 0.00038771,    0.00019117, 0.00655965, 0.05472157, 0.11098164, 0.05472157, 0.00655965, 0.00019117,    0.00002292, 0.00078633, 0.00655965, 0.01330373, 0.00655965, 0.00078633, 0.00002292,    0.00000067, 0.00002292, 0.00019117, 0.00038771, 0.00019117, 0.00002292, 0.00000067);vec3 GetGaussColor(sampler2D Color, vec2 uv){    const int size = 7;    vec3 finalColor = vec3(0,0,0);        vec2 texSize = textureSize(Color, 0);    int idx = 0;    for(int i = -3;i <= 3;i++)    {        for(int j = -3; j <= 3;j++)        {            vec2 offset_uv = uv + vec2(5.0 * i /texSize.x, 5.0 * j /texSize.y);            vec3 color = texture2D(Color, offset_uv).xyz;            float weight = gauss[idx++];            finalColor = finalColor + weight * color;        }    }    return finalColor;}vec2 NormalizedDeviceCoordToScreenCoord(vec2 ndc, vec2 screenSize){	vec2 screenCoord;	screenCoord.x = screenSize.x * (0.5 * ndc.x + 0.5);	screenCoord.y = screenSize.y * (-0.5 * ndc.y + 0.5);	return screenCoord;}float distanceSquared(vec2 a, vec2 b){	a -= b;	return dot(a, a);}vec2 GetJitterUV(vec2 uv){	return uv + jitter / 2;}void main() {		vec2 screenSize = textureSize(gPositionDepth, 0);		///变换到抖动的屏幕空间	vec2 jitUv = vUv;//GetJitterUV(vUv);			vec3 worldN = texture(gNormal, jitUv).xyz;	vec3 worldP = texture(gPositionDepth, jitUv).xyz; 			gMainColor.rgb = vec3(0.0);	gMainColor.a = 0.0;			if(length(worldN) < 1e-6) return;		vec3 CP = gCameraPos - worldP;	float cameraDis = length(CP);		if( cameraDis > maxTraceDis*10 ) return;		vec3 V = normalize(CP);	float ndv = dot(V, worldN);	if (ndv < 0) {		V = reflect(V, worldN);		ndv = abs(ndv);	}		vec3 R = reflect(-V, worldN);		vec3 viewPos = (gModelView * vec4(worldP,1)).xyz;	vec3 viewR = normalize((gModelView * vec4(R,0)).xyz);		///保证采样高度，而不是长度	float dtv = abs(dot(R, worldN));	if(dtv < 0.001) dtv = 0.001;	float sampleLen = maxTraceDis / dtv;	vec3 viewEndPos = viewPos + sampleLen*viewR;  ///最远反射采样点		vec4 p0 = gProjection * vec4(viewPos, 1.0);	vec4 p1 = gProjection * vec4(viewEndPos, 1.0);		float k0 = 1.0 / p0.w;	float k1 = 1.0 / p1.w;		p0 *= k0;	p1 *= k1;		p0.xy = NormalizedDeviceCoordToScreenCoord(p0.xy, screenSize.xy);	p1.xy = NormalizedDeviceCoordToScreenCoord(p1.xy, screenSize.xy);		//保证屏幕空间的光线起始点终点至少一个单位长度	float ds = distanceSquared(p1.xy, p0.xy);	p1 += ds < 0.0001 ? 0.01 : 0.0;	float divisions = length(p1.xy - p0.xy);  ///像素长度	float minStep = max(length(viewEndPos - viewPos) / divisions, sampleLen / 100);		float EPSION = minStep / 100;		float step = 2*minStep;	float traceDistance = step;	vec2 findUV = vec2(-1.0);		int iterNum = 0;	bool inside = true;	while(traceDistance < sampleLen){			vec3 tracePos = viewPos + traceDistance*viewR;				vec4 clipP = gProjection * vec4(tracePos, 1.0); // 观察->裁剪空间		clipP.xy /= clipP.w; // 透视划分		clipP.xy = clipP.xy * 0.5 + vec2(0.5); // 变换到0.0 - 1.0的值域				inside = clipP.x > 0 && clipP.x < 1 && clipP.y > 0 && clipP.y < 1;		if(inside == false) break;				//clipP.xy  = GetNoJitterUV(clipP.xy);				float depth = abs(texture(gPositionDepth, clipP.xy).w);		//多个复杂物体叠加时厚度无法计算		//float depthBack = abs(texture(gPositionDepthBack, clipP.xy).w);		vec3 normal = texture(gNormal, clipP.xy).xyz;		float dotv = dot(R, normal);				if( abs(tracePos.z) - depth > EPSION && abs(tracePos.z) - depth <= 2*minStep && depth > 1e-6){					//if(abs(tracePos.z) - depth < 2*minStep){ //正面相交及反面相交都使用相同的采样				findUV = clipP.xy;				traceDistance -= step;				step /= 2;				iterNum++;			//}		}				if( iterNum > maxIterNum ) break;					traceDistance += step;	}		if( inside && findUV.x >= 0.0 && findUV.x <= 1.0 && findUV.y >= 0.0 && findUV.y <= 1.0 ){				float camera_factor = clamp((sampleLen*10 - cameraDis) / (sampleLen*10) * 5, 0, 1 );		float trace_factor = clamp((1 - traceDistance/sampleLen)*5, 0, 1);		float factor = camera_factor * trace_factor * clamp((1 - ndv)*1.4, 0.2, 1);				gMainColor.rgb = texture(gScene, findUV - jitter).rgb * factor;				//gMainColor.rgb = GetGaussColor(gScene, findUV - jitter).rgb * factor;							///2023/7/12, 设置镜面时改变了节点的pbr属性，为什么？是因为orm.a还包含了镜像深度信息		vec4 orm = texture(gMaterial, jitUv);		float mirrorDepth = float(int(orm.a / 1000));		float render_type = orm.a - mirrorDepth*1000;				if(render_type >= 10 && render_type < 20)  ///pbr		{ 			float occlusion, roughness, metalic;			occlusion = orm.r;			roughness = orm.g;			metalic  = orm.b;			float envFactor = render_type - 10;						float ndotv = max(0.0, dot(worldN, V));						vec3 albedo = texture2D(gDiffuse, jitUv).rgb;			vec3 F0 = mix(vec3(0.04, 0.04, 0.04), albedo, metalic);			vec2 dfg = texture(pbrBRDFMap, vec2(ndotv, roughness)).xy;			gMainColor.rgb = gMainColor.rgb * (F0 * dfg.x + dfg.y);								gMainColor.a = clamp(/*metalic */ factor * envFactor, 0, 1);		}				else if(render_type >= 20 && render_type < 30)		{			float envFactor = float(int(orm.b/100)) / 10;			gMainColor.a = clamp(envFactor * factor, 0, 1);		}		///加入雾效		vec3 mirrorP = viewPos + traceDistance*viewR;		float fogBlend = clamp(CalcFogBlend(mirrorP) * 1.5, 0.3, 1.0);		gMainColor.rgb = gMainColor.rgb*fogBlend + fogColor*(1-fogBlend);	}			gMainColor = clamp(gMainColor, 0, 1);}