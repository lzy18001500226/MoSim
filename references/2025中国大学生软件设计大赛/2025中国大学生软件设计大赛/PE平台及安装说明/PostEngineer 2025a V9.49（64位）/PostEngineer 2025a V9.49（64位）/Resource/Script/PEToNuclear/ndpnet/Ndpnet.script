    '//主控取消定阅消息
    class NdpnetProxyUnsubscribeMsg 'typedef struct ndpnetProxyUnsubscribeMsgTag
    {
        '//sdk实例句柄
        dword mHandle; 'ndpnet_handle handle;
        '//响应标示
