	}

    '//代理注册
    class NdpnetProxyRegisterMsg 'typedef struct ndpnetProxyRegisterMsgTag
    {
        '//管理的子组件数量
        dword nodeNum; 'ndp_uint32 nodeNum;
        '//代理IP
        string proxyIp; 'ndp_uint8 proxyIp[NDPNET_STR_SIZE];
        '//代理名称
        string proxyName; 'ndp_uint8 proxyName[NDPNET_STR_SIZE];
        '//代理注册数据项指针
        NdpnetProxyRegisterNode pProxyRegisterNodes[10]; 'ndpnet_proxy_register_node* pProxyRegisterNodes;
    
        NdpnetProxyRegisterMsg() {}
    } 'ndpnet_proxy_register_msg;

    '//代理模块状态
