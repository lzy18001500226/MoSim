'创建时间: 2021-09-17
'作者: ypj
'描述: ndpnet 相关定义
'更新记录:
' ypj, 2022-08-27, SDK2.0 


Script{

'---------------------------------------------
' 消息ID
'---------------------------------------------
'100 - 199 系统指令
int NDPNET_HEART_MSG_ID;			 '100
int NDPNET_HEART_RESPONSE_MSG_ID;    '101

'200 - 299 响应指令
int NDPNET_RESPONSE_MSG_ID;			 '200

'300 - 399 计算指令 主控组件发送
int NDPNET_CTRL_START_CALC_MSG_ID;		'301
int NDPNET_CTRL_PAUSE_CALC_MSG_ID;		'302
int NDPNET_CTRL_RESUME_CALC_MSG_ID;		'303
int NDPNET_CTRL_STOP_CALC_MSG_ID;		'304
int NDPNET_CTRL_STEP_CALC_MSG_ID;		'305
int NDPNET_CTRL_SPEED_CALC_MSG_ID;		'306
int NDPNET_CTRL_JUMP_CALC_MSG_ID;		'307
int NDPNET_CTRL_VERIFY_CALC_MSG_ID;		'308


'500 - 599 主控设置指令
int NDPNET_SET_MODULE_ID_MSG_ID;        '501
int NDPNET_SET_CALC_ENV_MSG_ID;			'502
int NDPNET_SET_MODULE_MODE_MSG_ID;		'503
int NDPNET_PROXY_SUBSCIBE_MSG_ID;		'504
int NDPNET_PROXY_UNSUBSCIBE_MSG_ID;		'505

'600 - 699 可视组件向主控组件发送指令
int NDPNET_REGISTER_MODULE_MSG_ID;		 '600
int NDPNET_UNREGISTER_MODULE_MSG_ID;     '601
int NDPNET_CALC_FINISHED_MSG_ID;         '602
int NDPNET_CALC_READY_MSG_ID ;           '603
int NDPNET_SET_WORK_MODE_MSG_ID ;        '604
int NDPNET_SET_CALE_PARAMETER_MSG_ID;    '605

'800 - 899 数据订阅指令
int NDPNET_SUBSCRIBE_DATA_MSG_ID;		'800
int NDPNET_UNSUBSCRIBE_DATA_MSG_ID;		'801
int NDPNET_QUERY_DATA_MSG_ID;		    '803

'900 - 999    数据消息
int NDPNET_DATA_MSG_ID;	                '900
int NDPNET_DATA_UNION_MSG_ID;	        '901

'代理指令
int NDPNET_PROXY_REGISTER_MSG_ID;          '1000
int NDPNET_PROXY_CTRL_MODULE_MSG_ID;      '1001
int NDPNET_PROXY_MODULE_STATUS_MSG_ID;	  '1002
int NDPNET_PROXY_UNREGISTER_MSG_ID;	      '1003

'// 组件运行计算机资源报告指令
int NDPNET_MACHINE_STATUS_MSG_ID;	      '1100

'//计算引擎代理组件数据指令
int NDPNET_PROXY_DATA_MSG_ID;              '1200
int NDPNET_PROXY_DATA_UNION_MSG_ID;        '1201

'//系统全局变量宏定义
int NDPNET_NETWORK_ERROR;        '19000
int NDPNET_NETWORK_TIMEOUT;      '(3*60)
int NDPNET_UINT_MAX;             '0xffffffff
int NDPNET_STR_SIZE;             '128
int NDPNET_BUF_SIZE;             '(30*1024*1024)
int NDPNET_READ_BYTES;           '(100*1024)
int NDPNET_DATA_NAME_SIZE;       '(64)
int NDPNET_DATA_VALUE_SIZE;      '(64)
int NDPNET_HANDLE_MAX;           '0xffff
'#define NDPNET_CALLBACK             '_stdcall
int NDPNET_CALC_ENGINE_INPUT_PARAM_MAX;            '(15000)
int NDPNET_CALC_ENGINE_INPUT_PARAM_BUF_SIZE;       '(NDPNET_DATA_NAME_SIZE * NDPNET_CALC_ENGINE_INPUT_PARAM_MAX)
int NDPNET_CALC_ENGINE_OUTPUT_PARAM_MAX;           '(15000)
int NDPNET_CALC_ENGINE_OUTPUT_PARAM_BUF_SIZE;      '(NDPNET_DATA_NAME_SIZE * NDPNET_CALC_ENGINE_OUTPUT_PARAM_MAX)
	
'//数据类型定义
'typedef bool                        ndp_bool;           /* bool */
'typedef char                        ndp_char;           /* char */
'typedef unsigned char               ndp_uchar;          /* uchar */
'typedef signed char                 ndp_int8;           /* 8 bit signed */
'typedef unsigned char               ndp_uint8;          /* 8 bit unsigned */
'typedef short                       ndp_int16;          /* 16 bit signed */
'typedef short                       ndp_short;          /* 16 bit signed */
'typedef unsigned short              ndp_uint16;         /* 16 bit unsigned */
'typedef unsigned short              ndp_ushort;         /* 16 bit unsigned */
'typedef int                         ndp_int;            /* 32 bit signed */
'typedef int                         ndp_int32;          /* 32 bit signed */
'typedef unsigned int                ndp_uint32;         /* 32 bit unsigned */
'typedef long long                   ndp_int64;          /* 64 bit int */
'typedef long                        ndp_long;           /* long */
'typedef long long                   ndp_longlong;       /* long long */
'typedef unsigned long long          ndp_uint64;         /* 64 bit unsigned */
'typedef unsigned long long          ndp_ulonglong;      /* unsigned long long */
'typedef float                       ndp_float;          /* float */
'typedef double                      ndp_double;         /* double */
'typedef long double                 ndp_longdouble;     /* long double */
'typedef unsigned short              ndpnet_handle;      /* handle */
	
	'/******************************通信共用体结构定义*********************************/
    '//数据对应结构
    class NdpnetDataUnionValue 'typedef union ndpnetDataUnionValueTag
    {
        '//T_CHAR
        'ndp_char    c_value;
        '//T_BOOL
        'ndp_bool    l_value;
        '//T_BYTE
        'ndp_uchar   b_value;
        '//T_SHORT
        'ndp_short   s_value;
        '//T_INT
        int     i_value; 'ndp_int     i_value;
        '//T_FLOAT
        float   f_value; 'ndp_float   f_value;
        '//T_DOUBLE
        'ndp_double	d_value;
        '//T_LONG
        'ndp_int     long_value;

        NdpnetDataUnionValue()
		{}
    } 'ndpnet_data_union_value;
    '/******************************通信共用体结构定义 end *********************************/
	
	'/***********************************通信枚举常量定义**************************************/
    '//计算模式
    'enum NDPNET_CALC_MODE_ENUM
    '{
        '//预测模式
        byte NDPNET_CALC_MODE_PREDICT; 'NDPNET_CALC_MODE_PREDICT = 0,
        '//设计模式
        byte NDPNET_CALC_MODE_DESIGN; 'NDPNET_CALC_MODE_DESIGN
    '};

    '//计算引擎订阅参数类型
    'enum NDPNET_CALC_ENGINE_PARAM_TYPE
    '{
        '//输入参数
        byte NDPNET_CALC_PARAM_INPUT; 'NDPNET_CALC_PARAM_INPUT = 0,
        '//输出参数
        byte NDPNET_CALC_PARAM_OUTPUT; 'NDPNET_CALC_PARAM_OUTPUT
    '};

	'//包类型
	'enum NDPNET_PACKAGE_TYPE_ENUM
	'{
		'//无效
		byte NDPNET_INVALID_PACKAGE_TYPE;  ' 0
		'//指令类
		byte NDPNET_INSTRUCT_PACKAGE_TYPE; ' 1
		'//响应类
		byte NDPNET_RESPONSE_PACKAGE_TYPE; ' 2
		'//数据类
		byte NDPNET_DATA_PACKAGE_TYPE; '3
		'//心跳类
		byte NDPNET_HEART_PACKAGE_TYPE; '4
		'//代理类
		byte NDPNET_PROXY_PACKAGE_TYPE; '5
		'//状态报告类
        byte NDPNET_STATUS_REPORT_TYPE; '6
	'};

	'//响应类型
	'enum NEPNET_RESPONSE_TYPE_ENUM
	'{
		'//无效
		byte NDPNET_NO_RESPONSE; ' 0
		'//立即回应
		byte NDPNET_IMMEDIATELY_RESPONSE; '1
		'//任务完成后回应
		byte NDPNET_END_TASK_RESPONSE; ' 2
	'};

	'//响应类型
	'enum NEPNET_CALC_READY_TYPE_ENUM
	'{
		'//计算准备错误
		byte NDPNET_CALC_READY_ERROR; ' 0
		'//计算准备就绪
		byte NDPNET_CALC_READY_OK; ' 1
	'};

	'//响应类型
	'enum NEPNET_EXCUTE_RESULT_ENUM
	'{
		'//计算执行错误
		byte NDPNET_EXCUTE_ERROR; ' 0
		'//计算执行就绪
		byte NDPNET_EXCUTE_OK; ' 1
	'};


	'//数据类型
	'enum NDPNET_DATA_TYPE_ENUM
	'{
	    '//字符
        int NDPNET_TYPE_CHAR; '= -1,
        '//布尔
        int NDPNET_TYPE_BOOL; '= -2,
        '//字节
        int NDPNET_TYPE_BYTE; '= -3,
        '//短整型
        int NDPNET_TYPE_SHORT; '= -4,
		'//整形
		int NDPNET_TYPE_INT;    '=-5 ' 0
		'//单精度浮点数
		int NDPNET_TYPE_FLOAT;  '= -6 ' 1
		'//双精度浮点
		int NDPNET_TYPE_DOUBLE; '=-7  ' 2
        '// 长整型
        int NDPNET_TYPE_LONG;  ' NDPNET_TYPE_LONG = -9,
		'//未知数据类型
        int NDPNET_TYPE_UNKNOW; '= 0;
		'//字符串
		int NDPNET_TYPE_STRING; ' = 1 ' 3
	'};

	'//分包标识
	'enum NDPNET_SUB_FLAG_ENUM
	'{
		'//整包标识
		byte NDPNET_FULL_FLAG; ' 0
		'//分包标识
		byte NDPNET_SUB_FLAG;  ' 1
	'};
	'/***********************************通信枚举常量定义 end **********************************/

	'/***********************************通信包结构定义************************************/
    '//通信包基本结构体定义
    '//包头信息
	class NdpnetPkgHead 'typedef struct ndpnetPkgHeadTag
    {
        '//通信包分类类型ID
        int pkgType;  'ndp_uint8 pkgType;
        '//响应标示
        int resFlag;  'ndp_uint8 resFlag;
        '//消息ID
        int msgId;    'ndp_uint16 msgId;
        '//发送方组件ID
        int senderId;  'ndp_uint16 senderId;
        '//接收方组件ID
        int receiverId; 'ndp_uint16 receiverId;
        '//数据包序列号
        dword  sequence;  'ndp_uint32  sequence;
        '//分包标识
        int subFlag;  'ndp_uint8 subFlag;
        '//子包序列号
        int subSequence; 'ndp_uint16 subSequence;
        '//包总长度
        dword pkgLen; 'ndp_uint32 pkgLen;

		NdpnetPkgHead()
		{
		}

    } 'ndpnet_pkg_head;


	'//计算环境结构
	class NdpnetCalcEnv
	{
		NdpnetCalcEnv() {}

		'//机组ID
        int unitId;      'ndp_uint16 unitId;
		'//计算模式	
        byte calcModeId; 'ndp_uint8 calcModeId;
		'//工况ID		
        int workModeId;  'ndp_uint16 workModeId;
		'//计算倍速
        float speed;     'ndp_float  speed;
	}


	'//计算环境结构
	class NdpnetCalcEnvFull
	{
		NdpnetCalcEnvFull() {}
		'//机组ID
		int unitId;           'ndp_uint16 unitId;
        
		'//计算模式
		byte calcModeId;      'ndp_uint8 calcModeId;
		'//工况ID
		int workModeId;       'ndp_uint16 workModeId;
		'//计算倍速
        float speed;          'ndp_float  speed;
		'//机组名称
		string unitName;      'ndp_uint8 unitName[NDPNET_STR_SIZE];
		'//计算模式名称
		string calcModeName;  'ndp_uint8 calcModeName[NDPNET_STR_SIZE];
		'//工况名称
		string workModeName;  'ndp_uint8 workModeName[NDPNET_STR_SIZE];
	}

    '//子组件运行模式
	class NdpnetModuleMode 'typedef struct ndpnetModuleModeTag
     {
		NdpnetModuleMode() {}

		int modeId; 'ndp_uint16 modeId;
		string modeName; 'ndp_uint8 modeName[NDPNET_STR_SIZE];   
	}

	'//组件订阅消息数据节点
	class NdpnetSubscribeNode
	{
		NdpnetSubscribeNode() {}

		'//数据项类型	
        dword type;   'ndp_uint32 type;
		'//数据项编码	
        int code;    'ndp_short code;  
	}

	'//主控订阅消息数据节点
    class NdpnetProxySubscribeNode 'typedef struct ndpnetProxySubscribeNodeTag 
    {
        '//参数ID
        dword type; 'ndp_uint32 type;
        '//参数编码
        int code; 'ndp_short code;

        NdpnetProxySubscribeNode() {}
    } 'ndpnet_proxy_subscribe_node;

    '//主控数据节点(ASCII)
    class NdpnetDataNode 'typedef struct ndpnetDataNodeTag
    {
        '//参数类型
        int type; 'ndp_int16 type;
        '//参数ID
        dword id; 'ndp_uint32  id;
        '//参数编码
        string code; 'ndp_uint8  code[NDPNET_DATA_NAME_SIZE];
        '//参数值
        string value; 'ndp_uint8  value[NDPNET_DATA_VALUE_SIZE];
        
        NdpnetDataNode() {}

    } 'ndpnet_data_node;


    '//主控数据节点(UNION)
    class NdpnetDataUnionNode 'typedef struct ndpnetDataUnionNodeTag
    {
        '//参数类型
        int type; 'ndp_int16 type;
        '//参数ID
        dword id; 'ndp_uint32  id;
        '//参数编码
        int code; 'ndp_short code;
        '//参数值
        NdpnetDataUnionValue value; 'ndpnet_data_union_value  value;
    
        NdpnetDataUnionNode() 
		{
		    value = new NdpnetDataUnionValue;
		}
    } 'ndpnet_data_union_node;

    '//计算引擎数据节点（ASCII 码 表示）
    class NdpnetProxyDataNode 'typedef struct ndpnetProxyDataNodeTag
    {
        '//参数类型
        int type; 'ndp_int16 type;
        '//参数ID
        dword id; 'ndp_uint32  id;
        '//参数编码
        string code; 'ndp_uint8  code[NDPNET_DATA_NAME_SIZE];
        '//参数值
        string value; 'ndp_uint8  value[NDPNET_DATA_VALUE_SIZE];
    
        NdpnetProxyDataNode() {}
    } 'ndpnet_proxy_data_node;

    '//计算引擎数据节点（union 结构）
    class NdpnetProxyDataUnionNode 'typedef struct ndpnetProxyDataUnionNodeTag
    {
        '//参数类型
        int type; 'ndp_int16 type;
        '//参数ID
        dword id; 'ndp_uint32  id;
        '//参数编码
        int code; 'ndp_short  code;
        '//参数值
        NdpnetDataUnionValue value;'ndpnet_data_union_value  value;
    
        NdpnetProxyDataUnionNode() {}
    } 'ndpnet_proxy_data_union_node;

    '//代理注册节点
    class NdpnetProxyRegisterNode 'typedef struct ndpnetProxyRegisterNodeTag
    {
        '//子组件ID
        int moduleId; 'ndp_uint16  moduleId;
        '//子组件名称
        string moduleName; 'ndp_uint8   moduleName[NDPNET_STR_SIZE];
        '//子组件状态
        int state; 'ndp_uint8   state;

        NdpnetProxyRegisterNode() {}
    } 'ndpnet_proxy_register_node;

    '//代理子组件状态节点
    class NdpnetProxyModuleStatusNode 'typedef struct ndpnetProxyModuleStateNodeTag
    {
        '//子组件ID
        int moduleId; 'ndp_uint16  moduleId;
        '//子组件状态
        int state; 'ndp_uint8   state;

        NdpnetProxyModuleStatusNode() {}
    } 'ndpnet_proxy_module_status_node;

    '//100-199
    '//NDPNET_HEART_MSG_ID				      100
    '//心跳消息数据
    class NdpnetHeartPkgData 'typedef struct ndpnetHeartPkgDataTag
    {
        dword len; 'ndp_uint32 len;//长度
        dword ts; 'ndp_uint64 ts;//时间

        NdpnetHeartPkgData() {}
    } 'ndpnet_heart_pkg_data;

    '//心跳消息
    class NdpnetHeartPkg 'typedef struct ndpnetHeartPkgTag
    {
        NdpnetPkgHead head; 'ndpnet_pkg_head head;         //包头
        NdpnetHeartPkgData data; 'ndpnet_heart_pkg_data data;   //包体
    
        NdpnetHeartPkg() {}
    } 'ndpnet_heart_pkg;

    '//心跳信息
    class NdpnetHeartInfo 'typedef struct ndpnetHeartInfoTag
    {
        '//发送方组件ID
        int senderId; 'ndp_uint16 senderId;
        '//接收方组件ID
        int receiverId; 'ndp_uint16 receiverId;

        NdpnetHeartInfo() {}
    } 'ndpnet_heart_info;

    '//NDPNET_HEART_RESPONSE_MSG_ID          101
    '//心跳响应消息数据
    class NdpnetResponseHeartPkgData 'typedef struct ndpnetResponseHeartPkgDataTag
    {
        dword len; 'ndp_uint32 len;                  //长度
        dword ts; 'ndp_uint64 ts;                   //时间
  
        NdpnetResponseHeartPkgData() {}
    } 'ndpnet_response_heart_pkg_data;


    '//心跳响应消息
    class NdpnetResponseHeartPkg 'typedef struct ndpnetResponseHeartPkgTag
    {
        NdpnetPkgHead head; 'ndpnet_pkg_head head;                     //包头
        NdpnetResponseHeartPkgData data; 'ndpnet_response_heart_pkg_data data;      //包体
   
        NdpnetResponseHeartPkg() {}
    } 'ndpnet_response_heart_pkg;

    '//200-299
    '//NDPNET_RESPONSE_MSG_ID			      200
    '//响应消息
    class NdpResponsePkgData 'typedef struct ndpResponsePkgDataTag
    {
        '//长度
        dword len; 'ndp_uint32 len;
        '//消息ID
        int msgId; 'ndp_uint16 msgId;
        '//执行结果
        int excuteResult; 'ndp_uint16 excuteResult;
        '//数据包序列值
        dword sequence; 'ndp_uint32  sequence;
        '//备注
        string comment; 'ndp_uint8 comment[NDPNET_STR_SIZE];
    
        NdpResponsePkgData() {}
    } 'ndpnet_response_pkg_data;

    '//响应消息
    class NdpResponsePkg 'typedef struct ndpResponsePkgTag
    {
        NdpnetPkgHead head; 'ndpnet_pkg_head head;
        NdpResponsePkgData data; 'ndpnet_response_pkg_data data;
    
        NdpResponsePkg() {}
    } 'ndpnet_response_pkg;

    '//300 - 399
    '//NDPNET_CTRL_START_CALC_MSG_ID		  301
    '//启动计算消息数据
    class NdpnetCtrlStartCalcPkgData 'typedef struct ndpnetCtrlStartCalcPkgDataTag
    {
        '//数据区长度
        dword len; 'ndp_uint32 len;
        '//计算环境
        NdpnetCalcEnv calcEnv; 'ndpnet_calc_env calcEnv;
        '//组件工作模式ID
        int moduleModeId; 'ndp_uint16 moduleModeId;
        '//开始时间
        dword starTime; 'ndp_uint32 starTime;
        '//计算时长
        dword calcTime; 'ndp_uint32 calcTime;
        '//倍速
        float speed; 'ndp_float speed;

        NdpnetCtrlStartCalcPkgData() {}
    } 'ndpnet_ctrl_start_calc_pkg_data;

    '//启动计算消息
    class NdpnetCtrlStartCalcPkg 'typedef struct ndpnetCtrlStartCalcPkgTag
    {
        NdpnetPkgHead head; 'ndpnet_pkg_head head;                         //包头
        NdpnetCtrlStartCalcPkgData data; 'ndpnet_ctrl_start_calc_pkg_data data;         //包体
    
        NdpnetCtrlStartCalcPkg() {}
    } 'ndpnet_ctrl_start_calc_pkg;

    '//NDPNET_CTRL_PAUSE_CALC_MSG_ID		  302
    '//暂停计算消息数据
    class NdpnetCtrlPauseCalcPkgData 'typedef struct ndpnetCtrlPauseCalcPkgDataTag
    {
        '//数据区长度
        dword len; 'ndp_uint32 len;
        '//计算环境
        NdpnetCalcEnv calcEnv; 'ndpnet_calc_env calcEnv;
    
        NdpnetCtrlPauseCalcPkgData() {}
    } 'ndpnet_ctrl_pause_calc_pkg_data;

    '//暂停计算消息
    class NdpnetCtrlPauseCalcPkg 'typedef struct ndpnetCtrlPauseCalcPkgTag
    {
        NdpnetPkgHead head; 'ndpnet_pkg_head head;                          //包头
        NdpnetCtrlPauseCalcPkgData data; 'ndpnet_ctrl_pause_calc_pkg_data data;          //包体
    
        NdpnetCtrlPauseCalcPkg() {}
    } 'ndpnet_ctrl_pause_calc_pkg;

    '//NDPNET_CTRL_RESUME_CALC_MSG_ID		  303
    '//恢复计算消息数据
    class NdpnetCtrlResumeCalcPkgData 'typedef struct ndpnetCtrlResumeCalcPkgDataTag
    {
        '//数据区长度
        dword len; 'ndp_uint32 len;
        '//计算环境
        NdpnetCalcEnv calcEnv; 'ndpnet_calc_env calcEnv;
    
        NdpnetCtrlResumeCalcPkgData() {}
    } 'ndpnet_ctrl_resume_calc_pkg_data;

    '//恢复计算消息
    class NdpnetCtrlResumeCalcPkg 'typedef struct ndpnetCtrlResumeCalcPkgTag
    {
        NdpnetPkgHead head; 'ndpnet_pkg_head head;                          //包头
        NdpnetCtrlResumeCalcPkgData data; 'ndpnet_ctrl_resume_calc_pkg_data data;         //包体
    
        NdpnetCtrlResumeCalcPkg() {}
    } 'ndpnet_ctrl_resume_calc_pkg;

    '//NDPNET_CTRL_STOP_CALC_MSG_ID		  304
    '//停止计算消息数据
    class NdpnetCtrlStopCalcPkgData'typedef struct ndpnetCtrlStopCalcPkgDataTag
    {
        '//数据区长度
        dword len; 'ndp_uint32 len;
        '//计算环境
        NdpnetCalcEnv calcEnv; 'ndpnet_calc_env calcEnv;
    
        NdpnetCtrlStopCalcPkgData() {}
    } 'ndpnet_ctrl_stop_calc_pkg_data;

    '//停止计算消息
    class NdpnetCtrlStopCalcPkg 'typedef struct ndpnetCtrlStopCalcPkgTag
    {
        NdpnetPkgHead head; 'ndpnet_pkg_head head;                     //包头
        NdpnetCtrlStopCalcPkgData data; 'ndpnet_ctrl_stop_calc_pkg_data data;      //包体
    
        NdpnetCtrlStopCalcPkg() {}
    } 'ndpnet_ctrl_stop_calc_pkg;

    '//NDPNET_CTRL_STEP_CALC_MSG_ID		  305
    '//步进计算消息数据
    class NdpnetCtrlStepCalcPkgData 'typedef struct ndpnetCtrlStepCalcPkgDataTag
    {
        '//长度
        dword len; 'ndp_uint32 len;
        '//计算环境
        NdpnetCalcEnv calcEnv; 'ndpnet_calc_env calcEnv;
        '//步进时间
        dword step; 'ndp_int32  step;
    
        NdpnetCtrlStepCalcPkgData() {}
    } 'ndpnet_ctrl_step_calc_pkg_data;

    '//步进计算消息
    class NdpnetCtrlStepCalcPkg 'typedef struct ndpnetCtrlStepCalcPkgTag
    {
        NdpnetPkgHead head; 'ndpnet_pkg_head head;                 //包头
        NdpnetCtrlStepCalcPkgData data; 'ndpnet_ctrl_step_calc_pkg_data data;  //包体
    
        NdpnetCtrlStepCalcPkg() {}
    } 'ndpnet_ctrl_step_calc_pkg;

    '//NDPNET_CTRL_SPEED_CALC_MSG_ID		  306
    '//倍数计算消息数据
    class NdpnetCtrlSpeedCalcPkgData 'typedef struct ndpnetCtrlSpeedCalcPkgDataTag
    {
        '//长度
