    {
        '//管理的子组件数量
        dword nodeNum; 'ndp_uint32 nodeNum;
        '//代理IP
        int proxyId; 'ndp_uint16 proxyId;
        '//模块状态数据项指针
        NdpnetProxyModuleStatusNode pProxyModuleStatusNodes[10]; 'ndpnet_proxy_module_status_node* pProxyModuleStatusNodes;
    
        NdpnetProxyModuleStatusMsg() {}
    } 'ndpnet_proxy_module_status_msg;

    '//客户机机器状态报告
    class NdpnetMachineStatusMsg 'typedef struct ndpnetMachineStatusMsgTag
    {
        '//组件ID
        int moduleId; 'ndp_uint16 moduleId;
        '//CPU占用率(百分值，浮点数)
        float cpu; 'ndp_float cpu;
        '//内存占用率(百分值，浮点数)
        float mem; 'ndp_float mem;
        '//已使用内存总大小(MB)
        dword usedMem; 'ndp_uint32 usedMem;
        '//内存总大小(MB)
        dword totalMem; 'ndp_uint32 totalMem;

        NdpnetMachineStatusMsg() {}
    } 'ndpnet_machine_status_msg;

    '//代理注销消息
    class NdpnetProxyUnregisterMsg 'typedef struct ndpnetProxyUnregisterMsgTag
    {
        '//代理IP
        int proxyId; 'ndp_uint16 proxyId;

        NdpnetProxyUnregisterMsg() {}
    } 'ndpnet_proxy_unregister_msg;

	'//主控数据消息(ASCII)
