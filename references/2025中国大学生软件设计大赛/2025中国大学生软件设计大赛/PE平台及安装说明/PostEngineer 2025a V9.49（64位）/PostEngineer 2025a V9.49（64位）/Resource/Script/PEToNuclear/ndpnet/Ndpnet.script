		byte resFlag;    'ndp_uint8 resFlag;
		'//数据包序列值
		dword sequence;  'ndp_uint32  sequence;
		'//计算环境
		NdpnetCalcEnv calcEnv; 'ndpnet_calc_env calcEnv;
        '//倍速
        float speed; 'ndp_float speed; 

		NdpnetCtrlResumeCalcMsg() 
		{
		    calcEnv = new NdpnetCalcEnv;
		}

	} 'ndpnet_ctrl_resume_calc_msg;

