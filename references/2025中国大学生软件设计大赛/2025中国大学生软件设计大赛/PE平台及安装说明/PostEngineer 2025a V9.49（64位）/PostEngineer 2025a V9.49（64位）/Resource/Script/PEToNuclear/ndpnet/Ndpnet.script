        '//时间
        dword time; 'ndp_uint32 time;
        '//数据数组起始地址
        NdpnetProxyDataNode pNodes[10]; 'ndpnet_proxy_data_node * pNodes;
    
        NdpnetProxyDataMsg() {}
    } 'ndpnet_proxy_data_msg;

    '//计算引擎代理数据消息（UNION 结构）
    class NdpnetProxyDataUnionMsg 'typedef struct ndpnetProxyDataUnionMsgTag
    {
        '//sdk实例句柄
        dword mHandle; 'ndpnet_handle handle;
        '//响应标示
        byte resFlag; 'ndp_uint8 resFlag;
        '//数据包序列值
        dword sequence; 'ndp_uint32  sequence;
        '//子组件ID
        int moduleId; 'ndp_uint16  moduleId;
        '//数据参数数量
        dword nodeNum; 'ndp_uint32 nodeNum;
        '//时间
        dword time; 'ndp_uint32 time;
        '//数据数组起始地址
        NdpnetProxyDataUnionNode pNodes[10]; 'ndpnet_proxy_data_union_node * pNodes;
    
        NdpnetProxyDataUnionMsg() {}
    } 'ndpnet_proxy_data_union_msg;

    '/***********************************客户端接口结构体定义******************************/
	
	'------------------------------------------------------
	' 消息变量声明 （23 个）
	'------------------------------------------------------
    ' 收到主操台的消息(in)：PE 端设置，脚本端访问的参数
    ' 发送给主操台的消息(out)：脚本端设置，PE 端访问的参数
    '------------------------------------------------------
    '//心跳消息信息 in
	NdpnetHeartMsg             ndpnetHeartMsg;
	'//组件注册消息 out
	NdpnetRegisterModuleMsg    ndpnetRegisterModuleMsg;
	'//响应消息数据 in
	NdpnetResponseMsg          ndpnetResponseMsg;
	'//设置组件ID消息数据
	NdpnetSetModuleIdMsg       ndpnetSetModuleIdMsg;
	'//设置计算环境指令信息
	NdpnetSetCalcEnvMsg       ndpnetSetCalcEnvMsg;
	'//设置组件工作模式指令信息
	NdpnetSetModuleModeMsg     ndpnetSetModuleModeMsg;
	'//启动计算指令信息
	NdpnetCtrlStartCalcMsg     ndpnetCtrlStartCalcMsg;
	'//暂停计算指令信息
	NdpnetCtrlPauseCalcMsg     ndpnetCtrlPauseCalcMsg;
	'//恢复计算指令信息
	NdpnetCtrlResumeCalcMsg    ndpnetCtrlResumeCalcMsg;
	'//启动计算指令信息
	NdpnetCtrlStopCalcMsg      ndpnetCtrlStopCalcMsg;
	'//步进计算指令消息
	NdpnetCtrlStepCalcMsg      ndpnetCtrlStepCalcMsg;
	'//倍速计算指令消息
	NdpnetCtrlSpeedCalcMsg     ndpnetCtrlSpeedCalcMsg;
	'//跳转计算指令消息
	NdpnetCtrlJumpCalcMsg      ndpnetCtrlJumpCalcMsg;
	'//校准计算指令消息
	NdpnetCtrlVerifyCalcMsg    ndpnetCtrlVerifyCalcMsg;
	'//设置参数值   软操台专用
	'NdpnetSetParameterMsg      ndpnetSetParameterMsg;
	'//客户端响应消息
	NdpnetClientResponseMsg    ndpnetClientResponseMsg;
	'//计算准备完成
	NdpnetCalcReadyMsg         ndpnetCalcReadyMsg; 
	'//计算结束通知消息
	NdpnetCalcFinishedMsg      ndpnetCalcFinishedMsg;
	'//软操台切换工况  软操台专用
	'NdpnetWorkModeMsg          ndpnetWorkModeMsg; 
	'//数据订阅消息
	NdpnetSubscribeMsg         ndpnetSubscribeMsg;  
	'//数据取消订阅消息
	NdpnetUnsubscribeMsg       ndpnetUnsubscribeMsg;
	'//查询数据段消息
	NdpnetQueryDataMsg         ndpnetQueryDataMsg;
	'//数据节点
	'NdpnetDataNode
	'//数据消息
	NdpnetDataMsg              ndpnetDataMsg;
	NdpnetDataUnionMsg         ndpnetDataUnionMsg;


'------------------------------
' ndpnet 相关接口封装类
'------------------------------
class NdpnetManager 
{
    '//ndpnet 通信插件名
    string mPluginName;
	
	void initEnum()
	{
		'//包类型
	'enum NDPNET_PACKAGE_TYPE_ENUM
	'{
		'//无效
		NDPNET_INVALID_PACKAGE_TYPE = 0;
		'//指令类
		NDPNET_INSTRUCT_PACKAGE_TYPE = 1;
		'//响应类
		NDPNET_RESPONSE_PACKAGE_TYPE = 2;
		'//数据类
		NDPNET_DATA_PACKAGE_TYPE = 3;
		'//心跳类
		NDPNET_HEART_PACKAGE_TYPE = 4;
		'//代理类
		NDPNET_PROXY_PACKAGE_TYPE = 5;
	'};

	'//响应类型
	'enum NEPNET_RESPONSE_TYPE_ENUM
	'{
		'//无效
		NDPNET_NO_RESPONSE = 0;
		'//立即回应
		NDPNET_IMMEDIATELY_RESPONSE = 1;
		'//任务完成后回应
		NDPNET_END_TASK_RESPONSE = 2;
	'};

	'//响应类型
	'enum NEPNET_CALC_READY_TYPE_ENUM
	'{
		'//计算准备错误
		NDPNET_CALC_READY_ERROR = 0;
		'//计算准备就绪
		NDPNET_CALC_READY_OK = 1;
	'};

	'//响应类型
	'enum NEPNET_EXCUTE_RESULT_ENUM
	'{
		'//计算执行错误
		NDPNET_EXCUTE_ERROR = 0;
		'//计算执行就绪
		NDPNET_EXCUTE_OK = 1;
	'};


	'//数据类型
	'enum NDPNET_DATA_TYPE_ENUM
	'{
		'//整形
		NDPNET_TYPE_INT = 0;
		'//单精度浮点数
		NDPNET_TYPE_FLOAT = 1;
		'//双精度浮点
		NDPNET_TYPE_DOUBLE = 2;
		'//字符串
		NDPNET_TYPE_STRING = 3;
	'};

	'//分包标识
	'enum NDPNET_SUB_FLAG_ENUM
	'{
		'//整包标识
		NDPNET_FULL_FLAG = 0;
		'//分包标识
		NDPNET_SUB_FLAG = 1;
	'};
	}
	
	'''
    ' @brief 初始化消息ID
    '/
    void initMsgId()
    {
        '//消息ID定义

        '//100 - 199 系统指令
        NDPNET_HEART_MSG_ID			=	100;
        NDPNET_HEART_RESPONSE_MSG_ID  =  101;

        '//200 - 299 响应指令
        NDPNET_RESPONSE_MSG_ID		=	200;

        '//300 - 399 计算指令 主控组件发送
        NDPNET_CTRL_START_CALC_MSG_ID	     = 301;
        NDPNET_CTRL_PAUSE_CALC_MSG_ID	     = 302;
        NDPNET_CTRL_RESUME_CALC_MSG_ID       = 303;
        NDPNET_CTRL_STOP_CALC_MSG_ID	     = 304;
        NDPNET_CTRL_STEP_CALC_MSG_ID	     = 305;
        NDPNET_CTRL_SPEED_CALC_MSG_ID	     = 306;
        NDPNET_CTRL_JUMP_CALC_MSG_ID	     = 307;
        NDPNET_CTRL_VERIFY_CALC_MSG_ID       = 308;

        '//500 - 599 主控设置指令
        NDPNET_SET_MODULE_ID_MSG_ID          = 501;
        NDPNET_SET_CALC_ENV_MSG_ID           = 502;
        NDPNET_SET_MODULE_MODE_MSG_ID	     = 503;

        '//600 - 699 可视组件向主控组件发送指令
        NDPNET_REGISTER_MODULE_MSG_ID		 = 600;
        NDPNET_UNREGISTER_MODULE_MSG_ID    = 601;
        NDPNET_CALC_FINISHED_MSG_ID        = 602;
        NDPNET_CALC_READY_MSG_ID           = 603;
        NDPNET_SET_WORK_MODE_MSG_ID        = 604;
        NDPNET_SET_CALE_PARAMETER_MSG_ID   = 605;

        '//800 - 899 数据订阅指令
        NDPNET_SUBSCRIBE_DATA_MSG_ID		= 800;
        NDPNET_UNSUBSCRIBE_DATA_MSG_ID	    = 801;
        NDPNET_QUERY_DATA_MSG_ID		    = 803;

        '//900 - 999    数据消息
        NDPNET_DATA_MSG_ID	 = 900;
	    NDPNET_DATA_UNION_MSG_ID = 901;

        '代理指令  暂用不到，注掉
        'NDPNET_PROXY_REGISTER_MSG_ID        = 1000;
        'NDPNET_PROXY_CTRL_MODULE_MSG_ID     = 1001;    '//NDPNET_PROXY_START_MODULE_MSG_ID	= 1001;
        'NDPNET_PROXY_MODULE_STATUS_MSG_ID   = 1002;    '//NDPNET_PROXY_STOP_MODULE_MSG_ID	= 1002;
		'NDPNET_PROXY_UNREGISTER_MSG_ID      = 1003;
    }
	
	void initMsg()
	{
	'//心跳消息信息 in
	ndpnetHeartMsg            = new NdpnetHeartMsg;
	'//组件注册消息 out
	ndpnetRegisterModuleMsg   = new NdpnetRegisterModuleMsg;
	'//响应消息数据 in
	ndpnetResponseMsg         = new NdpnetResponseMsg;
	'//设置组件ID消息数据
	ndpnetSetModuleIdMsg      = new NdpnetSetModuleIdMsg;
	'//设置计算环境指令信息
	ndpnetSetCalcEnvMsg      = new NdpnetSetCalcEnvMsg;
	'//设置组件工作模式指令信息
	ndpnetSetModuleModeMsg    = new NdpnetSetModuleModeMsg;
	'//启动计算指令信息
	ndpnetCtrlStartCalcMsg    = new NdpnetCtrlStartCalcMsg;
	'//暂停计算指令信息
	ndpnetCtrlPauseCalcMsg    = new NdpnetCtrlPauseCalcMsg;
	'//恢复计算指令信息
	ndpnetCtrlResumeCalcMsg   = new NdpnetCtrlResumeCalcMsg;
	'//启动计算指令信息
	ndpnetCtrlStopCalcMsg     = new NdpnetCtrlStopCalcMsg;
	'//步进计算指令消息
	ndpnetCtrlStepCalcMsg     = new NdpnetCtrlStepCalcMsg;
	'//倍速计算指令消息
	ndpnetCtrlSpeedCalcMsg    = new NdpnetCtrlSpeedCalcMsg;
	'//跳转计算指令消息
	ndpnetCtrlJumpCalcMsg     = new NdpnetCtrlJumpCalcMsg;
	'//校准计算指令消息
	ndpnetCtrlVerifyCalcMsg   = new NdpnetCtrlVerifyCalcMsg;
	'//设置参数值 （软操台专用）
	'ndpnetSetParameterMsg     = new NdpnetSetParameterMsg;
	'//客户端响应消息
	ndpnetClientResponseMsg   = new NdpnetClientResponseMsg;
	'//计算准备完成 out
	ndpnetCalcReadyMsg        = new NdpnetCalcReadyMsg; 
	'//计算结束通知消息 out
	ndpnetCalcFinishedMsg     = new NdpnetCalcFinishedMsg;
	'//软操台切换工况 (软操台向主控发送工况切换信息)
	'ndpnetWorkModeMsg        = new NdpnetWorkModeMsg; 
	'//数据订阅消息  out
	ndpnetSubscribeMsg        = new NdpnetSubscribeMsg;  
	'//数据取消订阅消息 out
	ndpnetUnsubscribeMsg      = new NdpnetUnsubscribeMsg;
	'//查询数据段消息
	ndpnetQueryDataMsg        = new NdpnetQueryDataMsg;
	'//数据节点
	'NdpnetDataNode
	'//数据消息
	ndpnetDataMsg             = new NdpnetDataMsg;
	ndpnetDataUnionMsg = new NdpnetDataUnionMsg;
	}
	
	NdpnetManager() 
	{
	    mPluginName = "PEToNuclear";

        initMsgId();
		initEnum();
		initMsg();
	}

    '''
     ' @brief 初始化网络，生成 handle
     ' @return 0: 成功; 1: 失败
     '/
    int init()
    {
        return pluginCall(mPluginName, "ndpnetInit", "");
    }

    '''
     ' @brief 网络终止化
     '/
    void release()
    {
        pluginCall(mPluginName, "ndpnetRelease", "");
    }

	'''
     ' @brief 设置接收计算数据的时间间隔。单位为毫秒。若不设置，默认为 100 ms
	 ' @since 2023-03-30
     '/
    void setDataTimeSpan(int ms)
    {
        pluginCall(mPluginName, "ndpnetSetDataTimeSpan", ms);
    }

	'''
	 ' @brief 设置消息回调脚本函数
	 '/
	int setMessageListenerFunction(string& scriptFuncName)
	{
	    return pluginCall(mPluginName, "ndpnetSetMessageListenerFunc", scriptFuncName);
	}

	'''
	 ' @brief 设置消息回调脚本对象
	 '/
	int setMessageListener(string& scriptObjectName)
	{
	    return pluginCall(mPluginName, "ndpnetSetMessageListener", scriptObjectName);
	}



    '''
     ' @brief 连接主控
     ' @param ip
     ' @param port
     ' @return 0: 成功；否则，失败
     '/
    int connect(string& ip , int port)
	{
	    return pluginCall(mPluginName, "ndpnetConnect", ip, port);
	}

    '''
     ' @brief 断开与主控的连接
     ' @return 0: 成功；否则，失败
     '/
    int disconnect()
	{
	    return pluginCall(mPluginName, "ndpnetDisconnect", "");
	}

    '''
     ' @brief 注册组件
     ' @return 0: 成功；否则，失败
     '/
    int registerModule()
	{
	    return pluginCall(mPluginName, "ndpnetRegisterModule", "");	
	}

    '''
     ' @brief 取消注册组件
     ' @return 0: 成功；否则，失败
     '/
    int unregisterModule()
	{
	    return pluginCall(mPluginName, "ndpnetUnregisterModule", "");	
	}

    '''
     ' @brief 订阅
     ' @return 0: 成功；否则，失败
     '/
    int subscribe()
	{
	    return pluginCall(mPluginName, "ndpnetSubscribe", "");
	}

    '''
     ' @brief 取消订阅
     ' @return 0: 成功；否则，失败
     '/
    int unsubscribe()
    {
	    return pluginCall(mPluginName, "ndpnetUnsubscribe", "");
    }
	
    '/**
	' * @brief 发送客户端响应消息
	' * @return 0: 成功；否则，失败
	' */
	int sendClientResponseMsg()
	{
	    return pluginCall(mPluginName, "ndpnetSendClientResponseMsg", "");
	}

	'/**
	' * @brief 可视化组件通知主控计算完成
	' * @return 0: 成功；否则，失败
	' */
	int sendCalcFinished()
	{
	    return pluginCall(mPluginName, "ndpnetSendCalcFinished", "");
	}

	'/**
	' * @brief 组件通知主控，准备就绪，可以开始计算
	' * @return 0: 成功；否则，失败
	' */
	int sendCalcReady()
	{
		return pluginCall(mPluginName, "ndpnetSendCalcReady", "");
	}

	
	'/**
	' * @brief 组件响应心跳包
	' * @return 0: 成功；否则，失败
	' */
	int sendHeartResponse()
	{
	    return pluginCall(mPluginName, "ndpnetSendHeartResponse", "");
	}

} 

}