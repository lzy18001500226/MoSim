	'//组件注册消息
	class NdpnetRegisterModuleMsg 'typedef struct ndpnetRegisterModuleMsgTag
	{
		'//sdk实例句柄
		dword mHandle; 'ndpnet_handle handle;
		'//组件类型
		int moduleTypeId;    'ndp_uint16 moduleTypeId;
		'//名称
		string moduleName;    'ndp_uint8 moduleName[NDPNET_STR_SIZE];
		'//专业
		string profession;    'ndp_uint8 profession[NDPNET_STR_SIZE];
		'//地址
		string adress;        'ndp_uint8 adress[NDPNET_STR_SIZE];
		'//描述
		string description;   'ndp_uint8 description[NDPNET_STR_SIZE];
		'//模式数量
		int moduleModeLength; 'ndp_uint16 moduleModeLength;
		'//模式列表
		NdpnetModuleMode pModuleModes[10];    'ndpnet_module_mode* pModuleModes;
		
		NdpnetRegisterModuleMsg() 
		{
		    'pModuleModes[0] = new NdpnetModuleMode;
			'pModuleModes[1] = new NdpnetModuleMode;
			'pModuleModes[2] = new NdpnetModuleMode;
			'pModuleModes[3] = new NdpnetModuleMode;
			'pModuleModes[4] = new NdpnetModuleMode;
		}
	} 'ndpnet_register_module_msg;


