    '//计算引擎代理数据消息(ASCII 表示)
    class NdpnetProxyDataMsg 'typedef struct ndpnetProxyDataMsgTag
    {
        '//sdk实例句柄
        dword mHandle; 'ndpnet_handle handle;
        '//响应标示
        byte resFlag; 'ndp_uint8 resFlag;
        '//数据包序列值
        dword sequence; 'ndp_uint32  sequence;
        '//数据参数数量
