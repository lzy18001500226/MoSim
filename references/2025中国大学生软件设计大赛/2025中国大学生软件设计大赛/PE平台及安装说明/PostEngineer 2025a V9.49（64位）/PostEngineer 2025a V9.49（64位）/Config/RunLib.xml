<?xml version="1.0" encoding="GB2312" ?>
<Type:1 value="打包该文件夹下所有文件" />
<Type:2 value="打包该文件夹下所有文件及其子文件" />
<Type:3 value="按下列文件列表打包" />
<Type:4 value="按下列文件类型打包" />
<Type:5 value="黑名单" />
<----Example 可在PERunLib下按下例设置需要打包的文件>
    <Item name="Shaders" Type="1" />
    <Item name="Support" Type="2" />
    <Item name="Config" Type="3">
        <File name="PluginManager.xml" />
    </Item>
    <Item name="Plugins" Type="4">
        <File name="*.dll" />
        <File name="*.ini" />
    </Item>  
    <--BlackList中可设置用户不需要打包的文件，可设置多个不需要的文件名/>  
    <--BlackList Type="5">
        <File name="abcde.dll" />
     </--BlackList>
</----Example>
