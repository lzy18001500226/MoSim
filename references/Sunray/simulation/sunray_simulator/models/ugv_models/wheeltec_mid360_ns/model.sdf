<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="wheeltec_mid360_ns">
    <link name="base_link">
      <pose>0 0 0.16 0 0 0</pose>
      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.028819942</ixx>
          <iyy>0.047333716</iyy>
          <izz>0.054201740</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.15 0.1</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0.045 0 -0.05 1.57 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://wheeltec/meshes/body.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="right_front_wheel">
      <pose>0.08 -0.1 0.12 1.57 0 0</pose>
      <inertial>
        <mass>0.3844</mass>
        <inertia>
          <ixx>0.000480000</ixx>
          <iyy>0.000480000</iyy>
          <izz>0.000480000</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name='right_front_wheel_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.02</length>
            <radius>0.035</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.3</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <pose>-0.035 0.015 -0.1 3.14 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://wheeltec/meshes/front.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="right_after_wheel">
      <pose>-0.08 -0.1 0.12 1.57 0 0</pose>
      <inertial>
        <mass>0.3844</mass>
        <inertia>
          <ixx>0.000480000</ixx>
          <iyy>0.000480000</iyy>
          <izz>0.000480000</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name='right_after_wheel_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.02</length>
            <radius>0.035</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.3</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <pose>-0.035 0.015 -0.1 3.14 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://wheeltec/meshes/front.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="left_front_wheel">
      <pose>0.08 0.1 0.12 1.57 0 0</pose>
      <inertial>
        <mass>0.3844</mass>
        <inertia>
          <ixx>0.000480000</ixx>
          <iyy>0.000480000</iyy>
          <izz>0.000480000</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name='left_front_wheel_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.02</length>
            <radius>0.035</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.3</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <pose>-0.035 -0.015 0.1 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://wheeltec/meshes/front.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="left_after_wheel">
      <pose>-0.08 0.1 0.12 1.57 0 0</pose>
      <inertial>
        <mass>0.3844</mass>
        <inertia>
          <ixx>0.000480000</ixx>
          <iyy>0.000480000</iyy>
          <izz>0.000480000</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name='left_after_wheel_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.02</length>
            <radius>0.035</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.3</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <pose>-0.035 -0.015 0.1 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://wheeltec/meshes/front.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- Livox MID360 -->
    <link name="lidar_link">
      <pose>0 0 0.25 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <collision name="lidar_collision">
        <pose>0 0 0 1.57 0 3.14159</pose>
        <geometry>
          <mesh>
            <scale>1.2 1.2 1.2</scale>
            <uri>model://livox_mid360/meshes/test2.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name='lidar_visual'>
        <pose>0 0 0 1.57 0 3.14159</pose>
        <geometry>
          <mesh>
            <scale>1.2 1.2 1.2</scale>
            <uri>model://livox_mid360/meshes/test2.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <sensor type="ray" name="laser_livox">
        <pose>0 0 0.1 0 0 0</pose>
        <visualize>false</visualize>
        <always_on>True</always_on>
        <update_rate>10</update_rate>
        <plugin name="gazebo_ros_laser_controller" filename="liblivox_laser_simulation.so">
          <ray>
            <scan>
              <horizontal>
                <samples>100</samples>
                <resolution>1</resolution>
                <min_angle>-3.1415926535897931</min_angle>
                <max_angle>3.1415926535897931</max_angle>
              </horizontal>
              <vertical>
                <samples>50</samples>
                <resolution>1</resolution>
                <min_angle>-3.1415926535897931</min_angle>
                <max_angle>3.1415926535897931</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.4</min>
              <max>40</max>
              <resolution>1</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </ray>
          <visualize>0</visualize>
          <samples>20000</samples>
          <downsample>4</downsample>
          <csv_file_name>mid360-real-centr.csv</csv_file_name>
          <publish_pointcloud_type>1</publish_pointcloud_type>
          <ros_topic>livox/lidar</ros_topic>
          <frameName>lidar_link</frameName>
        </plugin>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>0</visualize>
        <topic>livox/imu</topic>
        <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
          <topicName>livox/imu</topicName>
          <bodyName>lidar_link</bodyName>
          <updateRateHZ>100.0</updateRateHZ>
          <gaussianNoise>0.0</gaussianNoise>
          <xyzOffset>0 0 0</xyzOffset>
          <rpyOffset>0 0 0</rpyOffset>
          <frameName>lidar_link</frameName>
        </plugin>
        <pose>0 0 0 0 0 0</pose>
      </sensor>
    </link>

    <!-- Joints -->
    <joint type="revolute" name="right_front_wheel_joint">
      <child>right_front_wheel</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint type="revolute" name="right_after_wheel_joint">
      <child>right_after_wheel</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint type="revolute" name="left_front_wheel_joint">
      <child>left_front_wheel</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint type="revolute" name="left_after_wheel_joint">
      <child>left_after_wheel</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <child>lidar_link</child>
      <parent>base_link</parent>
    </joint>

    <!-- Mecanum controller plugin - 话题会继承模型的命名空间 -->
    <plugin name="mecanum_controller" filename="libgazebo_ros_planar_move.so">
      <updateRate>100.0</updateRate>
      <cmdTimeout>0.01</cmdTimeout>
      <leftFrontJoint>left_front_wheel_joint</leftFrontJoint>
      <rightFrontJoint>right_front_wheel_joint</rightFrontJoint>
      <leftRearJoint>left_after_wheel_joint</leftRearJoint>
      <rightRearJoint>right_after_wheel_joint</rightRearJoint>
      <wheelSeparation>0.1</wheelSeparation>
      <wheelDiameter>0.07</wheelDiameter>
      <torque>2</torque>
      <commandTopic>cmd_vel</commandTopic>
      <odometryFrame>world</odometryFrame>
      <odometryTopic>odom</odometryTopic>
      <robotBaseFrame>base_link</robotBaseFrame>
      <broadcastTF>0</broadcastTF>
      <publishTf>0</publishTf>
      <publishWheelJointState>true</publishWheelJointState>
      <alwaysOn>true</alwaysOn>
    </plugin>

  </model>
</sdf>
