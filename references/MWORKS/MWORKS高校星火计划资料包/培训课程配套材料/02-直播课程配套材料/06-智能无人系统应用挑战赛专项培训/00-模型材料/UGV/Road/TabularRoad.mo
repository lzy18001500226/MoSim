    , -6.10135724, 10}, {-26.59297344, -5.81729855, 10}, {-27.12483842, -5.539602085, 10}, {-27.65999738, -5.268307845, 10}, {-28.19837327, -5.00345489, 10}, {-28.73988855, -4.74508136, 10}, {-29.28446525, -4.493224465, 10}, {-29.83202495, -4.24792046, 10}, {-30.3824888, -4.00920468, 10}, {-30.93577755, -3.77711149, 10}, {-31.4918115, -3.55167432, 10}, {-32.05051061, -3.33292563, 10}, {-32.61179441, -3.120896915, 10}, {-33.17558208, -2.91561871, 10}, {-33.74179244, -2.717120575, 10}, {-34.31034395, -2.52543109, 10}, {-34.88115475, -2.340577865, 10}, {-35.45414263, -2.162587515, 10}, {-36.02922509, -1.991485665, 10}} 
    "第一/二列为xy坐标，第三列为速度";
  parameter Real roadWidth = 10 "路宽，仅作为可视化";
  final parameter Real offset = 0;
  constant Integer N1 = size(roadMap, 1);
  constant Integer N2 = size(roadMap, 2);
  constant Real h = -0.365 "道路高度";
  //xy方向单调递增常量数组，用于函数缺省值0315
  constant Real mapZ0[:,:] = {{0, 1, 2, 3}, {0, 0, 0, 0}, {1, 0, 0, 0}, {2, 0, 0, 0}, {3, 0, 0, 0}};
  constant Real mapMu0[:,:] = {{0, 1, 2, 3}, {0, 1, 1, 1}, {1, 1, 1, 1}, {2, 1, 1, 1}, {3, 1, 1, 1}};
  constant Real mapN0[:,:] = {{0, 1, 2, 3}, {0, 1, 1, 1}, {1, 1, 1, 1}, {2, 1, 1, 1}, {3, 1, 1, 1}};
  final parameter Real path_orientation[N1,10] = TADynamics.Utilities.Function.Calc_path_orientation(path_sx_sy);
  final parameter Real path_sx_sy[N1,N2 + 2] = TADynamics.Utilities.Function.Calc_path_sx_sy_theta_mue_v(roadMap, offset);
  // 计算输入路径长度，输出xy和v的akima系数
  final parameter Real kx[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_sx_sy[:,2]);
  final parameter Real ky[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_sx_sy[:,3]);
  final parameter Real kv[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_sx_sy[:,4]);
  final parameter Real table_[3,:] = {path_sx_sy[:,5], path_sx_sy[:,2], path_sx_sy[:,3]};
  final parameter Real table[:,3] = transpose(table_);
  // // 计算输入路径长度，输出该点位置的x切线方向的系数
  // final parameter Real kex1[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_orientation[:,2]);
  // final parameter Real kex2[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_orientation[:,3]);
  // final parameter Real kex3[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_orientation[:,4]);
  // // 计算输入路径长度，输出该点位置的y切线方向的系数
  // final parameter Real key1[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_orientation[:,5]);
  // final parameter Real key2[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_orientation[:,6]);
  // final parameter Real key3[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_orientation[:,7]);
  // //
  // final parameter Real kez1[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_orientation[:,8]);
  // final parameter Real kez2[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_orientation[:,9]);
  // final parameter Real kez3[N1,4] = CoefficientCalc(path_sx_sy[:,5], path_orientation[:,10]);





  //摩擦系数信息roadMuMap
  final parameter Real roadMUEMap[:,:] = {{0, 1, 2}, {1, 0, 0}, {2, 0, 0}} "纵向第一列为x方向，横向第一排为y方向，表格内表示各个（x，y）下的摩擦系数mue";


  final parameter Real road_N_Map1[:,:] = MapNVector(roadMap, N1, N2, 1);
  final parameter Real road_N_Map2[:,:] = MapNVector(roadMap, N1, N2, 2);
  final parameter Real road_N_Map3[:,:] = MapNVector(roadMap, N1, N2, 3);
  final parameter Real roadMap_Cali[:,:] = roadMap_Calibration(roadMap, N1, N2);
  //修正readMap，以用于查表LZZ
  function roadMap_Calibration "路网"
    input Real x[:,:];
    input Integer N1;
    input Integer N2;
    output Real roadMap_Cali[N1,N2];
    annotation(Protection(access=Access.diagram));
  algorithm
    for i in 1:N1 loop
      roadMap_Cali[i,1] := -x[i,1];
    end for;
    for j in 2:N2 loop
      for i in 1:N1 loop
        roadMap_Cali[i,j] := x[i,j];
      end for;
    end for;
  end roadMap_Calibration;
  //求每个点的法向量,n[1],n[2],n[3]分别保存在三个表格中
  function MapNVector "生成法向量"
    input Real x[:,:];
    input Integer N1;
    input Integer N2;
    input Integer D;  //法向量第D个值
    output Real roadMap_NVector[N1,N2];
  protected
    Real A[3];
    Real B[3];
    Real n[3];
    annotation(Protection(access=Access.diagram));
  algorithm
    if D == 1 or D == 2 then
      roadMap_NVector[1,1] := 0;
      roadMap_NVector[N1,N2] := 0;
      //给定Y坐标和最后一排向量为0
      for j in 2:N2 loop
        roadMap_NVector[1,j] := x[1,j];
        roadMap_NVector[N1 - 1,j] := 0;
      end for;
      //给定坐标和最后一列向量为0
      for i in 2:N1 loop
        roadMap_NVector[i,1] := -x[i,1];
        roadMap_NVector[i,N2] := 0;
      end for;
    //D == 3 n[z]
    else
      roadMap_NVector[1,1] := 1;
      roadMap_NVector[N1,N2] := 1;
      //给定Y坐标和最后一排向量为0
      for j in 2:N2 loop
        roadMap_NVector[1,j] := x[1,j];
        roadMap_NVector[N1 - 1,j] := 1;
      end for;
      //给定坐标和最后一列向量为0
      for i in 2:N1 loop
        roadMap_NVector[i,1] := -x[i,1];
        roadMap_NVector[i,N2] := 1;
      end for;
    end if;
    //中间个点法向量    
    for j in 2:N2 - 1 loop
      for i in 2:N1 - 1 loop
        A[1] := x[i,1] - x[i,1];
        A[2] := x[1,j + 1] - x[1,j];
        A[3] := x[i,j + 1] - x[i,j];

        B[1] := x[i + 1,1] - x[i,1];
        B[2] := x[1,j] - x[1,j];
        B[3] := x[i + 1,j] - x[i,j];

        n := cross(A, B);
        roadMap_NVector[i,j] := n[D];
      end for;
    end for;
  end MapNVector;
  //以下部分仅作为可视化
  final parameter Real x[N1,2] = TYBase.Functions.RoadVisual.getX(roadMap, path_orientation, roadWidth);
  final parameter Real y[N1,2] = TYBase.Functions.RoadVisual.getY(roadMap, path_orientation, roadWidth);
  final parameter Real z[N1,2] = TYBase.Functions.RoadVisual.getZ(roadMap, path_orientation, roadWidth, h);
  // Real xyz[3, N1,2] = {x, y, z};

  function getZ "获得道路高度"
    input Modelica.Units.SI.Position x;
    input Modelica.Units.SI.Position y;
    input Real roadMap[:,:] = mapZ0;  //0315
    output Modelica.Units.SI.Position z;
  algorithm
    z := h;
    annotation(Protection(access=Access.diagram));
  end getZ;

  function getMue "获得道路摩擦系数"
    input Modelica.Units.SI.Position x;
    input Modelica.Units.SI.Position y;
    input Real roadMueMap[:,:] = mapMu0;  //0315
    output Real mu;
  algorithm
    mu := 1;
    annotation(Protection(access=Access.diagram));
  end getMue;

  function getNVector "获得道路法向量"
    input Modelica.Units.SI.Position x;
    input Modelica.Units.SI.Position y;
    input Real road_N_Map1[:,:] = mapZ0;  //0315
    input Real road_N_Map2[:,:] = mapZ0;  //0315
    input Real road_N_Map3[:,:] = mapN0;  //0315
    output Real n[3];
  algorithm
    n := {0, 0, 1};
    annotation(Protection(access=Access.diagram));
  end getNVector;

  function getrP "输入道路长度，返回全局坐标系坐标"
    input Modelica.Units.SI.Position s"沿程距离";
    input Real path_sx_sy[:,5];
    input Real kx[:,4];
    input Real ky[:,4];
    output Modelica.Units.SI.Position rp[3];
  protected
    Real tmp[2];
  algorithm
    // tmp := TADynamics.Utilities.Function.path2sxsy3(s, path_sx_sy[:,5], kx, ky);
    // rp := tmp;
    tmp := TADynamics.Utilities.Function.path2sxsy2(s, path_sx_sy);
    rp := {tmp[1], tmp[2], 0};
    annotation(Protection(access=Access.diagram));
  end getrP;

  function getex "计算该点路径的x朝向"
    input Real x[:];
    input Real kx[:,4];
    input Real ky[:,4];
    input Real x_value;
    output Real ex[3];
  protected
    Real x_tmp;
    Real y_tmp;
    Real ex_[3];
  algorithm
    x_tmp := TYBase.Functions.Interpolation.Akima1D.y_der(x, kx, x_value);  // kx[pos,2] + 2 * kx[pos,3] * value + 3 * kx[pos,4] * value ^ 2;
    y_tmp := TYBase.Functions.Interpolation.Akima1D.y_der(x, ky, x_value);  //ky[pos,2] + 2 * ky[pos,3] * value + 3 * ky[pos,4] * value ^ 2;
    ex_ := {x_tmp, y_tmp, 0};
    ex := ex_ / (sqrt(ex_ * ex_));
    annotation(Protection(access=Access.diagram));
  end getex;

  function getey "计算该点路径的y朝向"
    input Real x[:];
    input Real kx[:,4];
    input Real ky[:,4];
    input Real x_value;
    output Real ey[3];
  protected
    Real x_tmp;
    Real y_tmp;
    Real ey_[3];
  algorithm
    x_tmp := TYBase.Functions.Interpolation.Akima1D.y_der(x, kx, x_value);  // kx[pos,2] + 2 * kx[pos,3] * value + 3 * kx[pos,4] * value ^ 2;
    y_tmp := TYBase.Functions.Interpolation.Akima1D.y_der(x, ky, x_value);  //ky[pos,2] + 2 * ky[pos,3] * value + 3 * ky[pos,4] * value ^ 2;
    ey_ := {-y_tmp, x_tmp, 0};
    ey := ey_ / (sqrt(ey_ * ey_));
    annotation(Protection(access=Access.diagram));
  end getey;

  function getez "计算该点路径的z朝向"
    input Real s;
    input Real sx_orientation[:,10];
    output Real ez[3];
  protected
    Real x[size(sx_orientation, 1)];
    Real y[size(sx_orientation, 1),3];
    Real ez_[3];
  algorithm
    ez := {0, 0, 1};  //TADynamics.Utilities.Function.Calc_ez(s = s, sx_orientation = sx_orientation);
    annotation(Protection(access=Access.diagram));
  end getez;

  function path2v "输入路径长度找参考速度"
    input Real s;
    input Real pathsxsy[:,5];
    output Real y;
  algorithm
    if s <= pathsxsy[1,5] then
      y := (pathsxsy[2,4] - pathsxsy[1,4]) / (pathsxsy[2,5] - pathsxsy[1,5]) * (s - pathsxsy[1,5]) + pathsxsy[1,4];
    elseif s >= pathsxsy[end,5] then
      y := (pathsxsy[end,4] - pathsxsy[end - 1,4]) / (pathsxsy[end,5] - pathsxsy[end - 1,5]) * (s - pathsxsy[end - 1,5]) + pathsxsy[end - 1,4];
    else
      for i in 2:size(pathsxsy, 1) loop
        if s > pathsxsy[i - 1,5] and s <= pathsxsy[i,5] then
          y := (pathsxsy[i,4] - pathsxsy[i - 1,4]) / (pathsxsy[i,5] - pathsxsy[i - 1,5]) * (s - pathsxsy[i - 1,5]) + pathsxsy[i - 1,4];
        end if;
      end for;
    end if;
    annotation(Protection(access=Access.diagram));
  end path2v;

  Modelica.Mechanics.MultiBody.Visualizers.Advanced.Surface surface(
  redeclare function surfaceCharacteristic = TYBase.Functions.RoadVisual.VisualFunc(
    X = x, Y = y, Z = z), 
    nu = N1, 
    color = {188, 188, 188}) 
    annotation(Placement(transformation(origin = {-28.0, 12.000000000000007}, 
    extent = {{-10.0, -10.0}, {10.0, 10.0}})));

  annotation(defaultComponentPrefixes = "inner", defaultComponentName = "road", 
    Icon(coordinateSystem(extent = {{-100, -100}, {100, 100}}, 
    grid = {2, 2}), graphics = {Text(origin = {0, -134.019}, 
    rotation = 180, 
    extent = {{-100, 30}, {100, -30}}, 
    textString = "%Name", 
    fontName = "微软雅黑", 
    textStyle = {TextStyle.None})}), 
    Protection(access=Access.diagram), 
    Documentation(link="modelica://TADynamics/Resource/Doc/TabularRoad.html"));
end TabularRoad;