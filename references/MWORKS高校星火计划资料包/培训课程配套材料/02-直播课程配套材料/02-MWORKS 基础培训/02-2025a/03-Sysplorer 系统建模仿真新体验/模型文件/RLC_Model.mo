    annotation (Placement(transformation(origin={60,30}, 
extent={{-10,-10},{10,10}}, 
rotation=270)));
  Modelica.Blocks.Sources.Constant const(k=24) 
    annotation (Placement(transformation(origin={-80,30}, 
