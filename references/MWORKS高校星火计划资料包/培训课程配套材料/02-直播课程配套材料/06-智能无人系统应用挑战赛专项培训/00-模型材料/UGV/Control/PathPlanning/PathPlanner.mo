model PathPlanner 
  "无人车路径规划模型，采用Pure Pursuit算法"
  annotation(__MWORKS(version = "2025a",ContinueSimConfig(SaveContinueFile="false",SaveBeforeStop="false",NumberBeforeStop=1,FixedContinueInterval="false",ContinueIntervalLength=5,ContinueTimeVector)), Icon(coordinateSystem(extent={{-100,-100},{100,100}}, 
grid={2,2}),graphics = {Bitmap(origin={1,10}, 
extent={{-87,-72},{87,72}}, 
fileName="modelica://UGV/Resources/Images/%E8%B7%AF%E5%BE%84%E8%A7%84%E5%88%92.png", 
