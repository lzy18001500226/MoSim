, 10}, {-2.7124, 115.1952, 10}, {-4.8621, 111.0551, 10}, {-6.8041, 106.8139, 10}, {-8.5075, 102.4711, 10}, {-9.9409, 98.032, 10}, {-11.0961, 93.513, 10}, {-11.8871, 88.9172, 10}, {-12.1395, 84.2621, 10}, {-11.7983, 79.6122, 10}, {-11.1, 75.0077, 10}, {-10.4, 70.4223, 10}, {-9.7, 65.8345, 10}, {-9, 61.0299, 10}, {-8, 54.2488, 10}, {-7, 47.4677, 10}, {-6, 40.6866, 10}, {-5, 33.9055, 10}, {-4, 27.1244, 10}, {-3, 20.3433, 10}, {-2, 13.5622, 10}, {-1, 6.7811, 10}, {0, 0, 10}} "路径点数据";
//protected
  Integer closest_index "最近路径点索引";
  Real[2] pursuit_point "跟踪点坐标";
  SIunits.Length lookahead_dist "动态前瞻距离";
  Real path_progress(start = 0)  "路径进度参数化";
//public
  Modelica.Blocks.Interfaces.RealInput x "当前x位置" 
    annotation(Placement(transformation(origin = {-110, 66.6667}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealOutput target_v "目标速度" 
    annotation(Placement(transformation(origin = {110, 50}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealOutput steering_angle "转向角" 
    annotation(Placement(transformation(origin = {110, -50}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealInput y "当前y位置" 
    annotation(Placement(transformation(origin = {-110, 0}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  Modelica.Blocks.Interfaces.RealInput v "当前速度" 
    annotation(Placement(transformation(origin = {-110, -66.6667}, 
    extent = {{-10, -10}, {10, 10}}), 
    iconTransformation(origin = {0, 0})));
  annotation(Diagram(coordinateSystem(extent = {{-100, -100}, {100, 100}}, 
    grid = {2, 2})));

algorithm
  // 步骤1：计算动态前瞻距离（随速度调整）
  lookahead_dist := lookahead_base + lookahead_gain * v;

  // 步骤2：寻找最近路径点
  (closest_index,path_progress) := UGV.Control.PathPlanning.Internal.findClosestSegment(x, y, path);

  // 步骤3：计算跟踪点（沿路径前移lookahead距离）
  pursuit_point := UGV.Control.PathPlanning.Internal.calculatePursuitPoint(path, closest_index, path_progress, lookahead_dist);

  // 步骤4：计算目标速度（最近路径点的期望速度）
  target_v := UGV.Control.PathPlanning.Internal.interpolateSpeed(path, closest_index, path_progress);

  // 步骤5：Pure Pursuit转向计算
  steering_angle := UGV.Control.PathPlanning.Internal.purePursuitControl(x, y, pursuit_point[1], pursuit_point[2]);

end PathPlanner;