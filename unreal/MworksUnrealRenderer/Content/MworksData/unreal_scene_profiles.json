{
    "schema": "quadrotor.unreal_scene_profiles.v1",
    "truth_policy": "MWORKS/Sysplorer remains the source of control, planning, collision, disturbance and metrics truth. Unreal renders project-owned scene profiles and may not feed hidden global geometry back to the planner.",
    "coordinate_frame": {
        "source": "MWORKS world, meters, z-up",
        "unreal_conversion": "X=mworks_x*100, Y=-mworks_y*100, Z=mworks_z*100"
    },
    "runtime_targets": {
        "state_stream_hz_min": 20,
        "state_stream_hz_target": 50,
        "render_fps_target": 60,
        "sensor_map_hz_min": 20,
        "planner_hz_range": [
            5,
            20
        ]
    },
    "profiles": [
        {
            "profile_id": "dense_forest",
            "map_ids": [
                "dense_forest"
            ],
            "render_map_json": "",
            "priority": "P0",
            "purpose": "local perception, unknown-map obstacle avoidance and replanning under vegetation-like occlusion",
            "render_world": {
                "source_strategy": "project_owned_recreation_from_authorized_assets",
                "candidate_references": [
                    "RflySim runtime visual survey",
                    "Sunray/Gazebo forest/tree assets",
                    "UE marketplace/free forest assets after license review"
                ],
                "required_visual_classes": [
                    "terrain",
                    "tree_trunks",
                    "canopy",
                    "rocks",
                    "waypoint_markers",
                    "radar_sector",
                    "local_plan",
                    "trajectory_trail"
                ]
            },
            "truth_geometry": {
                "required_proxy_classes": [
                    "tree_trunk_capsule_or_box",
                    "rock_box",
                    "terrain_heightfield"
                ],
                "planner_visibility": "local_sensor_only",
                "global_map_available_to_planner": false
            },
            "acceptance": [
                "visible trunks/rocks have collision_proxy_id equivalents",
                "radar sector shows only currently sensed region",
                "local plan is not a fixed straight line through obstacles"
            ]
        },
        {
            "profile_id": "maze_building",
            "map_ids": [
                "map_maze_building",
                "maze_building"
            ],
            "render_map_json": "MworksData/map_maze_building_render_map.json",
            "priority": "P0",
            "purpose": "wall occlusion, corridor navigation, local map memory and no-through-wall radar behavior",
            "render_world": {
                "source_strategy": "project_owned_modular_walls",
                "candidate_references": [
                    "RflySim OldFactory/ChallengeMap runtime survey",
                    "self-built modular wall kit"
                ],
                "required_visual_classes": [
                    "walls",
                    "doors_or_passages",
                    "floor",
                    "occlusion_shading",
                    "radar_sector",
                    "local_known_map"
                ]
            },
            "truth_geometry": {
                "required_proxy_classes": [
                    "wall_box",
                    "passage_box",
                    "floor_plane"
                ],
                "planner_visibility": "raycast_occluded_local_sensor",
                "global_map_available_to_planner": false
            },
            "acceptance": [
                "radar does not reveal geometry behind walls",
                "trajectory keeps minimum obstacle distance",
                "planner can recover from blocked local plan without yaw spinning"
            ]
        },
        {
