    "active_execution_scope": {
        "allowed_to_implement_now": [
            "S0",
            "S1"
        ],
        "requires_user_review_before_implementation": [
            "S2",
            "S3",
            "S4",
            "S5",
            "S6",
            "S7"
        ],
        "rule": "Define every stage now, but only implement S0/S1 until the first scene profile, blockout, and playback gates pass."
    },
    "stage_roadmap": [
        {
            "stage_id": "S0",
            "profile_id": "renderer_framework",
            "name": "UE5 scene framework and MWORKS playback base",
            "objective": "scene profile schema, object registry, collision proxy binding, MWORKS UDP/replay, UAV actor, camera, trail, radar/local-map display",
            "implementation_status": "active",
            "manual_gate": "profile and blockout review"
        },
        {
            "stage_id": "S1",
            "profile_id": "competition_industrial_hybrid",
            "name": "industrial challenge hybrid single-UAV navigation scene",
            "objective": "single-UAV local perception, unknown-map replanning, obstacle avoidance, trajectory tracking, and video-ready industrial visual context",
            "implementation_status": "active_after_S0_profile",
            "manual_gate": "blockout, perception overlay, and playback review"
        },
        {
            "stage_id": "S2",
            "profile_id": "gate_ring_attitude",
            "name": "tilted gate/ring aggressive attitude scene",
            "objective": "large-attitude tracking, smooth trajectory generation, controller performance display, gate/ring traversal",
