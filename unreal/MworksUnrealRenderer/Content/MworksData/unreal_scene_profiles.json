{
    "schema": "quadrotor.unreal_scene_profiles.v1",
    "truth_policy": "MWORKS/Sysplorer remains the source of control, planning, collision, disturbance and metrics truth. Unreal renders project-owned scene profiles and may not feed hidden global geometry back to the planner.",
    "coordinate_frame": {
        "source": "MWORKS world, meters, z-up",
        "unreal_conversion": "X=mworks_x*100, Y=-mworks_y*100, Z=mworks_z*100"
    },
    "runtime_targets": {
        "state_stream_hz_min": 20,
        "state_stream_hz_target": 50,
        "render_fps_target": 60,
        "sensor_map_hz_min": 20,
        "planner_hz_range": [
            5,
            20
        ]
    },
    "profiles": [
        {
            "stage_id": "S0",
            "profile_id": "renderer_framework",
            "map_ids": [
                "renderer_framework",
                "ue5_framework_smoke"
            ],
            "render_map_json": "",
            "priority": "P0",
            "purpose": "foundation for all later scenes: project-owned UE5 scene profile, object registry, collision proxy registry, MWORKS playback, UAV visual, camera, trail, radar sector and local plan overlays",
            "render_world": {
                "source_strategy": "project_owned_minimal_framework",
                "candidate_references": [
                    "current MworksUnrealRenderer bridge",
                    "AirSim/Cosys camera and vehicle API reference",
                    "RflySim runtime camera/radar behavior reference"
                ],
                "required_visual_classes": [
                    "UAV",
                    "propellers",
                    "body_axes",
                    "overview_camera",
                    "follow_camera",
                    "radar_sector",
                    "local_plan",
                    "trajectory_trail",
                    "metric_overlay",
                    "scene_status_overlay"
                ]
            },
            "truth_geometry": {
                "required_proxy_classes": [
                    "scene_bounds_box",
                    "optional_ground_plane",
                    "debug_collision_proxy"
                ],
                "planner_visibility": "framework_only_no_planner_truth_leakage",
                "global_map_available_to_planner": false
            },
            "acceptance": [
                "UAV pose, attitude and propeller visuals are driven by MWORKS/replay state",
                "scene profile and object registry can be loaded without hard-coded map assumptions",
                "camera presets, radar sector, local plan and trajectory trail are visible and reviewable"
            ]
        },
        {
            "stage_id": "S1",
            "profile_id": "competition_industrial_hybrid",
            "map_ids": [
                "competition_industrial_hybrid",
                "match_industrial_challenge"
            ],
            "render_map_json": "",
            "priority": "P0",
            "purpose": "first complete single-UAV navigation scene combining challenge objects, industrial inspection context, local perception, realtime replanning and trajectory tracking",
            "render_world": {
                "source_strategy": "project_owned_recreation_guided_by_rflysim_and_sunray_truth",
                "candidate_references": [
                    "RflySim MatchScene2025 runtime/reference",
                    "RflySim RobotMissionChallenge runtime/reference",
                    "RflySim OldFactory runtime/reference",
                    "Sunray/YunZong Gazebo worlds and SDF objects"
                ],
                "required_visual_classes": [
                    "terrain_or_floor",
                    "takeoff_pad",
                    "landing_pad",
                    "pillars",
                    "boxes",
                    "short_walls",
                    "gate_or_frame",
                    "industrial_props",
                    "inspection_targets",
                    "radar_sector",
                    "local_known_map",
                    "local_plan",
                    "trajectory_trail"
                ]
            },
            "truth_geometry": {
                "required_proxy_classes": [
                    "terrain_heightfield_or_plane",
                    "pad_box",
                    "pillar_box_or_cylinder",
                    "box_obstacle",
                    "wall_box",
                    "gate_frame_boxes",
                    "inspection_target_box"
                ],
                "planner_visibility": "raycast_occluded_local_sensor_with_map_memory",
                "global_map_available_to_planner": false
            },
            "acceptance": [
                "start and goal are explicit and coordinate-frame reviewed",
                "every planning-relevant visible object has a collision_proxy_id equivalent",
                "radar/local map does not reveal occluded or unknown global geometry",
                "local plan begins at the UAV center and avoids proxies rather than drawing a fixed straight line",
                "MWORKS playback shows actual trail, reference/local plan, UAV attitude, and scene overlays"
            ]
        },
