            "manual_gate": "trajectory/control requirement review before implementation"
        },
        {
            "stage_id": "S3",
            "profile_id": "park_city_patrol",
            "name": "park/city patrol scene",
            "objective": "patrol/logistics style mission, path planning, local avoidance, visual demonstration in a readable outdoor environment",
