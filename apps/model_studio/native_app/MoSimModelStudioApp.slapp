{
    "name": "MoSimModelStudioReviewApp",
    "callbackFunctions": [
        {
            "name": "OfflineModePressed",
            "code": "            app.set_mode(\"offline\")"
        },
        {
            "name": "LiveModePressed",
            "code": "            app.set_mode(\"live\")"
        },
        {
            "name": "DeployModePressed",
            "code": "            app.set_mode(\"deploy\")"
        },
        {
            "name": "AssistantModePressed",
            "code": "            app.set_mode(\"assistant\")"
        },
        {
            "name": "SelectionChanged",
            "code": "            app.refresh_summary()\n            app.StatusLabel.Text = \"配置已修改，尚未校验或发布。\""
        },
        {
            "name": "InjectionChanged",
            "code": "            app.InjectionChanged(nothing)"
        },
        {
            "name": "ApplyInjectionPressed",
            "code": "            app.StatusLabel.Text = \"界面审核模式：已触发“应用故障”界面状态，未连接 MWORKS、QGC 或 Orchestrator。\""
        },
        {
            "name": "RestoreInjectionPressed",
            "code": "            app.RestoreInjectionPressed(nothing)"
        },
        {
            "name": "ValidatePressed",
            "code": "            app.StatusLabel.Text = \"界面审核模式：已触发“校验配置”界面状态，未连接 MWORKS、QGC 或 Orchestrator。\""
        },
        {
            "name": "PublishPressed",
            "code": "            app.StatusLabel.Text = \"界面审核模式：已触发“发布 Profile”界面状态，未连接 MWORKS、QGC 或 Orchestrator。\""
        },
        {
            "name": "PreparePressed",
            "code": "            app.StatusLabel.Text = \"界面审核模式：已触发“准备运行”界面状态，未连接 MWORKS、QGC 或 Orchestrator。\""
        },
        {
            "name": "QgcPressed",
            "code": "            app.StatusLabel.Text = \"界面审核模式：已触发“进入 QGC”界面状态，未连接 MWORKS、QGC 或 Orchestrator。\""
        },
        {
            "name": "SafeStopPressed",
            "code": "            app.StatusLabel.Text = \"界面审核模式：已触发“请求安全停止”界面状态，未连接 MWORKS、QGC 或 Orchestrator。\""
        },
        {
            "name": "OpenModelPressed",
            "code": "            app.StatusLabel.Text = \"界面审核模式：已触发“打开模型”界面状态，未连接 MWORKS、QGC 或 Orchestrator。\""
        },
        {
            "name": "MilPressed",
            "code": "            app.StatusLabel.Text = \"界面审核模式：已触发“运行 MWORKS MIL”界面状态，未连接 MWORKS、QGC 或 Orchestrator。\""
        },
        {
            "name": "CodegenPressed",
            "code": "            app.StatusLabel.Text = \"界面审核模式：已触发“生成 C 代码”界面状态，未连接 MWORKS、QGC 或 Orchestrator。\""
        },
        {
            "name": "ResultPressed",
            "code": "            app.StatusLabel.Text = \"界面审核模式：已触发“打开结果”界面状态，未连接 MWORKS、QGC 或 Orchestrator。\""
        }
    ],
