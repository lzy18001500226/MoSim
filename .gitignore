
# Python
__pycache__/
*.pyc
.venv/
.env

# Julia
.julia/
*.ji

# Node / MCP
node_modules/
npm-debug.log*
.mcp-servers/

# Unreal local build outputs
unreal/**/Binaries/
unreal/**/Intermediate/
unreal/**/Saved/
unreal/**/DerivedDataCache/
*.sln
*.suo
*.opensdf
*.VC.db

# Codex local state
.codex/
.mcp.json
.tmp/

# Logs and temp
*.log
*.tmp
*.cache
*.bak
*.old
docs/mworks/extracted/
docs/mworks/tmp/
docs/mworks/raw/

# MWORKS / simulation temp
results/tmp/
results/cache/
results/native_result_cache/
results/logs/*.log
results/replay_html/
results/**/native_result/
*_backup/

# Large binary outputs
*.msr
*.mat
*.h5
*.hdf5
*.dae
*.plan

# OS
.DS_Store
Thumbs.db

# Secrets
*.key
*.pem
*.token
secrets.*
.env.*

# RflySim installer/runtime packages are local dependencies, not repo assets
references/RflySim/RflySimAdv3Full/
references/RflySim/RflySimAdvFree/

# AirSim-family external references: keep source/docs/configs, exclude local
# clones, build outputs, generated caches, and large compiled artifacts.
references/AirSim/**/.git/
references/AirSim/**/.svn/
references/AirSim/**/.hg/
references/AirSim/**/Binaries/
references/AirSim/**/Intermediate/
references/AirSim/**/Saved/
references/AirSim/**/DerivedDataCache/
references/AirSim/**/.vs/
references/AirSim/**/*.pdb
references/AirSim/**/*.pch
references/AirSim/**/*.obj
references/AirSim/**/*.iobj
references/AirSim/**/*.ipdb
references/AirSim/**/*.lib

