{
  "tasks": [
    {
      "automation_id": "agent_architecture_learning_daily",
      "role": "OpenSourceLearningAgent",
      "department": "OpenSourceLearningAgent",
      "cadence": "daily",
      "objective": "Run a bounded CoAgent architecture-learning slice across local agent references, agent skills, Anthropic/Claude engineering material, or SDK runtime resources; classify lessons as adopt_now, adapt_later, portable_only, reject, or unknown.",
      "read_scope": [
        "CoAgent/docs/research/LEARNING_STRATEGY.md",
        "CoAgent/docs/research/REFERENCE_PROJECT_INDEX.md",
        "Docs/Index/external_learning_index.md",
        "References/Agent"
      ],
      "write_scope": [
        "CoAgent",
        "Docs/Index/external_learning_index.md",
        "Docs/Workflows/agent_orchestration.md",
        "PROGRESS.md"
      ],
      "tool_scope": {
        "allowed": [
          "coagent_runtime",
          "coagent_dispatch",
          "coagent_knowledge",
          "coagent_learning",
          "file_read",
          "file_write_project"
        ],
        "denied": [
          "network",
          "external_write",
          "codex_app_private_db_write",
          "credential_read",
          "secret_store",
          "destructive_fs",
          "git_force"
        ]
      },
      "requires_human_review": true,
      "acceptance": "A bounded source-slice audit records adopt/adapt/portable/reject/unknown decisions and either patches CoAgent/workflow docs or records no_patch with evidence.",
      "stop_condition": "done, blocked, or no_patch with evidence"
    },
