{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python C:\\Users\\HP\\Desktop\\MoSim\\Scripts\\hooks\\codex_native_hook.py",
            "timeout": 10,
            "statusMessage": "Loading MoSim project guardrails"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*|create_goal",
        "hooks": [
          {
            "type": "command",
            "command": "python C:\\Users\\HP\\Desktop\\MoSim\\Scripts\\hooks\\codex_native_hook.py",
            "timeout": 10,
            "statusMessage": "Checking MoSim project policy"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
